# Copia este archivo a .env y rellena los valores.
# Los cuatro se sacan del panel de Supabase: Project Settings → API.
# Detalle de qué usa cada uno: ARQUITECTURA.md § "Supabase — dos clientes distintos"
# y § "Variables de entorno".
#
# En producción NO se usa este archivo: las mismas cuatro variables se
# configuran en el panel de Vercel (Project Settings → Environment Variables).

# --- Cliente admin (solo servidor, en los endpoints de src/pages/api/) ---
# SUPABASE_SERVICE_ROLE_KEY es SECRETA: se salta RLS, acceso total.
# Nunca debe llegar al navegador ni subirse al repo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cliente browser (portal de clientes, corre en el navegador) ---
# La anon key es segura de exponer: el acceso real lo controla RLS.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
