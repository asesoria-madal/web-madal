---
import Layout from '../layouts/Layout.astro';
import CambiarGestoria from '../components/pages/CambiarGestoria.astro';
import { CAMBIO } from '../i18n/cambio';

export const prerender = true;
const c = CAMBIO.es;
---

<Layout lang="es" path="/cambiar-de-gestoria" active="servicios" title={c.metaTitle} description={c.metaDesc} breadcrumbs={[{ name: c.eyebrow, path: '/cambiar-de-gestoria' }]}>
  <CambiarGestoria lang="es" />
</Layout>
