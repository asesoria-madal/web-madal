---
import Layout from '../../layouts/Layout.astro';
import FormularioAltaTrabajador from '../../components/pages/FormularioAltaTrabajador.astro';
import { TRABAJADOR } from '../../i18n/formularioTrabajador';

export const prerender = true;
const t = TRABAJADOR.ca;
---

<Layout lang="ca" path="/ca/formulario-alta-trabajador" active="none" title={t.metaTitle} description={t.metaDesc} noindex showCtaFinal={false} minimalHeader localesAvailable={['es', 'ca', 'en']}>
  <FormularioAltaTrabajador lang="ca" />
</Layout>
