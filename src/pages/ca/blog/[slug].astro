---
import Layout from '../../../layouts/Layout.astro';
import Articulo from '../../../components/pages/Articulo.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection('blog', (e) => e.data.lang === 'ca' && !e.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'blog'>; }
const { entry } = Astro.props;
---

<Layout
  lang="ca"
  path={`/ca/blog/${entry.data.slug}`}
  active="blog"
  title={`${entry.data.title} · Asesoría Madal`}
  description={entry.data.description}
>
  <Articulo lang="ca" entry={entry} />
</Layout>
