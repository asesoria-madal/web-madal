---
import Layout from '../../layouts/Layout.astro';
import Herramientas from '../../components/pages/Herramientas.astro';
import { HERRAMIENTAS } from '../../i18n/herramientas';

export const prerender = true;
const h = HERRAMIENTAS.ca;
---

<Layout lang="ca" path="/ca/herramientas" active="herramientas" title={h.indice.metaTitle} description={h.indice.metaDesc} breadcrumbs={[{ name: h.indice.eyebrow, path: '/herramientas' }]}>
  <Herramientas lang="ca" />
</Layout>
