---
import Layout from '../../layouts/Layout.astro';
import Contacto from '../../components/pages/Contacto.astro';
import { LEADS } from '../../i18n/leads';

export const prerender = true;
const m = LEADS.ca.meta;
---

<Layout lang="ca" path="/ca/contacto" active="none" title={m.contactoTitle} description={m.contactoDesc} showCtaFinal={false} breadcrumbs={[{ name: LEADS.ca.contacto.eyebrow, path: '/contacto' }]}>
  <Contacto lang="ca" />
</Layout>
