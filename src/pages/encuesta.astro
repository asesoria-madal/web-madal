---
import Layout from '../layouts/Layout.astro';
import EncuestaSatisfaccion from '../components/pages/EncuestaSatisfaccion.astro';
import { ENCUESTA } from '../i18n/encuesta';

export const prerender = true;
const t = ENCUESTA.es;
---

<Layout lang="es" path="/encuesta" active="none" title={t.metaTitle} description={t.metaDesc} noindex showCtaFinal={false} minimalHeader localesAvailable={['es', 'ca', 'en']}>
  <EncuestaSatisfaccion lang="es" />
</Layout>
