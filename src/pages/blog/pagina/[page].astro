---
import Layout from '../../../layouts/Layout.astro';
import Blog from '../../../components/pages/Blog.astro';
import { getSortedBlogPosts, toPostPreview, totalBlogPages, BLOG_PAGE_SIZE } from '../../../lib/blog';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getSortedBlogPosts('es');
  const total = totalBlogPages(entries.length);
  return Array.from({ length: Math.max(0, total - 1) }, (_, i) => ({ params: { page: String(i + 2) } }));
}

const currentPage = Number(Astro.params.page);
const entries = await getSortedBlogPosts('es');
const total = totalBlogPages(entries.length);
const posts = entries
  .slice((currentPage - 1) * BLOG_PAGE_SIZE, currentPage * BLOG_PAGE_SIZE)
  .map((e) => toPostPreview(e, 'es'));
---

<Layout
  lang="es"
  path={`/blog/pagina/${currentPage}`}
  active="blog"
  title={`Blog, página ${currentPage} · Asesoría Madal`}
  description="Más artículos sobre fiscalidad para autónomos, SL y pymes."
>
  <Blog lang="es" posts={posts} showFaq={false} pagination={{ current: currentPage, total, baseUrl: '/blog' }} />
</Layout>
