---
import Layout from '../layouts/Layout.astro';
import Pricing from '../components/pages/Pricing.astro';

export const prerender = true;
---

<Layout
  lang="es"
  path="/pricing"
  active="none"
  title="Asesoría de precios para autónomos y pymes · Madal Pricing"
  description="Estrategia de precios para tu negocio a partir de los datos que ya tiene tu balance: costes reales, packs, descuentos y experimentación. Primera llamada gratis."
  showCtaFinal={false}
  breadcrumbs={[{ name: 'Madal Pricing', path: '/pricing' }]}
  hideHeader={true}
  localesAvailable={['es']}
>
  <Pricing />
</Layout>
