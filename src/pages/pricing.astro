---
import Layout from '../layouts/Layout.astro';
import PricingInicio from '../components/pricing/PricingInicio.astro';

export const prerender = true;
---

<Layout
  lang="es"
  path="/pricing"
  active="none"
  title="Asesoría de precios para autónomos y pymes · Madal Pricing"
  description="Si pasas más tiempo decidiendo cuánto cobrar que haciendo tu trabajo, te ayudamos a ponerle precio con los datos que ya tiene tu balance. Primera llamada gratis."
  showCtaFinal={false}
  hideHeader={true}
  localesAvailable={['es']}
  breadcrumbs={[{ name: 'Madal Pricing', path: '/pricing' }]}
>
  <PricingInicio />
</Layout>
