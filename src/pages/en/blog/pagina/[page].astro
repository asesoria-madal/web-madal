---
import Layout from '../../../../layouts/Layout.astro';
import Blog from '../../../../components/pages/Blog.astro';
import { getSortedBlogPosts, toPostPreview, totalBlogPages, BLOG_PAGE_SIZE } from '../../../../lib/blog';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getSortedBlogPosts('en');
  const total = totalBlogPages(entries.length);
  return Array.from({ length: Math.max(0, total - 1) }, (_, i) => ({ params: { page: String(i + 2) } }));
}

const currentPage = Number(Astro.params.page);
const entries = await getSortedBlogPosts('en');
const total = totalBlogPages(entries.length);
const posts = entries
  .slice((currentPage - 1) * BLOG_PAGE_SIZE, currentPage * BLOG_PAGE_SIZE)
  .map((e) => toPostPreview(e, 'en'));
---

<Layout
  lang="en"
  path={`/en/blog/pagina/${currentPage}`}
  active="blog"
  title={`Blog, page ${currentPage} · Asesoría Madal`}
  description="More articles about taxes for freelancers and small companies in Spain."
>
  <Blog lang="en" posts={posts} showFaq={false} pagination={{ current: currentPage, total, baseUrl: '/blog' }} />
</Layout>
