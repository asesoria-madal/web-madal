---
import Layout from '../../../layouts/Layout.astro';
import Articulo from '../../../components/pages/Articulo.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { pageTitle } from '../../../i18n/utils';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection('blog', (e) => e.data.lang === 'en' && !e.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'blog'>; }
const { entry } = Astro.props;
---

<Layout
  lang="en"
  path={`/en/blog/${entry.data.slug}`}
  active="blog"
  title={pageTitle(entry.data.title)}
  description={entry.data.description}
  ogType="article"
>
  <Articulo lang="en" entry={entry} />
</Layout>
