---
import Layout from '../../layouts/Layout.astro';
import Blog from '../../components/pages/Blog.astro';
import { getSortedBlogPosts, toPostPreview, totalBlogPages, BLOG_PAGE_SIZE } from '../../lib/blog';

export const prerender = true;

const entries = await getSortedBlogPosts('en');
const allPosts = entries.map((e) => toPostPreview(e, 'en'));
const posts = allPosts.slice(0, BLOG_PAGE_SIZE);
const total = totalBlogPages(entries.length);
---

<Layout lang="en" path="/en/blog" active="blog" title="Blog · Asesoría Madal" description="Articles and frequently asked questions about taxes for freelancers and small companies in Spain.">
  <Blog lang="en" posts={posts} allPosts={allPosts} pagination={{ current: 1, total, baseUrl: '/blog' }} />
</Layout>
