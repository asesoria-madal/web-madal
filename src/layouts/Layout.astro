---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactSwitch from '../components/ContactSwitch.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '../styles/global.css';
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Locale;
  path: string;
  active: 'home' | 'simulador' | 'alta' | 'blog' | 'equipo' | 'servicios' | 'none';
  title: string;
  description?: string;
  showCtaFinal?: boolean;
  noindex?: boolean;
}

const { lang, path, active, title, description, showCtaFinal = true, noindex = false } = Astro.props;
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" />
    <script is:inline>
      // Aplicamos el tema guardado antes de pintar, para evitar el parpadeo
      // de cambiar de claro a oscuro (o viceversa) justo después de cargar.
      (function () {
        var stored = localStorage.getItem('theme');
        if (stored === 'dark' || stored === 'light') {
          document.documentElement.setAttribute('data-theme', stored);
        }
      })();
    </script>
  </head>
  <body>
    <Header lang={lang} path={path} active={active} />
    <slot />
    {showCtaFinal && (
      <section class="cta-final" id="cta-final">
        <h2>{t.ctaFinal.title}</h2>
        <div class="actions">
          <ContactSwitch lang={lang} />
        </div>
        <p class="fine">{t.ctaFinal.fine}</p>
      </section>
    )}
    <Footer lang={lang} />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
