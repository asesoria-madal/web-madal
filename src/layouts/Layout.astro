---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactSwitch from '../components/ContactSwitch.astro';
import CookieConsent from '../components/CookieConsent.astro';
import TrustBanner from '../components/TrustBanner.astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { locales, defaultLocale, type Locale } from '../i18n/ui';
import { useTranslations, localizedPath } from '../i18n/utils';

interface Props {
  lang: Locale;
  path: string;
  active: 'home' | 'simulador' | 'alta' | 'blog' | 'equipo' | 'servicios' | 'none';
  title: string;
  description?: string;
  showCtaFinal?: boolean;
  noindex?: boolean;
  minimalHeader?: boolean;
  hideHeader?: boolean;
  /** Locales que realmente existen para esta ruta (por defecto, todos). Las
   * páginas legales (aviso legal, privacidad, cookies) solo existen en
   * castellano: sin esto, generábamos hreflang y un selector de idioma que
   * apuntaban a /ca y /en devolviendo 404. */
  localesAvailable?: Locale[];
  /** "article" en los artículos del blog (así los enlaces compartidos en
   * redes se ven como un artículo, no como un enlace genérico del sitio);
   * "website" en el resto de páginas. */
  ogType?: 'website' | 'article';
  /** Solo con ogType="article": fechas ISO de publicación/actualización,
   * las mismas que ya usa el JSON-LD del artículo (Articulo.astro). */
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  /** Migas de pan (BreadcrumbList) para páginas de un solo nivel bajo Inicio
   * (alta, servicios, equipo, portal, simulador, blog). `path` es la ruta
   * sin prefijo de idioma (p.ej. "/alta"); Inicio se antepone solo. Los
   * artículos del blog ya generan su propio BreadcrumbList de 3 niveles en
   * Articulo.astro y no usan este prop. */
  breadcrumbs?: { name: string; path: string }[];
}

const { lang, path, active, title, description, showCtaFinal = true, noindex = false, minimalHeader = false, hideHeader = false, localesAvailable = locales, ogType = 'website', articlePublishedTime, articleModifiedTime, breadcrumbs } = Astro.props;
const t = useTranslations(lang);

// Toda España EXCEPTO Canarias, Navarra y País Vasco (tienen regímenes
// fiscales propios) — coincide con el texto visible del footer/home. No
// tocar sin comprobar antes que el texto visible sigue diciendo lo mismo.
const areaServed = [
  'Andalucía', 'Aragón', 'Principado de Asturias', 'Islas Baleares', 'Cantabria',
  'Castilla-La Mancha', 'Castilla y León', 'Cataluña', 'Extremadura', 'Galicia',
  'Comunidad de Madrid', 'Región de Murcia', 'La Rioja', 'Comunitat Valenciana',
  'Ceuta', 'Melilla',
].map((name) => ({ '@type': 'State', name }));

const breadcrumbLd = breadcrumbs && breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.blog.breadcrumbHome, item: new URL(localizedPath('/', lang), Astro.site).toString() },
    ...breadcrumbs.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      name: b.name,
      item: new URL(localizedPath(b.path, lang), Astro.site).toString(),
    })),
  ],
} : null;

// localizedPath normaliza tanto si `path` llega con prefijo de idioma
// (p.ej. "/ca/servicios") como sin él, así que sirve tal cual para calcular
// la URL canónica y las alternativas de cada idioma.
const canonicalUrl = new URL(localizedPath(path, lang), Astro.site);
const ogImageUrl = new URL('/brand/logo-largo-claro.png', Astro.site);
const ogLocale: Record<Locale, string> = { es: 'es_ES', ca: 'ca_ES', en: 'en_GB' };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" />

    <link rel="canonical" href={canonicalUrl} />
    {localesAvailable.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(localizedPath(path, l), Astro.site)} />
    ))}
    {localesAvailable.includes(defaultLocale) && (
      <link rel="alternate" hreflang="x-default" href={new URL(localizedPath(path, defaultLocale), Astro.site)} />
    )}

    <meta property="og:type" content={ogType} />
    {ogType === 'article' && articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {ogType === 'article' && articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
    <meta property="og:site_name" content="Asesoría Madal" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {locales.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preload" href="/fonts/domine-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/publicsans-400.woff2" as="font" type="font/woff2" crossorigin />

    <ClientRouter />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'AccountingService',
      '@id': 'https://asesoriamadal.es/#organization',
      name: 'Asesoría Madal',
      url: 'https://asesoriamadal.es',
      logo: new URL('/brand/logo-am-claro.svg', Astro.site).toString(),
      email: 'contacto@asesoriamadal.es',
      // Solo localidad, a propósito: no se publica la dirección completa
      // (la de /aviso-legal es solo a efectos de notificaciones legales).
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Barcelona',
        addressCountry: 'ES',
      },
      areaServed,
      // Rango real de los planes publicados en la home (Debut 35€ a
      // Expansión 200€/mes, todos + IVA) — no un valor inventado.
      priceRange: '35–200 €/mes + IVA',
      inLanguage: lang,
      description: 'Gestoría y asesoría 100% online para autónomos y pymes en España.',
      sameAs: [
        'https://www.linkedin.com/company/asesor%C3%ADa-madal',
      ],
    })} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      '@id': 'https://asesoriamadal.es/#website',
      name: 'Asesoría Madal',
      url: 'https://asesoriamadal.es/',
      inLanguage: locales,
    })} />

    {breadcrumbLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />}

    <script is:inline>
      // Aplicamos el tema guardado antes de pintar, para evitar el parpadeo
      // de cambiar de claro a oscuro (o viceversa) justo después de cargar.
      (function () {
        var stored = localStorage.getItem('theme');
        if (stored === 'dark' || stored === 'light') {
          document.documentElement.setAttribute('data-theme', stored);
        }
      })();
    </script>

    <script defer src="https://analytics.asesoriamadal.es/script.js" data-website-id="0e8413cc-33b1-4241-8947-32950b30b593"></script>
  </head>
  <body>
    {!hideHeader && <Header lang={lang} path={path} active={active} minimal={minimalHeader} />}
    <main>
      <slot />
      {showCtaFinal && <TrustBanner lang={lang} />}
      {showCtaFinal && (
        <section class="cta-final" id="cta-final">
          <h2>{t.ctaFinal.title}</h2>
          <div class="actions">
            <ContactSwitch lang={lang} triggerClass="btn btn-primary btn-stamp" origen="cta_final" />
          </div>
          <p class="fine">{t.ctaFinal.fine}</p>
        </section>
      )}
    </main>
    <Footer lang={lang} />
    <CookieConsent lang={lang} />
    <SpeedInsights />
  </body>
</html>
