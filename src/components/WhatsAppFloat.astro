---
import type { Locale } from '../i18n/ui';
import { GOOGLE_ADS_CONVERSION_ID, GOOGLE_ADS_WHATSAPP_LABEL } from '../lib/ads-config';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

// Número de empresa en formato internacional, sin "+" ni espacios (formato
// que exige wa.me). Sin mensaje precargado a propósito (decisión del
// usuario). Es un simple enlace: no hay API ni token, y WhatsApp/Meta no
// recibe nada hasta que la persona pulsa.
const WHATSAPP_NUMBER = '34692844394';

const labels: Record<Locale, string> = {
  es: 'Escríbenos por WhatsApp',
  ca: 'Escriu-nos per WhatsApp',
  en: 'Message us on WhatsApp',
};
const label = labels[lang] ?? labels.es;
// Solo hay "send_to" si ambos datos de Google Ads están rellenos.
const adsSendTo = GOOGLE_ADS_CONVERSION_ID && GOOGLE_ADS_WHATSAPP_LABEL
  ? `${GOOGLE_ADS_CONVERSION_ID}/${GOOGLE_ADS_WHATSAPP_LABEL}`
  : '';
---

<a
  class="whatsapp-float"
  href={`https://wa.me/${WHATSAPP_NUMBER}`}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  title={label}
  data-umami-event="whatsapp_click"
  data-ads-send-to={adsSendTo || undefined}
>
  <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true" focusable="false" fill="currentColor">
    <path d="M16.04 3C9.4 3 4.02 8.37 4.02 15c0 2.12.55 4.19 1.6 6.01L4 29l8.2-1.58A12 12 0 0 0 16.04 27C22.67 27 28.05 21.63 28.05 15S22.67 3 16.04 3Zm0 21.97c-1.8 0-3.56-.49-5.1-1.4l-.37-.22-4.87.94.99-4.74-.24-.38A9.94 9.94 0 0 1 6.05 15c0-5.5 4.49-9.97 9.99-9.97S26.03 9.5 26.03 15s-4.49 9.97-9.99 9.97Zm5.47-7.46c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.08 1.77-.72 2.02-1.42.25-.7.25-1.29.17-1.42-.07-.12-.27-.2-.57-.35Z"></path>
  </svg>
</a>

<script>
  // Conversión de Google Ads al pulsar el botón. `window.gtag` solo existe si
  // el visitante aceptó las cookies de publicidad (lo define CookieConsent al
  // cargar el tag), así que sin consentimiento esto no hace nada. Se
  // reengancha en "astro:page-load" como el resto de scripts del sitio.
  document.addEventListener('astro:page-load', () => {
    const link = document.querySelector<HTMLAnchorElement>('.whatsapp-float');
    const sendTo = link?.dataset.adsSendTo;
    if (!link || !sendTo) return;
    link.addEventListener('click', () => {
      const gtag = (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag;
      if (typeof gtag === 'function') gtag('event', 'conversion', { send_to: sendTo });
    });
  });
</script>

<style is:global>
  /* Verde de marca de WhatsApp a propósito (reconocible al instante), no de
     la paleta corporativa: es un patrón universal. */
  .whatsapp-float {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 50; /* por debajo del banner de cookies (60) */
    display: grid;
    place-items: center;
    width: 3.6rem;
    height: 3.6rem;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    box-shadow: 0 6px 18px -4px rgba(0, 0, 0, 0.35);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .whatsapp-float:hover {
    transform: translateY(-2px) scale(1.04);
    box-shadow: 0 10px 24px -6px rgba(0, 0, 0, 0.4);
  }
  .whatsapp-float:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }
  @media (max-width: 640px) {
    .whatsapp-float { right: 1rem; bottom: 1rem; width: 3.4rem; height: 3.4rem; }
  }
</style>
