---
// Parte de la línea Madal Pricing (2026-11-21). Ver PricingFrame.astro.
import PricingFrame from './PricingFrame.astro';

const BOOKING_URL = 'https://meetings-eu1.hubspot.com/asesoria-madal';
const MAILTO = 'mailto:contacto@asesoriamadal.es?subject=Madal%20Pricing';
---

<PricingFrame current="planes">
  <header class="hero page-hero" id="top">
    <div class="wrap">
      <div class="fig">PLANES</div>
      <h1>Empieza donde tenga <em>sentido para ti</em></h1>
      <p class="dek">Antes de pagar nada hay una llamada gratuita para ver tus números. Después eliges un plan y puedes subir de nivel cuando lo necesites.</p>
      <p class="under mono">PRECIOS SIN IVA · 1ª LLAMADA GRATIS</p>
    </div>
  </header>

  <section id="que-ofrecemos">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="fig">QUÉ OFRECEMOS</div>
        <h2>Tres cosas, de menor a mayor compromiso</h2>
        <p>Puedes quedarte en la primera. Cada paso se apoya en el anterior y solo das el siguiente si te tiene sentido.</p>
      </div>
      <div class="pp-grid reveal">
        <div class="panel pp-block">
          <span class="tl"></span><span class="tr"></span><span class="bl"></span><span class="br"></span>
          <span class="pp-card-meta mono">01 · SABER DÓNDE ESTÁS</span>
          <h3>Tus números reales</h3>
          <p>Calculamos cuánto te cuesta de verdad cada hora, cada cliente y cada producto, y dónde estás frente a tu sector. Sales con un informe y una sesión para leerlo juntos.</p>
          <span class="pp-block-plan mono">PLAN · DIAGNÓSTICO</span>
        </div>
        <div class="panel pp-block">
          <span class="tl"></span><span class="tr"></span><span class="bl"></span><span class="br"></span>
          <span class="pp-card-meta mono">02 · REHACER TUS PRECIOS</span>
          <h3>Tarifas que cobran lo que valen</h3>
          <p>Montamos tus packs y niveles para que cada tramo deje margen, en vez de un precio único que no encaja con nadie. Sales con tarifas listas para publicar.</p>
          <span class="pp-block-plan mono">PLAN · DIAGNÓSTICO + ARQUITECTURA</span>
        </div>
        <div class="panel pp-block">
          <span class="tl"></span><span class="tr"></span><span class="bl"></span><span class="br"></span>
          <span class="pp-card-meta mono">03 · MANTENER Y COMPROBAR</span>
          <h3>Que el precio siga bien</h3>
          <p>Vigilamos tus costes y tus descuentos cada mes y, si tienes volumen suficiente, probamos cambios de precio de forma controlada antes de aplicarlos a todo.</p>
          <span class="pp-block-plan mono">PLANES · SEGUIMIENTO, DESCUENTOS Y EXPERIMENTACIÓN</span>
        </div>
      </div>
    </div>
  </section>

  <section id="valor">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="fig">EL VALOR</div>
        <h2>¿Cuánto tienen que mejorar tus números para que se pague?</h2>
        <p>No prometemos un resultado concreto, porque depende de cada negocio. Lo que sí podemos decirte es cuánto tendría que mejorar lo que ganas para que cada plan se amortice en un año. Pon lo que facturas.</p>
      </div>
      <div class="panel pp-roi reveal" id="roi">
        <span class="tl"></span><span class="tr"></span><span class="bl"></span><span class="br"></span>
        <form class="pp-roi-form" novalidate>
          <label class="pp-field">
            <span>¿Cuánto facturas al año? (€, sin IVA)</span>
            <input type="number" name="ingresos" inputmode="decimal" min="0" step="1000" value="40000" />
          </label>
          <fieldset class="pp-field pp-radios">
            <legend>Precio que te aplicamos</legend>
            <label><input type="radio" name="tipo" value="nuevo" checked /> <span>Cliente nuevo</span></label>
            <label><input type="radio" name="tipo" value="cliente" /> <span>Cliente de la gestoría</span></label>
          </fieldset>
        </form>
        <div class="pp-roi-out" aria-live="polite">
          <table class="pp-table">
            <thead><tr><th>Plan</th><th>Precio</th><th>Tienes que ganar más, en % de lo que facturas</th></tr></thead>
            <tbody data-r="filas"></tbody>
          </table>
          <ul class="pp-ins">
            <li data-r="uno"></li>
            <li data-r="tres"></li>
          </ul>
          <p class="pp-note mono">EJEMPLO: SI FACTURAS 40.000 € Y UN PLAN CUESTA 300 €, NECESITAS GANAR 300 € MÁS AL AÑO, UN 0,75 % DE LO QUE FACTURAS. ES UN CÁLCULO DE AMORTIZACIÓN, NO UNA PROMESA DE RESULTADO.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="planes">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="fig">PLANES</div>
        <h2>Elige tu plan</h2>
        <p>Cada plan cubre un tramo de pilares y dice exactamente qué recibes. La primera llamada es gratuita.</p>
      </div>

      <div class="plans reveal">
        <div class="plan panel" data-nombre="Diagnóstico" data-cliente="300" data-nuevo="500" data-sufijo="">
          <span class="tl"></span><span class="tr"></span><span class="bl"></span><span class="br"></span>
          <span class="tag mono">01 · Pilares 1–2</span>
          <h3>Diagnóstico</h3>
          <p class="scope mono">PAGO ÚNICO</p>
          <p class="plan-outcome"><strong>Resultado:</strong> Sabrás cuánto te cuesta de verdad cada hora, cada cliente y cada producto, y si tus precios están donde deberían.</p>
          <ul>
            <li>Unit economics de tu negocio</li>
            <li>Benchmarking frente a tu sector</li>
            <li>Informe + sesión de lectura de resultados</li>
          </ul>
          <div class="price">
            <div style="display:flex;justify-content:space-between;"><span>Cliente de la gestoría</span><strong class="mono" style="color:var(--accent-strong)">300 €</strong></div>
            <div style="display:flex;justify-content:space-between;margin-top:6px;"><span>Nuevo cliente</span><strong class="mono">500 €</strong></div>
          </div>
          <a class="btn btn-ghost" href={BOOKING_URL}>Empezar aquí</a>
        </div>

        <div class="plan panel featured" data-nombre="Diagnóstico + Arquitectura" data-cliente="900" data-nuevo="1200" data-sufijo="">
          <span class="tl"></span><span class="tr"></span><span class="bl"></span><span class="br"></span>
          <span class="tag mono">02 · Pilares 1–3</span>
          <h3>Diagnóstico + Arquitectura</h3>
          <p class="scope mono">PAGO ÚNICO</p>
          <p class="plan-outcome"><strong>Resultado:</strong> Sales con tus packs y tarifas rehechos, listos para publicar o presentar a tus clientes.</p>
          <ul>
            <li>Todo lo del pack Diagnóstico</li>
            <li>Arquitectura de packs y niveles</li>
            <li>Tarifas listas para publicar</li>
          </ul>
          <div class="price">
            <div style="display:flex;justify-content:space-between;"><span>Cliente de la gestoría</span><strong class="mono" style="color:var(--accent-strong)">900 €</strong></div>
            <div style="display:flex;justify-content:space-between;margin-top:6px;"><span>Nuevo cliente</span><strong class="mono">1.200 €</strong></div>
          </div>
          <a class="btn btn-primary" href={BOOKING_URL}>Reservar diagnóstico</a>
        </div>

        <div class="plan panel" data-nombre="Seguimiento mensual" data-cliente="1440" data-nuevo="1440" data-sufijo=" (12 meses)">
          <span class="tl"></span><span class="tr"></span><span class="bl"></span><span class="br"></span>
          <span class="tag mono">03 · Pilares 1–2</span>
          <h3>Seguimiento mensual</h3>
          <p class="scope mono">MENSUAL · REQUIERE 01 O 02</p>
          <p class="plan-outcome"><strong>Resultado:</strong> Te avisamos cada mes si se mueven tus costes o tu posición frente al mercado.</p>
          <ul>
            <li>Recalculamos tu unit economics cada mes</li>
            <li>Revisamos tu posición frente al mercado</li>
            <li>Aviso si se mueve algo: costes o competencia</li>
          </ul>
          <div class="price">Para quien ya tiene el diagnóstico hecho<br /><strong>120 €/mes</strong></div>
          <a class="btn btn-ghost" href={MAILTO}>Hablar con nosotros</a>
        </div>

        <div class="plan panel" data-nombre="Análisis de descuentos" data-cliente="250" data-nuevo="400" data-sufijo="">
          <span class="tl"></span><span class="tr"></span><span class="bl"></span><span class="br"></span>
          <span class="tag mono">04 · Pilar 4</span>
          <h3>Análisis de descuentos</h3>
          <p class="scope mono">PAGO ÚNICO + OPCIÓN MENSUAL</p>
          <p class="plan-outcome"><strong>Resultado:</strong> Sabrás cuántos descuentos das de verdad y cuánto margen te cuestan.</p>
          <ul>
            <li>Cálculo rápido de tu margen real (versión ligera del pilar 01, solo lo necesario para esto)</li>
            <li>Qué descuentos das de verdad, no los que crees</li>
            <li>Qué le hacen esos descuentos a ese margen - cifra real, no sensación</li>
            <li>Informe con el impacto. Se contrata sin necesidad de los packs 01–03</li>
          </ul>
          <div class="plan-addon">
            <span class="lbl">+ Opción · Seguimiento mensual</span>
            <p>Si quieres vigilarlo mes a mes en vez de una foto única: +60 €/mes.</p>
          </div>
          <div class="price">
            <div style="display:flex;justify-content:space-between;"><span>Cliente de la gestoría</span><strong class="mono" style="color:var(--accent-strong)">250 €</strong></div>
            <div style="display:flex;justify-content:space-between;margin-top:6px;"><span>Nuevo cliente</span><strong class="mono">400 €</strong></div>
          </div>
          <a class="btn btn-ghost" href={MAILTO}>Hablar con nosotros</a>
        </div>

        <div class="plan panel premium" data-nombre="Experimentación" data-cliente="1200" data-nuevo="1500" data-sufijo="">
          <span class="tl"></span><span class="tr"></span><span class="bl"></span><span class="br"></span>
          <span class="tag mono">05 · Pilares 1–2–4–5</span>
          <h3>Experimentación</h3>
          <p class="scope mono">PROYECTO · ~2 MESES</p>
          <p class="plan-outcome"><strong>Resultado:</strong> Pruebas cambios de precio de forma controlada y llegas a un resultado medido. Funciona mejor con volumen suficiente de ventas.</p>
          <ul>
            <li>Análisis completo de unit economics + benchmarking</li>
            <li>Análisis de descuentos incluido</li>
            <li>~2 meses probando cambios de precio reales, medidos</li>
            <li>Informe final con el resultado validado - no una recomendación sobre papel</li>
          </ul>
          <div class="plan-addon">
            <span class="lbl">+ Después</span>
            <p>Al terminar, puedes pasar al seguimiento mensual estándar (pack 03, 120 €/mes) para no perder lo aprendido.</p>
          </div>
          <div class="price">
            <div style="display:flex;justify-content:space-between;"><span>Cliente de la gestoría</span><strong class="mono" style="color:var(--accent2-strong)">1.200 €</strong></div>
            <div style="display:flex;justify-content:space-between;margin-top:6px;"><span>Nuevo cliente</span><strong class="mono">1.500 €</strong></div>
          </div>
          <a class="btn btn-primary" href={BOOKING_URL}>Reservar diagnóstico</a>
        </div>
      </div>
      <p class="sim-note reveal" style="margin-top:22px;">Precios sin IVA. La primera llamada siempre es gratuita y sin compromiso.</p>
    </div>
  </section>

  <section id="conexion">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="fig">CONEXIÓN</div>
        <h2>Pricing forma parte de Asesoría Madal</h2>
        <p>El diagnóstico te cuesta distinto según vengas o no de la gestoría.</p>
      </div>
      <div class="connect reveal">
        <div class="connect-row">
          <div class="who"><span class="tag">Ya eres cliente</span>De la gestoría, en cualquier plan</div>
          <div class="arrow">→</div>
          <div class="what">Diagnóstico a precio de cliente (300 €), porque tu balance ya está en nuestras manos.</div>
        </div>
        <div class="connect-row">
          <div class="who"><span class="tag">Plan superior</span>Clientes en el tramo más alto de la gestoría</div>
          <div class="arrow">→</div>
          <div class="what">El diagnóstico entra dentro del valor de tu plan, sin coste adicional.</div>
        </div>
        <div class="connect-row">
          <div class="who"><span class="tag">Aún no eres cliente</span>No trabajas todavía con Asesoría Madal</div>
          <div class="arrow">→</div>
          <div class="what">Llamada gratuita primero. Si compensa seguir, pagas el diagnóstico suelto (500 €) o pasas a la gestoría completa - lo que prefieras.</div>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-final" id="cta">
    <div class="wrap">
      <div class="panel cta-panel reveal">
        <span class="tl"></span><span class="tr"></span><span class="bl"></span><span class="br"></span>
        <div>
          <div class="fig" style="margin-bottom:12px;">SIGUIENTE PASO</div>
          <h2>Tu balance ya tiene la primera respuesta.</h2>
          <p>Reserva una llamada y te decimos, con tus propios números, si estás cobrando lo que deberías.</p>
        </div>
        <a class="btn btn-primary" href={BOOKING_URL} style="padding:14px 26px; font-size:14px;">Reservar diagnóstico →</a>
      </div>
    </div>
  </section>
</PricingFrame>

<script>
  function initRoi() {
    const raiz = document.getElementById('roi');
    if (!raiz || raiz.dataset.listo) return;
    raiz.dataset.listo = '1';
    const form = raiz.querySelector('form') as HTMLFormElement;
    const filas = raiz.querySelector('[data-r="filas"]') as HTMLElement;
    const uno = raiz.querySelector('[data-r="uno"]') as HTMLElement;
    const tres = raiz.querySelector('[data-r="tres"]') as HTMLElement;
    const eur0 = new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0, useGrouping: 'always' });
    const pct = new Intl.NumberFormat('es-ES', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    const planes = Array.from(document.querySelectorAll<HTMLElement>('.plan[data-nombre]'));

    const calcular = () => {
      const d = new FormData(form);
      const ingresos = Math.max(0, Number(d.get('ingresos')) || 0);
      const tipo = d.get('tipo') === 'cliente' ? 'cliente' : 'nuevo';
      if (ingresos <= 0) { filas.innerHTML = ''; uno.textContent = ''; tres.textContent = ''; return; }
      filas.innerHTML = planes.map((pl) => {
        const precio = Number(pl.dataset[tipo]) || 0;
        const mejora = (precio / ingresos) * 100;
        const suf = pl.dataset.sufijo || '';
        return `<tr><td>${pl.dataset.nombre}</td><td>${eur0.format(precio)}${suf}</td><td>${pct.format(mejora)} %</td></tr>`;
      }).join('');
      uno.textContent = `Cada 1 % que mejores lo que ganas son ${eur0.format(ingresos * 0.01)} al año.`;
      tres.textContent = `Con una mejora del 3 % serían ${eur0.format(ingresos * 0.03)} al año; con un 5 %, ${eur0.format(ingresos * 0.05)}.`;
    };
    form.addEventListener('submit', (e) => e.preventDefault());
    form.addEventListener('input', calcular);
    calcular();
  }
  document.addEventListener('astro:page-load', initRoi);
</script>
