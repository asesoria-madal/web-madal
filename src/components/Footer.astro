---
import { useTranslations, localizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const home = lang === 'es' ? '/' : `/${lang}/`;
---

<footer class="site">
  <div class="page">
    <div class="foot-cols">
      <div>
        <a href={home} class="wordmark">Asesoría<span>Madal</span></a>
        <p class="foot-tagline">{t.footer.tagline}</p>
      </div>
      <div>
        <h4>{t.footer.navTitle}</h4>
        <nav class="foot-nav">
          <a href={home}>{t.nav.home}</a>
          <a href={localizedPath('/simulador', lang)}>{t.nav.simulador}</a>
          <a href={localizedPath('/alta', lang)}>{t.nav.alta}</a>
          <a href={localizedPath('/blog', lang)}>{t.nav.blog}</a>
          <a href={localizedPath('/servicios', lang)}>{t.nav.servicios}</a>
          <a href={localizedPath('/equipo', lang)}>{t.nav.conocenos}</a>
          <a href="/portal">{t.footer.portal}</a>
        </nav>
      </div>
      <div>
        <h4>{t.footer.contactTitle}</h4>
        <ul class="foot-list">
          <li><a href="mailto:contacto@asesoriamadal.es">contacto@asesoriamadal.es</a></li>
          <li><a href="#">{t.footer.contactCall}</a></li>
        </ul>
      </div>
      <div>
        <h4>{t.footer.whereTitle}</h4>
        <ul class="foot-list">
          <li>{t.footer.whereOnline}</li>
          <li>{t.footer.whereBase}</li>
          <li>{t.footer.whereSpain}</li>
        </ul>
      </div>
    </div>
    <div class="foot-bottom">
      <p class="legal">{t.footer.legal}</p>
      <div class="foot-bottom-links">
        <a href="/aviso-legal">{t.footer.avisoLegal}</a>
        <a href="/privacidad">{t.footer.privacidad}</a>
        <a href="/cookies">{t.footer.cookies}</a>
        <a
          href="https://www.linkedin.com/company/asesor%C3%ADa-madal"
          target="_blank"
          rel="noopener noreferrer"
          class="foot-social"
          aria-label={t.footer.socialLinkedin}
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.114 20.452H3.558V9h3.556v11.452z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
