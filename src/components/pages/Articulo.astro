---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import type { Locale } from '../../i18n/ui';
import { useTranslations, localizedPath } from '../../i18n/utils';
import { getSortedBlogPosts, getRelatedPosts } from '../../lib/blog';
import ContactSwitch from '../ContactSwitch.astro';

interface Props {
  lang: Locale;
  entry: CollectionEntry<'blog'>;
}

const { lang, entry } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);

const dateLocale = lang === 'es' ? 'es-ES' : lang === 'ca' ? 'ca-ES' : 'en-GB';
const publishedDate = entry.data.date.toLocaleDateString(dateLocale, { year: 'numeric', month: 'long', day: 'numeric' });
const updatedDate = entry.data.updatedDate?.toLocaleDateString(dateLocale, { year: 'numeric', month: 'long', day: 'numeric' });

const allPosts = await getSortedBlogPosts(lang);
const relatedPosts = getRelatedPosts(allPosts, entry, lang, 3);

// Mismas FAQs que en /blog (ui.ts), filtradas por el campo `related` que
// las conecta con el slug de este artículo — ver src/i18n/ui.ts. La
// anotación explícita hace falta porque, con `ui` declarado `as const`,
// los ítems sin `related` no tienen esa clave en su tipo inferido.
interface FaqItem { q: string; a: string; related?: string }
const allFaqItems: FaqItem[] = [...t.blog.faqGeneralesItems, ...t.blog.faqAutonomosItems, ...t.blog.faqSlItems];
const relatedFaqs = allFaqItems.filter((item) => item.related === entry.data.slug);

const articleUrl = new URL(localizedPath(`/blog/${entry.data.slug}`, lang), Astro.site).toString();

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.date.toISOString(),
  dateModified: (entry.data.updatedDate ?? entry.data.date).toISOString(),
  inLanguage: lang,
  author: { '@type': 'Organization', name: 'Asesoría Madal' },
  publisher: { '@type': 'Organization', name: 'Asesoría Madal' },
  mainEntityOfPage: articleUrl,
};

// Migas de pan: Inicio › FAQs › [artículo]. El texto visible y el JSON-LD
// usan las mismas etiquetas para que coincidan (requisito de Google).
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.blog.breadcrumbHome, item: new URL(localizedPath('/', lang), Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: t.nav.blog, item: new URL(localizedPath('/blog', lang), Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: articleUrl },
  ],
};
---

<div class="article-page">
  <nav class="breadcrumb" aria-label={t.blog.breadcrumbAria}>
    <a href={localizedPath('/', lang)}>{t.blog.breadcrumbHome}</a>
    <span aria-hidden="true">›</span>
    <a href={localizedPath('/blog', lang)}>{t.nav.blog}</a>
    <span aria-hidden="true">›</span>
    <span aria-current="page">{entry.data.title}</span>
  </nav>
  <p class="eyebrow">{t.blog.categories.find((c) => c.id === entry.data.cat)?.label ?? entry.data.cat}</p>
  <h1 class="article-title">{entry.data.title}</h1>
  <p class="article-meta">
    <span>{t.blog.publishedLabel} {publishedDate}</span>
    {updatedDate && updatedDate !== publishedDate && <span>· {t.blog.updatedLabel} {updatedDate}</span>}
    <span>· <strong>{t.blog.reviewedBy}</strong></span>
  </p>
  <div class="article-share">
    <button
      type="button"
      class="article-share-btn"
      data-share-url={articleUrl}
      data-share-title={entry.data.title}
      data-copied-label={t.blog.shareCopied}
    >{t.blog.shareLabel}</button>
  </div>
  <div class="article-body">
    <Content />
  </div>

  {entry.data.sources && entry.data.sources.length > 0 && (
    <div class="article-sources">
      <h2>{t.blog.sourcesLabel}</h2>
      <ul>
        {entry.data.sources.map((source) => (
          <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a></li>
        ))}
      </ul>
    </div>
  )}

  {relatedFaqs.length > 0 && (
    <div class="article-related-faq">
      <h2>{t.blog.relatedFaqTitle}</h2>
      <div class="faq-group">
        {relatedFaqs.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  )}

  {relatedPosts.length > 0 && (
    <div class="article-related">
      <h2>{t.blog.relatedArticlesTitle}</h2>
      <div class="post-grid">
        {relatedPosts.map((post) => (
          <a href={localizedPath(`/blog/${post.slug}`, lang)} class="post-card">
            <span class="cat">{post.cat} · {post.date}</span>
            <h3>{post.title}</h3>
            <p>{post.desc}</p>
            <span class="read">{t.blog.readMore}</span>
          </a>
        ))}
      </div>
    </div>
  )}
</div>

<aside class="ask-float article-nudge" id="articleNudge" hidden>
  <button type="button" class="ask-float-close" id="articleNudgeClose" aria-label={t.blog.close}>✕</button>
  <h3>{t.blog.articleNudgeTitle}</h3>
  <p>{t.blog.articleNudgeDesc}</p>
  <ContactSwitch lang={lang} triggerClass="btn btn-primary article-nudge-cta" origen="blog_nudge" />
</aside>

<script type="application/ld+json" is:inline set:html={JSON.stringify(articleLd)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />

<script>
  // Botón compartir: usa el diálogo nativo del sistema en móvil
  // (navigator.share) y, donde no existe, copia el enlace al portapapeles.
  const shareBtn = document.querySelector('.article-share-btn');
  if (shareBtn instanceof HTMLButtonElement) {
    const shareUrl = shareBtn.dataset.shareUrl || window.location.href;
    const shareTitle = shareBtn.dataset.shareTitle || document.title;
    const copiedLabel = shareBtn.dataset.copiedLabel || 'OK';
    const originalLabel = shareBtn.textContent;
    shareBtn.addEventListener('click', async () => {
      if (navigator.share) {
        try {
          await navigator.share({ title: shareTitle, url: shareUrl });
        } catch {
          // el usuario canceló el diálogo: no hacemos nada
        }
        return;
      }
      try {
        await navigator.clipboard.writeText(shareUrl);
        shareBtn.textContent = copiedLabel;
        window.setTimeout(() => {
          shareBtn.textContent = originalLabel;
        }, 2000);
      } catch {
        // sin permiso de portapapeles: dejamos el botón como estaba
      }
    });
  }

  // Aviso no intrusivo (tarjeta en esquina, no un modal a pantalla completa)
  // que aparece al llegar a ~3/4 del artículo, para no interrumpir la
  // lectura ni arriesgar la penalización de Google a los intersticiales
  // móviles que tapan el contenido.
  const nudge = document.getElementById('articleNudge');
  const nudgeClose = document.getElementById('articleNudgeClose');
  const articleBody = document.querySelector('.article-body');

  if (nudge && articleBody instanceof HTMLElement && sessionStorage.getItem('articleNudgeDismissed') !== '1') {
    const checkScroll = () => {
      const bodyTop = window.scrollY + articleBody.getBoundingClientRect().top;
      const triggerY = bodyTop + articleBody.offsetHeight * 0.75;
      if (window.scrollY + window.innerHeight >= triggerY) {
        nudge.hidden = false;
        window.removeEventListener('scroll', checkScroll);
      }
    };
    window.addEventListener('scroll', checkScroll, { passive: true });
    checkScroll();
  }

  nudgeClose?.addEventListener('click', () => {
    if (nudge) nudge.hidden = true;
    sessionStorage.setItem('articleNudgeDismissed', '1');
  });
</script>
