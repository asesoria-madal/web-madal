---
// Encuesta de satisfacción (2026-11-05). El correo lo manda el workflow n8n
// "Encuesta de satisfacción" a los 6 meses, al año y luego cada año desde
// `clientes.created_at`, con un enlace a esta página con ?id=<uuid de la
// fila de encuestas_satisfaccion>. Sin sesión: el "acceso" es conocer ese
// uuid (igual que los formularios de alta/traspaso/trabajador), no hay RLS
// de por medio porque el endpoint usa la service role.
//
// Existe en es/ca/en (/encuesta, /ca/encuesta, /en/encuesta); textos en
// src/i18n/encuesta.ts. El idioma de la página lo decide el enlace que
// manda n8n según `clientes.idioma` en el momento del envío — no cambia si
// el cliente cambia de idioma después.
import { ENCUESTA, type EncuestaLang } from '../../i18n/encuesta';

interface Props { lang?: EncuestaLang; }
const { lang = 'es' } = Astro.props;
const t = ENCUESTA[lang];
const EMAIL_CONTACTO = 'contacto@asesoriamadal.es';
---

<div id="view-encuesta">
  <div class="page view-intro">
    <p class="eyebrow">{t.eyebrow}</p>
    <h2 class="section-title">{t.title}</h2>
    <p class="section-sub">{t.intro}</p>
  </div>

  <form id="encuestaForm" class="alta-form page view-block" data-msg-sin-puntuacion={t.errorSinPuntuacion}>
    <div class="field-group">
      <p class="field-group-label">{t.estrellasLabel}</p>
      <div class="encuesta-estrellas" role="radiogroup" aria-label={t.estrellasLabel}>
        {[1, 2, 3, 4, 5].map((n) => (
          <button type="button" class="encuesta-estrella" data-valor={n} aria-pressed="false" aria-label={String(n)}>★</button>
        ))}
      </div>
    </div>

    <p class="form-error" id="errorPuntuacion" hidden>{t.errorSinPuntuacion}</p>

    <label class="field">{t.comentarioLabel}
      <textarea id="fComentario" maxlength="2000" rows="4" placeholder={t.comentarioPlaceholder}></textarea>
    </label>

    <p class="form-error" id="formError" hidden>{t.error}<a href={`mailto:${EMAIL_CONTACTO}`}>{EMAIL_CONTACTO}</a></p>

    <button type="submit" class="btn btn-primary form-submit" id="formSubmit">{t.enviar}</button>
  </form>

  <div class="page view-block form-success" id="formSuccess" hidden>
    <p class="eyebrow">{t.recibido}</p>
    <h2 class="section-title">{t.gracias}</h2>
    <p class="section-sub">{t.graciasSub}</p>
  </div>

  <div class="page view-block form-success" id="noValido" hidden>
    <p class="section-sub">{t.errorNoValido}<a href={`mailto:${EMAIL_CONTACTO}`}>{EMAIL_CONTACTO}</a></p>
  </div>
</div>

<style>
  .encuesta-estrellas { display: flex; gap: 0.3rem; }
  .encuesta-estrella {
    font-size: 2.2rem;
    line-height: 1;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--line);
    padding: 0.1rem;
    transition: color 0.15s ease, transform 0.1s ease;
  }
  .encuesta-estrella:hover,
  .encuesta-estrella:focus-visible { transform: scale(1.1); }
  .encuesta-estrella.is-filled { color: var(--accent); }
</style>

<script>
  import { track } from '../../scripts/analytics';

  (function () {
    const form = document.getElementById('encuestaForm') as HTMLFormElement | null;
    if (!form) return;

    const success = document.getElementById('formSuccess') as HTMLElement;
    const noValido = document.getElementById('noValido') as HTMLElement;
    const errorEl = document.getElementById('formError') as HTMLElement;
    const submitBtn = document.getElementById('formSubmit') as HTMLButtonElement;
    const comentario = document.getElementById('fComentario') as HTMLTextAreaElement;
    const estrellas = Array.from(form.querySelectorAll<HTMLButtonElement>('.encuesta-estrella'));

    const params = new URLSearchParams(window.location.search);
    const id = params.get('id');
    if (!id) {
      form.hidden = true;
      noValido.hidden = false;
    }

    let valor = 0;
    function pintar() {
      estrellas.forEach((btn) => {
        const n = Number(btn.dataset.valor);
        const lleno = n <= valor;
        btn.classList.toggle('is-filled', lleno);
        btn.setAttribute('aria-pressed', String(lleno));
      });
    }
    estrellas.forEach((btn) => {
      btn.addEventListener('click', () => {
        valor = Number(btn.dataset.valor);
        pintar();
      });
    });

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      errorEl.hidden = true;

      if (valor < 1 || valor > 5) {
        errorEl.textContent = form.dataset.msgSinPuntuacion || '';
        errorEl.hidden = false;
        return;
      }

      submitBtn.disabled = true;
      try {
        const res = await fetch('/api/encuesta', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, estrellas: valor, comentario: comentario.value.trim() || undefined }),
        });
        if (res.status === 404 || res.status === 409) {
          form.hidden = true;
          noValido.hidden = false;
          return;
        }
        if (!res.ok) {
          errorEl.hidden = false;
          submitBtn.disabled = false;
          return;
        }
        track('encuesta_satisfaccion_enviada', { estrellas: valor });
        form.hidden = true;
        success.hidden = false;
        window.scrollTo({ top: 0 });
      } catch {
        errorEl.hidden = false;
        submitBtn.disabled = false;
      }
    });
  })();
</script>
