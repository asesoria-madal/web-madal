---
// Formulario de traspaso de gestoría (autónomo o SL), en castellano, catalán e inglés con los
// textos en src/i18n/formularios.ts. Sin enlazar desde el menú: el enlace lo manda n8n
// (Onboarding) con ?nif=…&email=….
//
// Un solo componente para los dos tipos (en vez de duplicar el formulario entero): el prop
// `tipo` decide qué etiquetas y qué secciones se muestran, pero la estructura y el resto de
// campos son los mismos. Las páginas (formulario-traspaso-autonomo y formulario-traspaso-sl,
// y sus versiones /ca/ y /en/) son solo un wrapper con el `tipo` y el idioma - ver schema.sql
// (tabla traspasos_nuevos) para el porqué de compartir tabla también.
//
// Revisión del 2026-11-11: ver la cabecera de i18n/formularios.ts.
import { CAMPOS, MODELOS_AUTONOMO, MODELOS_SL, MSG_CAMPO, PRIVACIDAD_HREF, TRASPASO, type FormLang } from '../../i18n/formularios';
import { useTranslations } from '../../i18n/utils';

interface Props { tipo: 'autonomo' | 'sl'; lang?: FormLang; }
const { tipo, lang = 'es' } = Astro.props;
const isAutonomo = tipo === 'autonomo';
const t = TRASPASO[lang];

const docsGestoriaAnterior = isAutonomo ? t.docsGestoriaAutonomo : t.docsGestoriaSl;
const docsCliente = isAutonomo ? t.docsClienteAutonomo : t.docsClienteSl;
const modelos = isAutonomo ? MODELOS_AUTONOMO : MODELOS_SL;
// Planes y precios de la web (ui.ts), para que no se desfasen.
const precios = useTranslations(lang).precios;
const planes = (isAutonomo ? precios.autonomoTiers : precios.pymeTiers).map((p) => ({ key: p.key, texto: `${p.name} · ${p.amount}${p.unit}` }));
---

<div id="view-traspaso-form">
  <div class="page view-intro">
    <p class="eyebrow">{t.eyebrow}</p>
    <h1 class="section-title">{isAutonomo ? t.titleAutonomo : t.titleSl}</h1>
    <p class="section-sub">{t.intro}</p>
    <p class="field-hint">{t.obligatorios}</p>
  </div>

  <form id="traspasoForm" class="alta-form page view-block" novalidate data-tipo={tipo} data-lang={lang} data-campos={JSON.stringify(CAMPOS[lang])} data-msg-campo={MSG_CAMPO[lang]}>
    {isAutonomo ? (
      <fieldset class="alta-section">
        <legend>{t.idDigital}</legend>
        <p class="field-hint">{t.idDigitalHint}</p>
        <div class="radio-group" data-field="identificacionDigital">
          <label class="radio-option"><input type="radio" name="identificacionDigital" value="certificado" /> {t.certificado}</label>
          <label class="radio-option"><input type="radio" name="identificacionDigital" value="clave_pin" /> {t.clavePin}</label>
          <label class="radio-option"><input type="radio" name="identificacionDigital" value="ninguno" /> {t.ninguno}</label>
        </div>
      </fieldset>
    ) : (
      <fieldset class="alta-section">
        <legend>{t.idDigitalSl}</legend>
        <p class="field-hint">{t.idDigitalSlHint}</p>
        <div class="radio-group" data-field="identificacionDigital">
          <label class="radio-option"><input type="radio" name="identificacionDigital" value="certificado" /> {t.certSlSi}</label>
          <label class="radio-option"><input type="radio" name="identificacionDigital" value="ninguno" /> {t.certSlNo}</label>
        </div>
        <p class="field-group-label">{t.administrador}</p>
        <label class="field">{t.adminNombre} <input type="text" id="fAdminNombre" maxlength="150" required /></label>
        <label class="field">{t.adminDni} <input type="text" id="fAdminDni" maxlength="9" required /></label>
      </fieldset>
    )}

    <fieldset class="alta-section">
      <legend>{t.basicos}</legend>
      <label class="field">{isAutonomo ? t.nombreAutonomo : t.nombreSl} <input type="text" id="fNombreRazonSocial" maxlength="150" required /></label>
      <label class="field">{isAutonomo ? t.nifAutonomo : t.nifSl} <input type="text" id="fNifCif" maxlength="9" required /></label>
      <label class="field">{t.email} <input type="email" id="fEmail" maxlength="254" required /></label>
      <label class="field">{t.telefono} <input type="tel" id="fTelefono" maxlength="20" required /></label>
      <label class="field">{t.domFiscal} <textarea id="fDomicilioFiscal" maxlength="300" rows="2" required></textarea></label>
      {!isAutonomo && (
        <label class="field">{t.domSocial} <span class="field-optional">{t.soloSiDistinto}</span>
          <textarea id="fDomicilioSocial" maxlength="300" rows="2"></textarea>
        </label>
      )}
      <label class="field">{t.domNotif} <span class="field-optional">{t.soloSiDistinto}</span>
        <textarea id="fDomicilioNotif" maxlength="300" rows="2"></textarea>
      </label>
      <label class="field">{t.ibanImpuestos} <input type="text" id="fIbanImpuestos" maxlength="34" required autocomplete="off" spellcheck="false" placeholder="ES0000000000000000000000" />
        <span class="field-hint">{t.ibanImpuestosHint}</span>
      </label>
    </fieldset>

    <fieldset class="alta-section">
      <legend>{t.situacion}</legend>
      <p class="field-hint">{t.situacionHint}</p>

      {isAutonomo && (
        <>
          <label class="field">{t.fechaAlta} <input type="date" id="fFechaAlta" required /></label>
          <label class="field">{t.epigrafes} <textarea id="fEpigrafes" maxlength="500" rows="2" required></textarea></label>
        </>
      )}

      <div class="field-group">
        <p class="field-group-label">{t.regimenIva}</p>
        <div class="radio-group" data-field="regimenIva">
          <label class="radio-option"><input type="radio" name="regimenIva" value="general" /> {t.ivaGeneral}</label>
          {isAutonomo && <label class="radio-option"><input type="radio" name="regimenIva" value="recargo_equivalencia" /> {t.ivaRecargo}</label>}
          {isAutonomo && <label class="radio-option"><input type="radio" name="regimenIva" value="simplificado" /> {t.ivaSimplificado}</label>}
          <label class="radio-option"><input type="radio" name="regimenIva" value="exento" /> {t.ivaExento}</label>
          <label class="radio-option"><input type="radio" name="regimenIva" value="otro" /> {t.ivaOtro}</label>
        </div>
        <input type="text" id="fRegimenIvaOtro" class="field-conditional-input" maxlength="100" placeholder={t.cual} hidden />
      </div>

      {isAutonomo ? (
        <>
          <div class="field-group">
            <p class="field-group-label">{t.regimenIrpf}</p>
            <div class="radio-group" data-field="regimenIrpf">
              <label class="radio-option"><input type="radio" name="regimenIrpf" value="directa_normal" /> {t.irpfNormal}</label>
              <label class="radio-option"><input type="radio" name="regimenIrpf" value="directa_simplificada" /> {t.irpfSimplificada}</label>
              <label class="radio-option"><input type="radio" name="regimenIrpf" value="modulos" /> {t.irpfModulos}</label>
            </div>
          </div>

          <label class="checkbox-option"><input type="checkbox" id="fFacturaRetencion" /> {t.facturaRetencion}</label>
          <label class="field" id="fPorcentajeRetencionWrap" hidden>{t.porcentaje} <input type="number" id="fPorcentajeRetencion" min="0" max="100" step="0.01" /></label>
        </>
      ) : (
        <>
          <div class="field-group">
            <p class="field-group-label">{t.sii}</p>
            <div class="radio-group" data-field="sii">
              <label class="radio-option"><input type="radio" name="sii" value="si" /> {t.si}</label>
              <label class="radio-option"><input type="radio" name="sii" value="no" /> {t.no}</label>
              <label class="radio-option"><input type="radio" name="sii" value="no_sabe" /> {t.noSe}</label>
            </div>
          </div>
        </>
      )}

      <label class="checkbox-option"><input type="checkbox" id="fTrabajadores" /> {isAutonomo ? t.trabajadoresAutonomo : t.trabajadoresSl}</label>
      <div id="fNumeroTrabajadoresWrap" hidden>
        <p class="field-hint">{t.trabajadoresHint}</p>
        <label class="field">{t.cuantos} <input type="number" id="fNumeroTrabajadores" min="1" step="1" /></label>
      </div>

      <label class="checkbox-option"><input type="checkbox" id="fIntracomunitarias" /> {t.intracom}</label>
    </fieldset>

    <fieldset class="alta-section">
      <legend>{t.continuidad}</legend>
      <div class="field-group">
        <p class="field-group-label">{t.quienLleva}</p>
        <div class="radio-group" data-field="quienLleva">
          <label class="radio-option"><input type="radio" name="quienLleva" value="gestoria" /> {t.llevaGestoria}</label>
          <label class="radio-option"><input type="radio" name="quienLleva" value="propia" /> {isAutonomo ? t.llevaYo : t.llevaSociedad}</label>
          <label class="radio-option"><input type="radio" name="quienLleva" value="empieza" /> {t.llevaEmpieza}</label>
        </div>
      </div>

      <div id="bloqueGestoria" hidden>
        <label class="field">{t.contactoGestoria} <span class="field-optional">{t.contactoGestoriaHint}</span>
          <textarea id="fContactoGestoria" maxlength="300" rows="2"></textarea>
        </label>

        <div class="field-group">
          <p class="field-group-label">{t.modelos}</p>
          <p class="field-hint">{t.modelosHint}</p>
          <div class="radio-group modelos" data-field="modelos">
            {modelos.map((m) => <label class="checkbox-option"><input type="checkbox" name="modelos" value={m} /> {m}</label>)}
            <label class="checkbox-option"><input type="checkbox" name="modelos" value="no_sabe" /> {t.noSe}</label>
          </div>
        </div>

        <div class="field-group">
          <p class="field-group-label">{t.docsGestoriaTitulo}</p>
          <ul class="plain-list">
            {docsGestoriaAnterior.map((d) => <li>{d}</li>)}
          </ul>
          <p class="field-hint">{t.docsGestoriaHint}</p>
        </div>

        <label class="checkbox-option">
          <input type="checkbox" id="fAutorizaHistorico" />
          {t.autoriza}
        </label>
      </div>

      <label class="checkbox-option"><input type="checkbox" id="fRequerimientos" /> {t.requerimientos}</label>
      <label class="field" id="fDetalleRequerimientosWrap" hidden>{t.requerimientosDetalle} <textarea id="fDetalleRequerimientos" maxlength="500" rows="2"></textarea></label>

      <div class="field-group">
        <p class="field-group-label">{t.docsClienteTitulo}</p>
        <ul class="plain-list">
          {docsCliente.map((d) => <li>{d}</li>)}
        </ul>
        <p class="field-hint">{t.docsClienteHint}</p>
      </div>
    </fieldset>

    <fieldset class="alta-section">
      <legend>{t.planTitulo}</legend>
      <div class="field-group">
        <p class="field-group-label">{t.plan}</p>
        <div class="radio-group" data-field="plan">
          {planes.map((p) => <label class="radio-option"><input type="radio" name="plan" value={p.key} /> {p.texto}</label>)}
          <label class="radio-option"><input type="radio" name="plan" value="no_sabe" /> {t.planNoSe}</label>
        </div>
      </div>
      <div class="field-group">
        <p class="field-group-label">{t.facturacion}</p>
        <p class="field-hint">{isAutonomo ? t.facturacionHintAutonomo : t.facturacionHintSl}</p>
        <div class="radio-group" data-field="programaFacturacion">
          <label class="radio-option"><input type="radio" name="programaFacturacion" value="si" /> {t.facturacionSi}</label>
          <label class="radio-option"><input type="radio" name="programaFacturacion" value="no" /> {t.facturacionNo}</label>
          <label class="radio-option"><input type="radio" name="programaFacturacion" value="no_sabe" /> {t.facturacionNoSe}</label>
        </div>
      </div>
      <p class="field-hint">{t.mandatoHint}</p>
    </fieldset>

    <fieldset class="alta-section">
      <legend>{t.recuerda}</legend>
      <p class="field-hint">{t.recuerdaHint}</p>
      <ul class="doc-list">
        <li>
          <a href="https://suslwmgqdzingeqhfrpw.supabase.co/storage/v1/object/public/docs-publicos/Pasos_Apoderamiento_Seguridad_Social.pdf" target="_blank" rel="noopener">
            {t.guiaSS}
          </a>
        </li>
        <li>
          <a href="https://suslwmgqdzingeqhfrpw.supabase.co/storage/v1/object/public/docs-publicos/Pasos_Apoderamiento_AEAT.pdf" target="_blank" rel="noopener">
            {t.guiaAeat}
          </a>
        </li>
      </ul>
      <p class="field-hint">
        {t.rgpdHint}
        <a href="https://suslwmgqdzingeqhfrpw.supabase.co/storage/v1/object/public/docs-publicos/RGPD.pdf" target="_blank" rel="noopener">{t.rgpdLink}</a>.
      </p>
    </fieldset>

    <label class="consent">
      <input type="checkbox" id="fPrivacy" required />
      <span>{t.privacyPre} <a href={PRIVACIDAD_HREF[lang]} target="_blank" rel="noopener">{t.privacyLink}</a> {t.privacyPost}</span>
    </label>

    <p class="form-error" id="formError" hidden>{t.error}</p>

    <button type="submit" class="btn btn-primary form-submit" id="formSubmit">{t.enviar}</button>
  </form>

  <div class="page view-block form-success" id="formSuccess" hidden>
    <p class="eyebrow">{t.recibido}</p>
    <h2 class="section-title">{t.gracias}</h2>
    <p class="section-sub">{t.graciasSub}</p>
  </div>
</div>

<script>
  import { track } from '../../scripts/analytics';
  import { limpiarIban, ibanValido } from '../../lib/iban';

  (function () {
    const form = document.getElementById('traspasoForm') as HTMLFormElement | null;
    if (!form) return;

    const tipo = form.dataset.tipo === 'sl' ? 'sl' : 'autonomo';
    const isAutonomo = tipo === 'autonomo';

    const success = document.getElementById('formSuccess') as HTMLElement;
    const errorEl = document.getElementById('formError') as HTMLElement;
    const submitBtn = document.getElementById('formSubmit') as HTMLButtonElement;

    function el<T extends HTMLElement>(id: string): T | null {
      return document.getElementById(id) as T | null;
    }
    const valor = (id: string) => (el<HTMLInputElement | HTMLTextAreaElement>(id)?.value ?? '').trim();

    // El enlace de este formulario lo manda n8n (Onboarding) con el NIF/CIF del cliente
    // (?nif=...), que es el id de su fila en `clientes`. Se precarga y queda de solo lectura
    // para que el envío no se desvincule de su ficha. El correo también viaja en el enlace.
    const params = new URLSearchParams(window.location.search);
    const nifParam = params.get('nif');
    const nifCifInput = el<HTMLInputElement>('fNifCif');
    if (nifParam && nifCifInput && /^[0-9A-Za-z][0-9]{7}[0-9A-Za-z]$/.test(nifParam.trim())) {
      nifCifInput.value = nifParam.trim().toUpperCase();
      nifCifInput.readOnly = true;
    }
    const emailParam = params.get('email');
    const emailInput = el<HTMLInputElement>('fEmail');
    if (emailParam && emailInput) emailInput.value = emailParam.trim().toLowerCase();

    // Si el servidor dice qué campo no valida (`field`), el aviso lo nombra.
    const CAMPOS: Record<string, string> = JSON.parse(form.dataset.campos || '{}');
    const MSG_CAMPO = form.dataset.msgCampo || '';
    const MENSAJE_GENERICO = errorEl.textContent;
    function avisar(campo: string) {
      errorEl.textContent = campo && CAMPOS[campo] ? MSG_CAMPO.replace('{campo}', CAMPOS[campo]) : MENSAJE_GENERICO;
      errorEl.hidden = false;
    }
    async function mostrarError(res: Response | null) {
      let campo = '';
      try { campo = (await res?.json())?.field ?? ''; } catch { /* sin detalle */ }
      avisar(campo);
    }

    function radioValue(name: string): string | undefined {
      return form?.querySelector<HTMLInputElement>(`[name="${name}"]:checked`)?.value;
    }

    // Muestra u oculta un bloque según una casilla o un radio, y vacía lo oculto.
    function alternar(disparadores: NodeListOf<HTMLInputElement> | HTMLInputElement[], bloque: HTMLElement | null, visible: () => boolean) {
      const aplicar = () => {
        if (!bloque) return;
        bloque.hidden = !visible();
        if (bloque.hidden) bloque.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea').forEach((x) => {
          if (x instanceof HTMLInputElement && (x.type === 'checkbox' || x.type === 'radio')) x.checked = false; else x.value = '';
        });
      };
      disparadores.forEach((d) => d.addEventListener('change', aplicar));
    }
    const radios = (name: string) => form.querySelectorAll<HTMLInputElement>(`[name="${name}"]`);

    // La cuenta se guarda sin espacios y en mayúsculas: se limpia mientras se escribe o se pega.
    const ibanInput = el<HTMLInputElement>('fIbanImpuestos');
    ibanInput?.addEventListener('input', () => {
      const limpio = limpiarIban(ibanInput.value);
      if (limpio !== ibanInput.value) ibanInput.value = limpio;
    });
    const casilla = (id: string) => [el<HTMLInputElement>(id)!].filter(Boolean);

    alternar(radios('regimenIva'), el('fRegimenIvaOtro'), () => radioValue('regimenIva') === 'otro');
    alternar(casilla('fFacturaRetencion'), el('fPorcentajeRetencionWrap'), () => !!el<HTMLInputElement>('fFacturaRetencion')?.checked);
    alternar(casilla('fTrabajadores'), el('fNumeroTrabajadoresWrap'), () => !!el<HTMLInputElement>('fTrabajadores')?.checked);
    alternar(casilla('fRequerimientos'), el('fDetalleRequerimientosWrap'), () => !!el<HTMLInputElement>('fRequerimientos')?.checked);
    alternar(radios('quienLleva'), el('bloqueGestoria'), () => radioValue('quienLleva') === 'gestoria');
    // «No lo sé» en los modelos excluye marcar modelos concretos, y al revés.
    const casillasModelos = [...radios('modelos')];
    casillasModelos.forEach((c) => c.addEventListener('change', () => {
      if (!c.checked) return;
      casillasModelos.forEach((x) => { if (x !== c && (x.value === 'no_sabe') !== (c.value === 'no_sabe')) x.checked = false; });
    }));

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      errorEl.hidden = true;
      // Antes de enviar: el IBAN tiene que existir (dígito de control), para no domiciliar en una cuenta mal escrita.
      if (!ibanValido(valor('fIbanImpuestos'))) { avisar('ibanImpuestos'); ibanInput?.focus(); return; }

      const conGestoria = radioValue('quienLleva') === 'gestoria';
      const body: Record<string, unknown> = {
        tipo,
        identificacionDigital: radioValue('identificacionDigital'),
        nombreRazonSocial: valor('fNombreRazonSocial'),
        nifCif: valor('fNifCif'),
        email: valor('fEmail'),
        telefono: valor('fTelefono'),
        domicilioFiscal: valor('fDomicilioFiscal'),
        ibanImpuestos: limpiarIban(valor('fIbanImpuestos')),
        regimenIvaActual: radioValue('regimenIva') === 'otro' ? (valor('fRegimenIvaOtro') || 'otro') : radioValue('regimenIva'),
        tieneTrabajadores: !!el<HTMLInputElement>('fTrabajadores')?.checked,
        operacionesIntracomunitarias: !!el<HTMLInputElement>('fIntracomunitarias')?.checked,
        quienLleva: radioValue('quienLleva'),
        tieneRequerimientosAeat: !!el<HTMLInputElement>('fRequerimientos')?.checked,
        plan: radioValue('plan'),
        programaFacturacion: radioValue('programaFacturacion'),
        privacyAccepted: !!el<HTMLInputElement>('fPrivacy')?.checked,
        idioma: form.dataset.lang,
      };
      if (valor('fDomicilioNotif')) body.domicilioNotificaciones = valor('fDomicilioNotif');

      if (isAutonomo) {
        body.fechaAltaActividad = valor('fFechaAlta');
        body.epigrafesIaeActuales = valor('fEpigrafes');
        body.regimenIrpfActual = radioValue('regimenIrpf');
        body.facturaConRetencion = !!el<HTMLInputElement>('fFacturaRetencion')?.checked;
        if (body.facturaConRetencion) body.porcentajeRetencion = valor('fPorcentajeRetencion') === '' ? undefined : Number(valor('fPorcentajeRetencion'));
      } else {
        body.adminNombre = valor('fAdminNombre');
        body.adminDni = valor('fAdminDni').toUpperCase();
        if (valor('fDomicilioSocial')) body.domicilioSocial = valor('fDomicilioSocial');
        body.sii = radioValue('sii');
      }

      if (body.tieneTrabajadores) body.numeroTrabajadores = valor('fNumeroTrabajadores') === '' ? undefined : Number(valor('fNumeroTrabajadores'));

      if (conGestoria) {
        body.contactoGestoriaAnterior = valor('fContactoGestoria');
        body.autorizaSolicitarHistorico = !!el<HTMLInputElement>('fAutorizaHistorico')?.checked;
        body.modelos = casillasModelos.filter((c) => c.checked).map((c) => c.value);
      }

      if (body.tieneRequerimientosAeat) body.detalleRequerimientosAeat = valor('fDetalleRequerimientos');

      submitBtn.disabled = true;
      try {
        const res = await fetch('/api/traspaso', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        if (!res.ok) { await mostrarError(res); submitBtn.disabled = false; return; }
        track('formulario_enviado', { tipo: 'traspaso', variante: tipo });
        form.hidden = true;
        success.hidden = false;
        window.scrollTo({ top: 0 });
      } catch (err) {
        errorEl.hidden = false;
        submitBtn.disabled = false;
      }
    });
  })();
</script>

<style>
  .plain-list { list-style: disc; padding-left: 1.3rem; display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.88rem; color: var(--ink); }
  .modelos { flex-direction: row; flex-wrap: wrap; gap: 0.4rem 1.2rem; }
  #bloqueGestoria { display: flex; flex-direction: column; gap: inherit; }
  #bloqueGestoria[hidden] { display: none; }
  .field-conditional-input {
    margin-top: 0.6rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    padding: 0.65rem 0.85rem;
    border: 1.5px solid var(--line);
    border-radius: 10px;
    background: var(--paper-raised);
    color: var(--ink);
    max-width: 300px;
  }
</style>
