---
// Mismo criterio que FormularioAlta.astro (formulario largo tradicional,
// sin enlazar desde el menú, en castellano e inglés con los textos en
// src/i18n/formularios.ts) — ver comentarios ahí.
//
// Un solo componente para los dos tipos (en vez de duplicar el formulario
// entero): el prop `tipo` decide qué etiquetas y qué secciones de
// "situación fiscal actual" se muestran, pero la estructura y el resto de
// campos son los mismos. Las páginas (formulario-traspaso-autonomo y
// formulario-traspaso-sl, y sus versiones /en/) son solo un wrapper de una
// línea con el `tipo` y el idioma — ver schema.sql (tabla traspasos_nuevos)
// para el porqué de compartir tabla también.
import { CAMPOS, COMUNES, MSG_CAMPO, PRIVACIDAD_HREF, TRASPASO, type FormLang } from '../../i18n/formularios';

interface Props { tipo: 'autonomo' | 'sl'; lang?: FormLang; }
const { tipo, lang = 'es' } = Astro.props;
const isAutonomo = tipo === 'autonomo';
const t = { ...COMUNES[lang], ...TRASPASO[lang] };

const nombreLabel = isAutonomo ? t.nombreAutonomo : t.nombreSl;
const nifLabel = isAutonomo ? t.nifAutonomo : t.nifSl;

// Documentación: listas informativas, no campos del formulario (no hay
// subida de archivos montada — ver comentario en schema.sql). El equipo
// hace el seguimiento real de estos documentos por email/Drive.
const docsGestoriaAnterior = isAutonomo ? t.docsGestoriaAutonomo : t.docsGestoriaSl;
const docsCliente = isAutonomo ? t.docsClienteAutonomo : t.docsClienteSl;
---

<div id="view-traspaso-form">
  <div class="page view-intro">
    <p class="eyebrow">{t.eyebrow}</p>
    <h2 class="section-title">{isAutonomo ? t.titleAutonomo : t.titleSl}</h2>
    <p class="section-sub">{t.intro}</p>
    <p class="field-hint">{t.obligatorios}</p>
  </div>

  <form id="traspasoForm" class="alta-form page view-block" novalidate data-tipo={tipo} data-lang={lang} data-campos={JSON.stringify(CAMPOS[lang])} data-msg-campo={MSG_CAMPO[lang]}>
    <fieldset class="alta-section">
      <legend>{t.idDigital}</legend>
      <p class="field-hint">{t.idDigitalHint}</p>
      <div class="radio-group" data-field="identificacionDigital">
        <label class="radio-option"><input type="radio" name="identificacionDigital" value="certificado" /> {t.certificado}</label>
        <label class="radio-option"><input type="radio" name="identificacionDigital" value="clave_pin" /> {t.clavePin}</label>
        <label class="radio-option"><input type="radio" name="identificacionDigital" value="ninguno" /> {t.ninguno}</label>
      </div>
    </fieldset>

    <fieldset class="alta-section">
      <legend>{t.basicos}</legend>
      <label class="field">{nombreLabel} * <input type="text" id="fNombreRazonSocial" maxlength="150" required /></label>
      <label class="field">{nifLabel} * <input type="text" id="fNifCif" maxlength="9" required /></label>
      <label class="field">{t.email} <input type="email" id="fEmail" maxlength="254" required /></label>
      <label class="field">{t.telefono} <input type="tel" id="fTelefono" maxlength="20" required /></label>
      <label class="field">{t.domFiscal} <textarea id="fDomicilioFiscal" maxlength="300" rows="2" required></textarea></label>
      {!isAutonomo && (
        <label class="field">{t.domSocial} <textarea id="fDomicilioSocial" maxlength="300" rows="2" required></textarea></label>
      )}
      <label class="field">{t.domNotif} <span class="field-optional">{t.soloSiDistinto}</span>
        <textarea id="fDomicilioNotif" maxlength="300" rows="2"></textarea>
      </label>
      <label class="field">{t.iban} <input type="text" id="fIban" maxlength="34" placeholder="ES00 0000 0000 0000 0000 0000" required /></label>
    </fieldset>

    <fieldset class="alta-section">
      <legend>{t.situacion}</legend>
      <p class="field-hint">{t.situacionHint}</p>

      {isAutonomo && (
        <>
          <label class="field">{t.fechaAlta} <input type="date" id="fFechaAlta" required /></label>
          <label class="field">{t.epigrafes} <textarea id="fEpigrafes" maxlength="500" rows="2" required></textarea></label>

          <div class="field-group">
            <p class="field-group-label">{t.regimenIva}</p>
            <div class="radio-group" data-field="regimenIva">
              <label class="radio-option"><input type="radio" name="regimenIva" value="general" /> {t.ivaGeneral}</label>
              <label class="radio-option"><input type="radio" name="regimenIva" value="recargo_equivalencia" /> {t.ivaRecargo}</label>
              <label class="radio-option"><input type="radio" name="regimenIva" value="simplificado" /> {t.ivaSimplificado}</label>
              <label class="radio-option"><input type="radio" name="regimenIva" value="exento" /> {t.ivaExento}</label>
              <label class="radio-option"><input type="radio" name="regimenIva" value="otro" /> {t.ivaOtro}</label>
            </div>
            <input type="text" id="fRegimenIvaOtro" class="field-conditional-input" maxlength="100" placeholder={t.cual} hidden />
          </div>

          <div class="field-group">
            <p class="field-group-label">{t.regimenIrpf}</p>
            <div class="radio-group" data-field="regimenIrpf">
              <label class="radio-option"><input type="radio" name="regimenIrpf" value="directa_normal" /> {t.irpfNormal}</label>
              <label class="radio-option"><input type="radio" name="regimenIrpf" value="directa_simplificada" /> {t.irpfSimplificada}</label>
              <label class="radio-option"><input type="radio" name="regimenIrpf" value="modulos" /> {t.irpfModulos}</label>
            </div>
          </div>

          <label class="checkbox-option"><input type="checkbox" id="fFacturaRetencion" /> {t.facturaRetencion}</label>
          <label class="field" id="fPorcentajeRetencionWrap" hidden>{t.porcentaje} <input type="number" id="fPorcentajeRetencion" min="0" max="100" step="0.01" /></label>
        </>
      )}

      <label class="checkbox-option"><input type="checkbox" id="fTrabajadores" /> {t.trabajadores}</label>
      <label class="field" id="fNumeroTrabajadoresWrap" hidden>{t.cuantos} <input type="number" id="fNumeroTrabajadores" min="1" step="1" /></label>

      <label class="checkbox-option"><input type="checkbox" id="fIntracomunitarias" /> {t.intracom}</label>
    </fieldset>

    <fieldset class="alta-section">
      <legend>{t.continuidad}</legend>
      <label class="checkbox-option"><input type="checkbox" id="fRequerimientos" /> {t.requerimientos}</label>
      <label class="field" id="fDetalleRequerimientosWrap" hidden>{t.requerimientosDetalle} <textarea id="fDetalleRequerimientos" maxlength="500" rows="2"></textarea></label>

      <label class="field">{t.contactoGestoria} <span class="field-optional">{t.contactoGestoriaHint}</span>
        <textarea id="fContactoGestoria" maxlength="300" rows="2" required></textarea>
      </label>

      <div class="field-group">
        <p class="field-group-label">{t.docsGestoriaTitulo}</p>
        <ul class="plain-list">
          {docsGestoriaAnterior.map((d) => <li>{d}</li>)}
        </ul>
        <p class="field-hint">{t.docsGestoriaHint}</p>
      </div>

      <label class="checkbox-option">
        <input type="checkbox" id="fAutorizaHistorico" required />
        {t.autoriza}
      </label>

      <div class="field-group">
        <p class="field-group-label">{t.docsClienteTitulo}</p>
        <ul class="plain-list">
          {docsCliente.map((d) => <li>{d}</li>)}
        </ul>
        <p class="field-hint">{t.docsClienteHint}</p>
      </div>
    </fieldset>

    <fieldset class="alta-section">
      <legend>{t.recuerda}</legend>
      <p class="field-hint">{t.recuerdaHint}</p>
      <ul class="doc-list">
        <li>
          <a href="https://suslwmgqdzingeqhfrpw.supabase.co/storage/v1/object/public/docs-publicos/Pasos_Apoderamiento_Seguridad_Social.pdf" target="_blank" rel="noopener">
            {t.guiaSS}
          </a>
        </li>
        <li>
          <a href="https://suslwmgqdzingeqhfrpw.supabase.co/storage/v1/object/public/docs-publicos/Pasos_Apoderamiento_AEAT.pdf" target="_blank" rel="noopener">
            {t.guiaAeat}
          </a>
        </li>
      </ul>
      <p class="field-hint">
        {t.rgpdHint}
        <a href="https://suslwmgqdzingeqhfrpw.supabase.co/storage/v1/object/public/docs-publicos/RGPD.pdf" target="_blank" rel="noopener">{t.rgpdLink}</a>.
      </p>
    </fieldset>

    <label class="consent">
      <input type="checkbox" id="fPrivacy" required />
      <span>{t.privacyPre} <a href={PRIVACIDAD_HREF[lang]} target="_blank" rel="noopener">{t.privacyLink}</a> {t.privacyPost}</span>
    </label>

    <p class="form-error" id="formError" hidden>{t.error}</p>

    <button type="submit" class="btn btn-primary form-submit" id="formSubmit">{t.enviar}</button>
  </form>

  <div class="page view-block form-success" id="formSuccess" hidden>
    <p class="eyebrow">{t.recibido}</p>
    <h2 class="section-title">{t.gracias}</h2>
    <p class="section-sub">{t.graciasSub}</p>
  </div>
</div>

<script>
  import { track } from '../../scripts/analytics';

  (function () {
    const form = document.getElementById('traspasoForm') as HTMLFormElement | null;
    if (!form) return;

    const tipo = form.dataset.tipo === 'sl' ? 'sl' : 'autonomo';
    const isAutonomo = tipo === 'autonomo';

    const success = document.getElementById('formSuccess') as HTMLElement;
    const errorEl = document.getElementById('formError') as HTMLElement;
    const submitBtn = document.getElementById('formSubmit') as HTMLButtonElement;

    function el<T extends HTMLElement>(id: string): T | null {
      return document.getElementById(id) as T | null;
    }

    // El link de este formulario se manda ya personalizado con el NIF/CIF
    // del cliente (?nif=..., añadido por el workflow de n8n al enviarlo),
    // que es el mismo id con el que se creó su fila en `clientes`. Se
    // precarga en el campo NIF/CIF que ya existía y se deja de solo
    // lectura para que no pueda desincronizarse del cliente al que está
    // vinculado el envío.
    const nifParam = new URLSearchParams(window.location.search).get('nif');
    const nifCifInput = el<HTMLInputElement>('fNifCif');
    if (nifParam && nifCifInput) {
      nifCifInput.value = nifParam;
      nifCifInput.readOnly = true;
    }
    // El email con el que damos de alta al cliente también viaja en el enlace (?email=).
    const emailParam = new URLSearchParams(window.location.search).get('email');
    const emailInput = el<HTMLInputElement>('fEmail');
    if (emailParam && emailInput) emailInput.value = emailParam;

    // Si el servidor dice qué campo no valida (`field`), el aviso lo nombra.
    // Nombres de campo y plantilla del aviso en el idioma de la página
    // (src/i18n/formularios.ts), pasados como data-* del formulario.
    const CAMPOS: Record<string, string> = JSON.parse(form.dataset.campos || '{}');
    const MSG_CAMPO = form.dataset.msgCampo || '';
    const MENSAJE_GENERICO = errorEl.textContent;
    async function mostrarError(res: Response | null) {
      let campo = '';
      try { campo = (await res?.json())?.field ?? ''; } catch { /* sin detalle */ }
      errorEl.textContent = campo && CAMPOS[campo]
        ? MSG_CAMPO.replace('{campo}', CAMPOS[campo])
        : MENSAJE_GENERICO;
      errorEl.hidden = false;
    }

    function radioValue(name: string): string | undefined {
      const checked = form?.querySelector<HTMLInputElement>(`[name="${name}"]:checked`);
      return checked?.value;
    }

    const regimenIvaOtro = el<HTMLInputElement>('fRegimenIvaOtro');
    form.querySelectorAll<HTMLInputElement>('[name="regimenIva"]').forEach(function (radio) {
      radio.addEventListener('change', function () {
        if (regimenIvaOtro) regimenIvaOtro.hidden = radio.value !== 'otro' || !radio.checked;
      });
    });

    const facturaRetencion = el<HTMLInputElement>('fFacturaRetencion');
    const porcentajeWrap = el<HTMLElement>('fPorcentajeRetencionWrap');
    const porcentajeInput = el<HTMLInputElement>('fPorcentajeRetencion');
    facturaRetencion?.addEventListener('change', function () {
      if (porcentajeWrap) porcentajeWrap.hidden = !facturaRetencion.checked;
      if (!facturaRetencion.checked && porcentajeInput) porcentajeInput.value = '';
    });

    const trabajadores = el<HTMLInputElement>('fTrabajadores');
    const numTrabajadoresWrap = el<HTMLElement>('fNumeroTrabajadoresWrap');
    const numTrabajadoresInput = el<HTMLInputElement>('fNumeroTrabajadores');
    trabajadores?.addEventListener('change', function () {
      if (numTrabajadoresWrap) numTrabajadoresWrap.hidden = !trabajadores.checked;
      if (!trabajadores.checked && numTrabajadoresInput) numTrabajadoresInput.value = '';
    });

    const requerimientos = el<HTMLInputElement>('fRequerimientos');
    const detalleWrap = el<HTMLElement>('fDetalleRequerimientosWrap');
    const detalleInput = el<HTMLTextAreaElement>('fDetalleRequerimientos');
    requerimientos?.addEventListener('change', function () {
      if (detalleWrap) detalleWrap.hidden = !requerimientos.checked;
      if (!requerimientos.checked && detalleInput) detalleInput.value = '';
    });

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      errorEl.hidden = true;

      const identificacionDigital = radioValue('identificacionDigital');
      const regimenIva = isAutonomo ? radioValue('regimenIva') : undefined;
      const regimenIrpf = isAutonomo ? radioValue('regimenIrpf') : undefined;

      if (!identificacionDigital || (isAutonomo && (!regimenIva || !regimenIrpf))) {
        errorEl.hidden = false;
        return;
      }

      const body: Record<string, unknown> = {
        tipo,
        identificacionDigital,
        nombreRazonSocial: el<HTMLInputElement>('fNombreRazonSocial')!.value.trim(),
        nifCif: el<HTMLInputElement>('fNifCif')!.value.trim(),
        email: el<HTMLInputElement>('fEmail')!.value.trim(),
        telefono: el<HTMLInputElement>('fTelefono')!.value.trim(),
        domicilioFiscal: el<HTMLTextAreaElement>('fDomicilioFiscal')!.value.trim(),
        iban: el<HTMLInputElement>('fIban')!.value.trim(),
        tieneTrabajadores: !!trabajadores?.checked,
        operacionesIntracomunitarias: !!el<HTMLInputElement>('fIntracomunitarias')?.checked,
        tieneRequerimientosAeat: !!requerimientos?.checked,
        contactoGestoriaAnterior: el<HTMLTextAreaElement>('fContactoGestoria')!.value.trim(),
        autorizaSolicitarHistorico: !!el<HTMLInputElement>('fAutorizaHistorico')?.checked,
        privacyAccepted: !!el<HTMLInputElement>('fPrivacy')?.checked,
        idioma: form.dataset.lang,
      };

      const domicilioNotif = el<HTMLTextAreaElement>('fDomicilioNotif')?.value.trim();
      if (domicilioNotif) body.domicilioNotificaciones = domicilioNotif;

      if (!isAutonomo) {
        body.domicilioSocial = el<HTMLTextAreaElement>('fDomicilioSocial')!.value.trim();
      }

      if (isAutonomo) {
        body.fechaAltaActividad = el<HTMLInputElement>('fFechaAlta')!.value;
        body.epigrafesIaeActuales = el<HTMLTextAreaElement>('fEpigrafes')!.value.trim();
        body.regimenIvaActual = regimenIva === 'otro' ? (regimenIvaOtro?.value.trim() || 'otro') : regimenIva;
        body.regimenIrpfActual = regimenIrpf;
        body.facturaConRetencion = !!facturaRetencion?.checked;
        if (facturaRetencion?.checked && porcentajeInput?.value) {
          body.porcentajeRetencion = Number(porcentajeInput.value);
        }
      }

      if (trabajadores?.checked && numTrabajadoresInput?.value) {
        body.numeroTrabajadores = Number(numTrabajadoresInput.value);
      }

      if (requerimientos?.checked) {
        const detalle = detalleInput?.value.trim();
        if (detalle) body.detalleRequerimientosAeat = detalle;
      }

      submitBtn.disabled = true;
      try {
        const res = await fetch('/api/traspaso', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        if (!res.ok) { await mostrarError(res); submitBtn.disabled = false; return; }
        track('formulario_enviado', { tipo: 'traspaso', variante: tipo });
        form.hidden = true;
        success.hidden = false;
      } catch (err) {
        errorEl.hidden = false;
        submitBtn.disabled = false;
      }
    });
  })();
</script>

<style>
  .plain-list { list-style: disc; padding-left: 1.3rem; display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.88rem; color: var(--ink); }
  .field-conditional-input {
    margin-top: 0.6rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    padding: 0.65rem 0.85rem;
    border: 1.5px solid var(--line);
    border-radius: 10px;
    background: var(--paper-raised);
    color: var(--ink);
    max-width: 300px;
  }
</style>
