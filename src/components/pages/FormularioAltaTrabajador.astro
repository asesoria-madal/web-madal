---
// Formulario "alta de trabajador" (2026-11-02). Lo rellena NUESTRO cliente (la
// empresa o el autónomo que contrata), no el trabajador: es el cliente quien le
// pide los datos a su trabajador y nos los pasa, igual que si se los pidiéramos
// por correo. Sirve solo para tener en un sitio todos los datos con los que
// tramitamos el alta en la Seguridad Social, el contrato y la nómina.
//
// Mismo criterio que FormularioAlta.astro: una sola página larga por secciones,
// sin enlazar desde el menú (noindex) y mandada por enlace directo, con
// ?nif=<NIF de la empresa>&email=<email del cliente> para precargar la empresa.
//
// Existe en castellano, catalán e inglés (/formulario-alta-trabajador,
// /ca/..., /en/...); los textos viven en src/i18n/formularioTrabajador.ts. Lo
// que se envía al servidor es igual en los tres idiomas.
//
// No sube archivos (como los otros formularios): la copia del DNI/NIE, el
// permiso de trabajo o el certificado de discapacidad se piden por correo y se
// guardan en Drive. Lo que es decisión técnica de la gestoría (grupo de
// cotización, CNO, convenio, bonificaciones) se pregunta como opcional, "si lo
// sabes": si no, lo decide Edurne.
import { TRABAJADOR, type TrabajadorLang } from '../../i18n/formularioTrabajador';

interface Props { lang?: TrabajadorLang; }
const { lang = 'es' } = Astro.props;
const t = TRABAJADOR[lang];
const EMAIL_CONTACTO = 'contacto@asesoriamadal.es';
---

<div id="view-trabajador-form">
  <div class="page view-intro">
    <p class="eyebrow">{t.eyebrow}</p>
    <h1 class="section-title">{t.title}</h1>
    <p class="section-sub">{t.intro}</p>
    <p class="field-hint">{t.plazoPre} <strong>{t.plazoStrong}</strong> {t.plazoPost}</p>
    <p class="field-hint">{t.obligatorios}</p>
  </div>

  <form
    id="trabajadorForm"
    class="alta-form page view-block"
    novalidate
    data-campos={JSON.stringify(t.campos)}
    data-msg-campo={t.msgCampo}
    data-fin-sustitucion={t.fechaFinSustitucion}
    data-distribucion-parcial={t.distribucionHintParcial}
  >
    <fieldset class="alta-section">
      <legend>{t.secEmpresa}</legend>
      <label class="field">{t.empNombre} <input type="text" id="fEmpNombre" maxlength="150" required /></label>
      <label class="field">{t.empNif} <input type="text" id="fEmpNif" maxlength="9" required /></label>
      <label class="field">{t.empEmail} <input type="email" id="fEmpEmail" maxlength="254" required /></label>
      <label class="field">{t.ccc} <span class="field-optional">{t.cccHint}</span>
        <input type="text" id="fCcc" maxlength="20" />
      </label>
      <label class="field">{t.centro} <textarea id="fCentro" maxlength="300" rows="2" required></textarea></label>
      <label class="field">{t.convenio} <span class="field-optional">{t.convenioHint}</span>
        <input type="text" id="fConvenio" maxlength="200" />
      </label>
    </fieldset>

    <fieldset class="alta-section">
      <legend>{t.secTrabajador}</legend>
      <label class="field">{t.nombre} <input type="text" id="fNombre" maxlength="150" required /></label>
      <label class="field">{t.nif} <input type="text" id="fNif" maxlength="9" placeholder="12345678A" required /></label>
      <label class="field">{t.fechaNac} <input type="date" id="fFechaNacimiento" required /></label>
      <div class="field-group">
        <p class="field-group-label">{t.sexo}</p>
        <div class="radio-group" data-field="sexo">
          <label class="radio-option"><input type="radio" name="sexo" value="mujer" /> {t.mujer}</label>
          <label class="radio-option"><input type="radio" name="sexo" value="hombre" /> {t.hombre}</label>
        </div>
      </div>
      <label class="field">{t.nacionalidad} <input type="text" id="fNacionalidad" maxlength="60" required /></label>
      <label class="field">{t.domicilio} <textarea id="fDomicilio" maxlength="300" rows="2" required></textarea></label>
      <label class="field">{t.telefono} <input type="tel" id="fTelefono" maxlength="20" required /></label>
      <label class="field">{t.email} <span class="field-optional">{t.emailHint}</span>
        <input type="email" id="fEmail" maxlength="254" required />
      </label>

      <label class="field" id="fNussWrap">{t.nuss} <span class="field-optional">{t.nussHint}</span>
        <input type="text" id="fNuss" maxlength="20" inputmode="numeric" />
      </label>
      <label class="checkbox-option"><input type="checkbox" id="fSinNuss" /> {t.sinNuss}</label>

      <label class="checkbox-option"><input type="checkbox" id="fExtracomunitario" /> {t.extracom}</label>
      <label class="field" id="fVigenciaWrap" hidden>{t.vigencia} <input type="date" id="fVigencia" /></label>

      <label class="field">{t.iban} <input type="text" id="fIban" maxlength="34" placeholder="ES00 0000 0000 0000 0000 0000" required /></label>

      <label class="field">{t.estudios}
        <select id="fNivelEstudios" required>
          <option value="">{t.estudiosElige}</option>
          {Object.entries(t.estudiosOpts).map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
      </label>
      <label class="field">{t.titulacion} <span class="field-optional">{t.titulacionHint}</span>
        <input type="text" id="fTitulacion" maxlength="150" />
      </label>

      <label class="checkbox-option"><input type="checkbox" id="fDiscapacidad" /> {t.discapacidad}</label>
      <label class="field" id="fGradoWrap" hidden>{t.grado} <input type="number" id="fGrado" min="33" max="100" step="1" /></label>
    </fieldset>

    <fieldset class="alta-section">
      <legend>{t.sec145}</legend>
      <p class="field-hint">{t.hint145}</p>
      <div class="radio-group" data-field="datos145">
        <label class="radio-option"><input type="radio" name="datos145" value="facilita" /> {t.facilita}</label>
        <label class="radio-option"><input type="radio" name="datos145" value="no_facilita" /> {t.noFacilita}</label>
      </div>

      <div id="f145Wrap" class="field-group" hidden>
        <p class="field-group-label">{t.situacion}</p>
        <div class="radio-group" data-field="situacionFamiliar">
          <label class="radio-option"><input type="radio" name="situacionFamiliar" value="1" /> {t.sit1}</label>
          <label class="radio-option"><input type="radio" name="situacionFamiliar" value="2" /> {t.sit2}</label>
          <label class="radio-option"><input type="radio" name="situacionFamiliar" value="3" /> {t.sit3}</label>
        </div>

        <label class="checkbox-option"><input type="checkbox" id="fDescendientes" /> {t.descendientes}</label>
        <label class="field" id="fDescendientesWrap" hidden>{t.descendientesLabel} <span class="field-optional">{t.descendientesHint}</span>
          <textarea id="fDetalleDescendientes" maxlength="500" rows="3"></textarea>
        </label>

        <label class="checkbox-option"><input type="checkbox" id="fAscendientes" /> {t.ascendientes}</label>
        <label class="field" id="fAscendientesWrap" hidden>{t.ascendientesLabel} <span class="field-optional">{t.ascendientesHint}</span>
          <textarea id="fDetalleAscendientes" maxlength="500" rows="2"></textarea>
        </label>

        <label class="checkbox-option"><input type="checkbox" id="fPensiones" /> {t.pensiones}</label>
        <label class="field" id="fPensionesWrap" hidden>{t.pensionesLabel} <span class="field-optional">{t.pensionesHint}</span>
          <textarea id="fDetallePensiones" maxlength="300" rows="2"></textarea>
        </label>

        <label class="checkbox-option"><input type="checkbox" id="fPrestamo" /> {t.prestamo}</label>
        <label class="checkbox-option"><input type="checkbox" id="fMovilidad" /> {t.movilidad}</label>
      </div>
    </fieldset>

    <fieldset class="alta-section">
      <legend>{t.secContrato}</legend>
      <label class="field">{t.fechaInicio} <input type="date" id="fFechaInicio" required /></label>

      <div class="field-group">
        <p class="field-group-label">{t.tipo}</p>
        <div class="radio-group" data-field="tipoContrato">
          {Object.entries(t.tipos).map(([value, label]) => (
            <label class="radio-option"><input type="radio" name="tipoContrato" value={value} /> {label}</label>
          ))}
        </div>
      </div>

      <div id="fTemporalWrap" class="field-group" hidden>
        <label class="field" id="fFechaFinWrap">{t.fechaFin} <span class="field-optional" id="fFechaFinHint"></span>
          <input type="date" id="fFechaFin" />
        </label>
        <label class="field">{t.causa} <span class="field-optional">{t.causaHint}</span>
          <textarea id="fCausaTemporal" maxlength="1000" rows="3"></textarea>
        </label>
      </div>

      <div id="fFormativoWrap" class="field-group" hidden>
        <label class="field">{t.tutor} <input type="text" id="fTutor" maxlength="150" /></label>
        <label class="field">{t.plan} <span class="field-optional">{t.planHint}</span>
          <textarea id="fPlanFormativo" maxlength="1000" rows="3"></textarea>
        </label>
      </div>

      <div class="field-group">
        <p class="field-group-label">{t.jornada}</p>
        <div class="radio-group" data-field="jornada">
          <label class="radio-option"><input type="radio" name="jornada" value="completa" /> {t.completa}</label>
          <label class="radio-option"><input type="radio" name="jornada" value="parcial" /> {t.parcial}</label>
        </div>
      </div>
      <label class="field" id="fHorasWrap">{t.horas} <span class="field-optional" id="fHorasHint">{t.horasHint}</span>
        <input type="number" id="fHoras" min="1" max="40" step="0.5" />
      </label>
      <label class="field" id="fDistribucionWrap">{t.distribucion} <span class="field-optional" id="fDistribucionHint">{t.distribucionHint}</span>
        <textarea id="fDistribucion" maxlength="500" rows="2"></textarea>
      </label>

      <label class="field">{t.puesto} <input type="text" id="fPuesto" maxlength="150" placeholder={t.puestoPh} required /></label>
      <label class="field">{t.funciones} <span class="field-optional">{t.funcionesHint}</span>
        <textarea id="fFunciones" maxlength="1000" rows="3" required></textarea>
      </label>
      <label class="field">{t.categoria} <span class="field-optional">{t.categoriaHint}</span>
        <input type="text" id="fCategoria" maxlength="150" />
      </label>
      <label class="field">{t.grupo} <span class="field-optional">{t.grupoHint}</span>
        <select id="fGrupo">
          <option value="">{t.grupoNoSe}</option>
          {t.grupos.map((label, i) => <option value={String(i + 1)}>{i + 1} · {label}</option>)}
        </select>
      </label>
      <label class="field">{t.cno} <span class="field-optional">{t.cnoHint}</span>
        <input type="text" id="fCno" maxlength="20" />
      </label>
    </fieldset>

    <fieldset class="alta-section">
      <legend>{t.secRetribucion}</legend>
      <label class="field">{t.salario} <input type="number" id="fSalario" min="1" step="0.01" required /></label>
      <label class="field">{t.complementos} <span class="field-optional">{t.complementosHint}</span>
        <textarea id="fComplementos" maxlength="500" rows="2"></textarea>
      </label>
      <label class="field">{t.pagas} <input type="number" id="fPagas" min="12" max="16" step="1" placeholder="14" required /></label>
      <label class="checkbox-option"><input type="checkbox" id="fProrrateadas" /> {t.prorrateadas}</label>
      <label class="field">{t.prueba} <span class="field-optional">{t.pruebaHint}</span>
        <input type="text" id="fPrueba" maxlength="100" />
      </label>
      <label class="field">{t.vacaciones} <span class="field-optional">{t.vacacionesHint}</span>
        <input type="text" id="fVacaciones" maxlength="150" />
      </label>
      <label class="field">{t.bonif} <span class="field-optional">{t.bonifHint}</span>
        <textarea id="fBonificaciones" maxlength="500" rows="2"></textarea>
      </label>
      <label class="field">{t.observaciones} <span class="field-optional">{t.observacionesHint}</span>
        <textarea id="fObservaciones" maxlength="1000" rows="3"></textarea>
      </label>
    </fieldset>

    <fieldset class="alta-section">
      <legend>{t.secDocs}</legend>
      <p class="field-hint">{t.docsPre} <a href={`mailto:${EMAIL_CONTACTO}`}>{EMAIL_CONTACTO}</a>{t.docsPost}</p>
      <ul class="plain-list">
        {t.docs.map((d) => <li>{d}</li>)}
      </ul>
      <p class="field-hint">{t.autorizacion}</p>
    </fieldset>

    <label class="consent">
      <input type="checkbox" id="fPrivacy" required />
      <span>{t.privacyPre} <a href={t.privacidadHref} target="_blank" rel="noopener">{t.privacyLink}</a>{t.privacyPost}</span>
    </label>

    <p class="form-error" id="formError" hidden>{t.error}</p>

    <button type="submit" class="btn btn-primary form-submit" id="formSubmit">{t.enviar}</button>
  </form>

  <div class="page view-block form-success" id="formSuccess" hidden>
    <p class="eyebrow">{t.recibido}</p>
    <h2 class="section-title">{t.gracias}</h2>
    <p class="section-sub">{t.graciasSub}</p>
  </div>
</div>

<script>
  import { track } from '../../scripts/analytics';

  (function () {
    const form = document.getElementById('trabajadorForm') as HTMLFormElement | null;
    if (!form) return;

    const success = document.getElementById('formSuccess') as HTMLElement;
    const errorEl = document.getElementById('formError') as HTMLElement;
    const submitBtn = document.getElementById('formSubmit') as HTMLButtonElement;

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const val = (id: string) => ($<HTMLInputElement>(id).value || '').trim();
    const checked = (id: string) => $<HTMLInputElement>(id).checked;
    function radioValue(name: string): string | undefined {
      return form?.querySelector<HTMLInputElement>(`[name="${name}"]:checked`)?.value;
    }

    // El enlace se manda con los datos de la EMPRESA (nuestro cliente):
    // ?nif=<NIF del cliente>&email=<su email>. El NIF queda de solo lectura
    // para que el alta no se pueda asignar a otra empresa por error.
    const params = new URLSearchParams(window.location.search);
    const nifParam = params.get('nif');
    if (nifParam) {
      $<HTMLInputElement>('fEmpNif').value = nifParam;
      $<HTMLInputElement>('fEmpNif').readOnly = true;
    }
    const emailParam = params.get('email');
    if (emailParam) $<HTMLInputElement>('fEmpEmail').value = emailParam;

    // Aviso que nombra el campo que el servidor rechaza (mismo criterio que
    // los otros formularios), en el idioma de la página vía data-*.
    const CAMPOS: Record<string, string> = JSON.parse(form.dataset.campos || '{}');
    const MSG_CAMPO = form.dataset.msgCampo || '';
    const MENSAJE_GENERICO = errorEl.textContent;
    async function mostrarError(res: Response | null) {
      let campo = '';
      try { campo = (await res?.json())?.field ?? ''; } catch { /* sin detalle */ }
      errorEl.textContent = campo && CAMPOS[campo] ? MSG_CAMPO.replace('{campo}', CAMPOS[campo]) : MENSAJE_GENERICO;
      errorEl.hidden = false;
    }

    // Muestra/oculta un bloque según una casilla, vaciándolo al ocultarlo para
    // que no viaje un dato de una opción que ya no aplica.
    function toggleConCasilla(casillaId: string, wrapId: string, inputId: string, mostrarSiMarcada = true) {
      const casilla = $<HTMLInputElement>(casillaId);
      const wrap = $<HTMLElement>(wrapId);
      const update = () => {
        const visible = casilla.checked === mostrarSiMarcada;
        wrap.hidden = !visible;
        if (!visible) $<HTMLInputElement>(inputId).value = '';
      };
      casilla.addEventListener('change', update);
      update();
    }
    toggleConCasilla('fSinNuss', 'fNussWrap', 'fNuss', false);
    toggleConCasilla('fExtracomunitario', 'fVigenciaWrap', 'fVigencia');
    toggleConCasilla('fDiscapacidad', 'fGradoWrap', 'fGrado');
    toggleConCasilla('fDescendientes', 'fDescendientesWrap', 'fDetalleDescendientes');
    toggleConCasilla('fAscendientes', 'fAscendientesWrap', 'fDetalleAscendientes');
    toggleConCasilla('fPensiones', 'fPensionesWrap', 'fDetallePensiones');

    // Modelo 145: el bloque solo se muestra si el trabajador facilita los datos.
    const wrap145 = $<HTMLElement>('f145Wrap');
    form.querySelectorAll<HTMLInputElement>('[name="datos145"]').forEach((r) => r.addEventListener('change', () => {
      wrap145.hidden = radioValue('datos145') !== 'facilita';
    }));

    // Tipo de contrato: temporal -> fecha de fin y causa; formativo -> tutor y plan.
    const temporalWrap = $<HTMLElement>('fTemporalWrap');
    const formativoWrap = $<HTMLElement>('fFormativoWrap');
    const fechaFinHint = $<HTMLElement>('fFechaFinHint');
    form.querySelectorAll<HTMLInputElement>('[name="tipoContrato"]').forEach((r) => r.addEventListener('change', () => {
      const tipo = radioValue('tipoContrato') || '';
      temporalWrap.hidden = !tipo.startsWith('temporal_');
      formativoWrap.hidden = !tipo.startsWith('formativo_');
      // En una sustitución muchas veces no se sabe cuándo vuelve la persona
      // sustituida, así que la fecha de fin solo es obligatoria por producción.
      fechaFinHint.textContent = tipo === 'temporal_sustitucion' ? (form.dataset.finSustitucion || '') : '*';
    }));

    // Jornada parcial: horas y distribución pasan a ser obligatorias (hay que
    // registrar las horas). En completa son opcionales.
    const horasHint = $<HTMLElement>('fHorasHint');
    const distribucionHint = $<HTMLElement>('fDistribucionHint');
    const HORAS_HINT_COMPLETA = horasHint.textContent;
    const DISTRIBUCION_HINT_COMPLETA = distribucionHint.textContent;
    form.querySelectorAll<HTMLInputElement>('[name="jornada"]').forEach((r) => r.addEventListener('change', () => {
      const parcial = radioValue('jornada') === 'parcial';
      horasHint.textContent = parcial ? '*' : HORAS_HINT_COMPLETA;
      distribucionHint.textContent = parcial ? (form.dataset.distribucionParcial || '*') : DISTRIBUCION_HINT_COMPLETA;
    }));

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      errorEl.textContent = MENSAJE_GENERICO;
      errorEl.hidden = true;

      const sexo = radioValue('sexo');
      const datos145 = radioValue('datos145');
      const tipoContrato = radioValue('tipoContrato');
      const jornada = radioValue('jornada');
      if (!sexo || !datos145 || !tipoContrato || !jornada) {
        errorEl.hidden = false;
        return;
      }

      const body: Record<string, unknown> = {
        empresaNombre: val('fEmpNombre'),
        empresaNif: val('fEmpNif'),
        empresaEmail: val('fEmpEmail'),
        centroTrabajo: val('fCentro'),
        nombreCompleto: val('fNombre'),
        nifNie: val('fNif'),
        fechaNacimiento: val('fFechaNacimiento'),
        sexo,
        nacionalidad: val('fNacionalidad'),
        domicilio: val('fDomicilio'),
        telefono: val('fTelefono'),
        email: val('fEmail'),
        sinNuss: checked('fSinNuss'),
        extracomunitario: checked('fExtracomunitario'),
        iban: val('fIban'),
        nivelEstudios: val('fNivelEstudios'),
        discapacidad: checked('fDiscapacidad'),
        datos145,
        fechaInicio: val('fFechaInicio'),
        tipoContrato,
        jornada,
        puesto: val('fPuesto'),
        funciones: val('fFunciones'),
        salarioBrutoAnual: Number(val('fSalario')),
        numeroPagas: Number(val('fPagas')),
        pagasProrrateadas: checked('fProrrateadas'),
        privacyAccepted: checked('fPrivacy'),
      };

      // Opcionales y condicionales: solo viajan si tienen valor.
      const opcionales: Record<string, string> = {
        ccc: 'fCcc', convenio: 'fConvenio', nuss: 'fNuss', vigenciaPermiso: 'fVigencia', titulacion: 'fTitulacion',
        fechaFin: 'fFechaFin', causaTemporal: 'fCausaTemporal', tutor: 'fTutor', planFormativo: 'fPlanFormativo',
        distribucionJornada: 'fDistribucion', categoria: 'fCategoria', grupoCotizacion: 'fGrupo', cno: 'fCno',
        complementos: 'fComplementos', periodoPrueba: 'fPrueba', vacaciones: 'fVacaciones',
        bonificaciones: 'fBonificaciones', observaciones: 'fObservaciones',
      };
      for (const [clave, id] of Object.entries(opcionales)) {
        const v = val(id);
        if (v) body[clave] = v;
      }
      if (val('fGrado')) body.gradoDiscapacidad = Number(val('fGrado'));
      if (val('fHoras')) body.horasSemanales = Number(val('fHoras'));
      // Los campos de un tipo de contrato que ya no está elegido no se mandan.
      if (!tipoContrato.startsWith('temporal_')) { delete body.fechaFin; delete body.causaTemporal; }
      if (!tipoContrato.startsWith('formativo_')) { delete body.tutor; delete body.planFormativo; }

      if (datos145 === 'facilita') {
        body.situacionFamiliar = radioValue('situacionFamiliar');
        body.descendientes = checked('fDescendientes');
        body.ascendientes = checked('fAscendientes');
        body.pensiones = checked('fPensiones');
        body.prestamoViviendaAnterior2013 = checked('fPrestamo');
        body.movilidadGeografica = checked('fMovilidad');
        if (val('fDetalleDescendientes')) body.detalleDescendientes = val('fDetalleDescendientes');
        if (val('fDetalleAscendientes')) body.detalleAscendientes = val('fDetalleAscendientes');
        if (val('fDetallePensiones')) body.detallePensiones = val('fDetallePensiones');
      }

      submitBtn.disabled = true;
      try {
        const res = await fetch('/api/alta-trabajador', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        if (!res.ok) { await mostrarError(res); submitBtn.disabled = false; return; }
        track('formulario_enviado', { tipo: 'alta_trabajador' });
        form.hidden = true;
        success.hidden = false;
        window.scrollTo({ top: 0 });
      } catch {
        errorEl.hidden = false;
        submitBtn.disabled = false;
      }
    });
  })();
</script>
