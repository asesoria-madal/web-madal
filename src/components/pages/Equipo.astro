---
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div id="view-equipo">
  <div class="page view-intro">
    <p class="eyebrow">{t.equipo.eyebrow}</p>
    <h2 class="section-title">{t.equipo.title}</h2>
  </div>
  <div class="page view-block founders">
    <div class="equipo-tags">
      {t.equipo.tags.map((tag) => <span class="tag info">{tag}</span>)}
    </div>
    <p>{t.equipo.p1}</p>
    <p>{t.equipo.p2}</p>
    <p>{t.equipo.p3}</p>
    <p>{t.equipo.p4}</p>
  </div>
</div>
