    width: 100%; -webkit-appearance: none; appearance: none; height: 3px; background: var(--line-bright); outline: none; cursor: pointer;
  }
  .madal-pricing input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none; width: 16px; height: 16px; border-radius: 50%;
    background: var(--accent); border: 2px solid var(--bg); box-shadow: 0 0 0 1px var(--accent);
  }
  .madal-pricing input[type='range']::-moz-range-thumb {
    width: 16px; height: 16px; border-radius: 50%; background: var(--accent); border: 2px solid var(--bg); box-shadow: 0 0 0 1px var(--accent);
  }
  .madal-pricing .sim-result { padding: 30px 32px; display: flex; flex-direction: column; justify-content: center; gap: 18px; }
  .madal-pricing .bar-row { display: flex; flex-direction: column; gap: 6px; }
  .madal-pricing .bar-row .bl { display: flex; justify-content: space-between; font-family: 'IBM Plex Mono', monospace; font-size: 11.5px; color: var(--ink-soft); letter-spacing: 0.03em; }
  .madal-pricing .bar-row .bl .v { color: var(--ink); font-weight: 600; font-variant-numeric: tabular-nums; }
  .madal-pricing .bar-track { height: 10px; background: var(--bg); border: 1px solid var(--line-bright); position: relative; }
  .madal-pricing .bar-fill { height: 100%; background: var(--ink-dim); transition: width 0.35s ease; }
  .madal-pricing .bar-fill.hoy { background: var(--ink-dim); }
  .madal-pricing .bar-fill.con { background: linear-gradient(90deg, var(--accent), var(--accent-strong)); }
  .madal-pricing .sim-note { font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: var(--ink-dim); line-height: 1.6; letter-spacing: 0.01em; margin-top: 4px; }

  .madal-pricing .plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  @media (max-width: 900px) { .madal-pricing .plans { grid-template-columns: 1fr; } }
  .madal-pricing .plan { display: flex; flex-direction: column; padding: 28px 26px; transition: transform 0.2s, border-color 0.2s; }
  .madal-pricing .plan:hover { transform: translateY(-4px); border-color: var(--accent-strong); }
  .madal-pricing .plan.featured { border-color: var(--accent); background: linear-gradient(180deg, var(--accent-soft), var(--bg-panel) 45%); }
  .madal-pricing .plan.premium { border-color: var(--accent2); background: linear-gradient(180deg, var(--accent2-soft), var(--bg-panel) 45%); }
  .madal-pricing .plan .tag {
    align-self: flex-start; font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase; padding: 4px 9px; border: 1px solid var(--line-bright); color: var(--ink-soft);
  }
  .madal-pricing .plan.featured .tag { border-color: var(--accent); color: var(--accent-strong); }
  .madal-pricing .plan.premium .tag { border-color: var(--accent2); color: var(--accent2-strong); }
  .madal-pricing .plan.premium .btn-primary { background: var(--accent2); color: #2b1706; }
  .madal-pricing .plan.premium .btn-primary:hover { box-shadow: 0 0 0 1px var(--accent2), 0 8px 24px -8px var(--accent2); }
  .madal-pricing .plan h3 { margin-top: 16px; font-size: 1.24rem; }
  .madal-pricing .plan .scope { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--ink-dim); margin-top: 6px; letter-spacing: 0.03em; }
  .madal-pricing .plan ul { list-style: none; padding: 0; margin: 20px 0 0; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .madal-pricing .plan li { font-size: 0.92rem; color: var(--ink-soft); display: flex; gap: 9px; }
  .madal-pricing .plan li::before { content: '—'; color: var(--accent-strong); flex-shrink: 0; }
  .madal-pricing .plan .price { margin-top: 22px; font-family: 'IBM Plex Mono', monospace; font-size: 13px; color: var(--ink); border-top: 1px solid var(--line); padding-top: 16px; }
  .madal-pricing .plan .price strong { display: block; font-size: 15px; margin-bottom: 2px; }
  .madal-pricing .plan-addon { margin-top: 18px; padding: 12px 14px; border-left: 2px solid var(--accent2); background: rgba(224, 152, 63, 0.08); }
  .madal-pricing .plan-addon .lbl { font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent2-strong); }
  .madal-pricing .plan-addon p { margin: 6px 0 0; font-size: 0.86rem; color: var(--ink-soft); line-height: 1.5; }
  .madal-pricing .plan .btn { margin-top: 16px; justify-content: center; }

  .madal-pricing .cta-final { text-align: left; padding-top: 0; }
  .madal-pricing .cta-panel { padding: 56px 40px; display: flex; justify-content: space-between; align-items: center; gap: 32px; flex-wrap: wrap; }
  .madal-pricing .cta-panel h2 { font-size: clamp(1.6rem, 3.2vw, 2.1rem); max-width: 20ch; }
  .madal-pricing .cta-panel p { margin-top: 10px; color: var(--ink-soft); max-width: 44ch; }

  .madal-pricing footer { padding: 36px 24px 8px; }
  .madal-pricing .foot-inner {
    max-width: 1120px; margin-inline: auto; display: flex; justify-content: space-between;
    flex-wrap: wrap; gap: 14px; font-family: 'IBM Plex Mono', monospace; font-size: 11.5px; color: var(--ink-dim);
    letter-spacing: 0.03em;
  }
  .madal-pricing .foot-inner a { text-decoration: none; color: var(--ink-dim); }
  .madal-pricing .foot-inner a:hover { color: var(--accent-strong); }
</style>

<script>
  // Reengancha en cada astro:page-load (carga inicial + transiciones de
  // astro:transitions) — mismo patrón que ContactSwitch.astro, necesario
  // porque Layout.astro usa <ClientRouter />.
  function initMadalPricing() {
    const root = document.querySelector('.madal-pricing');
    if (!root) return;

    const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // reveal on scroll
    const revealEls = root.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window) {
      const ro = new IntersectionObserver(
        (entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) {
              en.target.classList.add('in');
              ro.unobserve(en.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -60px 0px' },
      );
      revealEls.forEach((el) => ro.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add('in'));
    }

    // count-up
    function animateCount(el: Element) {
      const target = parseFloat(el.getAttribute('data-target') || '0') || 0;
      if (reduceMotion) {
        el.textContent = String(target);
        return;
      }
      let start: number | null = null;
      const dur = 900;
      function step(ts: number) {
        if (start === null) start = ts;
        const p = Math.min(1, (ts - start) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = String(Math.round(target * eased));
        if (p < 1) requestAnimationFrame(step);
        else el.textContent = String(target);
      }
      requestAnimationFrame(step);
    }
    const counters = root.querySelectorAll('.count');
    if ('IntersectionObserver' in window) {
      const co = new IntersectionObserver(
        (entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) {
              animateCount(en.target);
              co.unobserve(en.target);
            }
          });
        },
        { threshold: 0.6 },
      );
      counters.forEach((c) => co.observe(c));
    } else {
      counters.forEach((c) => (c.textContent = c.getAttribute('data-target')));
    }

    // scrollspy: nav + rail
    const sectionIds = ['top', 'ventaja', 'pilares', 'proceso', 'simulador', 'conexion', 'planes'];
    const sections = sectionIds.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
    const navLinks = root.querySelectorAll('#navlinks a');
    const railDots = root.querySelectorAll('.rail-dot');
    function setActive(id: string) {
      navLinks.forEach((a) => a.classList.toggle('active', a.getAttribute('data-nav') === id));
      railDots.forEach((d) => d.classList.toggle('active', d.getAttribute('data-target') === id));
    }
    if ('IntersectionObserver' in window && sections.length) {
      const spy = new IntersectionObserver(
        (entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) setActive(en.target.id);
          });
        },
        { rootMargin: '-40% 0px -55% 0px', threshold: 0 },
      );
      sections.forEach((s) => spy.observe(s));
    }
    railDots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const t = document.getElementById(dot.getAttribute('data-target') || '');
        if (t) t.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      });
    });

    // pillar accordion
    const pillars = root.querySelectorAll('.pillar');
    function openPillar(num: string | null) {
      pillars.forEach((p) => p.classList.toggle('open', p.getAttribute('data-pillar') === String(num)));
    }
    pillars.forEach((p) => {
      p.addEventListener('click', () => {
        const isOpen = p.classList.contains('open');
        openPillar(isOpen ? null : p.getAttribute('data-pillar'));
      });
    });

    // hero diagram: click a stair -> scroll to pillar + open it
    root.querySelectorAll('.stair-hit').forEach((hit) => {
      function go() {
        const num = hit.getAttribute('data-pillar');
        openPillar(num);
        const target = root!.querySelector(`.pillar[data-pillar="${num}"]`);
        if (target) target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
      }
      hit.addEventListener('click', go);
      hit.addEventListener('keydown', (e) => {
        const ke = e as KeyboardEvent;
        if (ke.key === 'Enter' || ke.key === ' ') {
          ke.preventDefault();
          go();
        }
      });
    });

    // hero diagram parallax tilt
    const wrap = root.querySelector<HTMLElement>('#diagramWrap');
    const inner = root.querySelector<HTMLElement>('#diagramInner');
    if (wrap && inner && !reduceMotion && window.matchMedia('(pointer:fine)').matches) {
      wrap.addEventListener('mousemove', (e) => {
        const r = wrap.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        inner.style.transform = `rotateX(${py * -6}deg) rotateY(${px * 8}deg)`;
      });
      wrap.addEventListener('mouseleave', () => {
        inner.style.transform = 'rotateX(0) rotateY(0)';
      });
    }

    // simulator
    const marginRange = root.querySelector<HTMLInputElement>('#marginRange');
    const volRange = root.querySelector<HTMLInputElement>('#volRange');
    const marginVal = root.querySelector('#marginVal');
    const volVal = root.querySelector('#volVal');
    const hoyBar = root.querySelector<HTMLElement>('#hoyBar');
    const conBar = root.querySelector<HTMLElement>('#conBar');
    const hoyLabel = root.querySelector('#hoyLabel');
    const conLabel = root.querySelector('#conLabel');
    const deltaNote = root.querySelector('#deltaNote');

    function upliftFor(margin: number) {
      // Rango orientativo e ilustrativo: mejora decreciente cuanto mayor es ya el margen.
      if (margin < 15) return 8;
      if (margin < 25) return 6;
      if (margin < 35) return 4;
      return 2;
    }
    function updateSim() {
      if (!marginRange || !volRange) return;
      const margin = parseInt(marginRange.value, 10);
      const vol = parseInt(volRange.value, 10);
      const uplift = upliftFor(margin);
      const withPricing = Math.min(60, margin + uplift);
      if (marginVal) marginVal.textContent = margin + '%';
      if (volVal) volVal.textContent = String(vol);
      if (hoyBar) hoyBar.style.width = margin + '%';
      if (conBar) conBar.style.width = withPricing + '%';
      if (hoyLabel) hoyLabel.textContent = margin + '%';
      if (conLabel) conLabel.textContent = withPricing + '%';
      if (deltaNote)
        deltaNote.textContent =
          '+' + uplift + ' puntos de margen (ejemplo) sobre ' + vol + ' clientes/mes al mes es la diferencia que suele notarse antes en caja.';
    }
    if (marginRange && volRange) {
      marginRange.addEventListener('input', updateSim);
      volRange.addEventListener('input', updateSim);
      updateSim();
    }
  }

  document.addEventListener('astro:page-load', initMadalPricing);
</script>
