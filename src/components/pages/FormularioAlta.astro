---
// Formulario de una sola página (no wizard tipo Simulador.astro): aquí no
// hay ramas de preguntas ni precio que calcular, solo muchos campos de
// datos que Edurne necesita para tramitar el alta — un formulario largo
// tradicional, agrupado por secciones, es más rápido de rellenar que un
// wizard de una pregunta por pantalla.
//
// Sin enlazar desde el menú: se manda el link directo al cliente ya
// identificado. Existe en castellano (/formulario-alta) e inglés
// (/en/formulario-alta); los textos viven en src/i18n/formularios.ts. Lo que
// se envía al servidor es igual en los dos idiomas.
import { ALTA, CAMPOS, COMUNES, MSG_CAMPO, PRIVACIDAD_HREF, type FormLang } from '../../i18n/formularios';

interface Props { lang?: FormLang; }
const { lang = 'es' } = Astro.props;
const t = { ...COMUNES[lang], ...ALTA[lang] };
---

<div id="view-alta-form">
  <div class="page view-intro">
    <p class="eyebrow">{t.eyebrow}</p>
    <h1 class="section-title">{t.title}</h1>
    <p class="section-sub">{t.intro}</p>
    <p class="field-hint">{t.obligatorios}</p>
  </div>

  <form id="altaForm" class="alta-form page view-block" novalidate data-lang={lang} data-campos={JSON.stringify(CAMPOS[lang])} data-msg-campo={MSG_CAMPO[lang]}>
    <fieldset class="alta-section">
      <legend>{t.idDigital}</legend>
      <p class="field-hint">{t.idDigitalHint}</p>
      <div class="radio-group" data-field="identificacionDigital">
        <label class="radio-option"><input type="radio" name="identificacionDigital" value="certificado" /> {t.certificado}</label>
        <label class="radio-option"><input type="radio" name="identificacionDigital" value="clave_pin" /> {t.clavePin}</label>
        <label class="radio-option"><input type="radio" name="identificacionDigital" value="ninguno" /> {t.ninguno}</label>
      </div>
    </fieldset>

    <fieldset class="alta-section">
      <legend>{t.basicos}</legend>
      <label class="field">{t.nombre} <input type="text" id="fNombre" maxlength="150" required /></label>
      <label class="field">{t.nif} <input type="text" id="fNif" maxlength="9" placeholder="12345678A" required /></label>
      <label class="field">{t.email} <input type="email" id="fEmail" maxlength="254" required /></label>
      <label class="field">{t.telefono} <input type="tel" id="fTelefono" maxlength="20" required /></label>
      <label class="field">{t.domFiscal} <textarea id="fDomicilioFiscal" maxlength="300" rows="2" required></textarea></label>
      <label class="field">{t.domNotif} <span class="field-optional">{t.soloSiDistinto}</span>
        <textarea id="fDomicilioNotif" maxlength="300" rows="2"></textarea>
      </label>
      <label class="field">{t.iban} <input type="text" id="fIban" maxlength="34" placeholder="ES00 0000 0000 0000 0000 0000" required /></label>
    </fieldset>

    <fieldset class="alta-section">
      <legend>{t.actividad}</legend>
      <label class="field">{t.epigrafes} <span class="field-optional">{t.epigrafesHint}</span>
        <textarea id="fEpigrafes" maxlength="500" rows="3" required></textarea>
      </label>
      <label class="field">{t.fechaInicio} <input type="date" id="fFechaInicio" required /></label>

      <div class="field-group">
        <p class="field-group-label">{t.dondeEjerces}</p>
        <div class="radio-group" data-field="tipoLocal">
          <label class="radio-option"><input type="radio" name="tipoLocal" value="casa" /> {t.casa}</label>
          <label class="radio-option"><input type="radio" name="tipoLocal" value="oficina" /> {t.oficina}</label>
          <label class="radio-option"><input type="radio" name="tipoLocal" value="sin_local" /> {t.sinLocal}</label>
        </div>
        <p class="field-hint">{t.basurasHint}</p>
      </div>

      <label class="field" id="fDomicilioLocalWrap">{t.domLocal}
        <span class="field-optional">{t.domLocalHint}</span>
        <textarea id="fDomicilioLocal" maxlength="300" rows="2"></textarea>
      </label>

      <label class="checkbox-option"><input type="checkbox" id="fMultiplesLocales" /> {t.multiples}</label>
      <label class="field" id="fDetalleLocalesWrap" hidden>{t.multiplesDetalle} <textarea id="fDetalleLocales" maxlength="300" rows="2"></textarea></label>

      <label class="checkbox-option"><input type="checkbox" id="fColegiada" /> {t.colegiada}</label>
      <div class="field-group" id="fRegimenCotizacionWrap" hidden>
        <p class="field-group-label">{t.regimenCot}</p>
        <div class="radio-group" data-field="regimenCotizacion">
          <label class="radio-option"><input type="radio" name="regimenCotizacion" value="reta" /> {t.reta}</label>
          <label class="radio-option"><input type="radio" name="regimenCotizacion" value="mutualidad" /> {t.mutualidad}</label>
        </div>
      </div>
    </fieldset>

    <fieldset class="alta-section">
      <legend>{t.iva}</legend>
      <label class="checkbox-option"><input type="checkbox" id="fIntracomunitarias" /> {t.intracom}</label>
    </fieldset>

    <fieldset class="alta-section">
      <legend>{t.irpf}</legend>
      <div class="field-group">
        <p class="field-group-label">{t.retencion}</p>
        <div class="radio-group" data-field="retencionIrpf">
          <label class="radio-option"><input type="radio" name="retencionIrpf" value="si" /> {t.si}</label>
          <label class="radio-option"><input type="radio" name="retencionIrpf" value="no" /> {t.no}</label>
          <label class="radio-option"><input type="radio" name="retencionIrpf" value="no_sabe" /> {t.noSabe}</label>
        </div>
      </div>
      <label class="checkbox-option"><input type="checkbox" id="fTrabajadores" /> {t.trabajadores}</label>
    </fieldset>

    <fieldset class="alta-section">
      <legend>{t.recuerda}</legend>
      <p class="field-hint">{t.apoderarHint}</p>
      <ul class="doc-list">
        <li>
          <a href="https://suslwmgqdzingeqhfrpw.supabase.co/storage/v1/object/public/docs-publicos/Pasos_Apoderamiento_Seguridad_Social.pdf" target="_blank" rel="noopener">
            {t.guiaSS}
          </a>
        </li>
        <li>
          <a href="https://suslwmgqdzingeqhfrpw.supabase.co/storage/v1/object/public/docs-publicos/Pasos_Apoderamiento_AEAT.pdf" target="_blank" rel="noopener">
            {t.guiaAeat}
          </a>
        </li>
      </ul>
      <p class="field-hint">
        {t.rgpdHint}
        <a href="https://suslwmgqdzingeqhfrpw.supabase.co/storage/v1/object/public/docs-publicos/RGPD.pdf" target="_blank" rel="noopener">{t.rgpdLink}</a>.
      </p>
    </fieldset>

    <label class="consent">
      <input type="checkbox" id="fPrivacy" required />
      <span>{t.privacyPre} <a href={PRIVACIDAD_HREF[lang]} target="_blank" rel="noopener">{t.privacyLink}</a> {t.privacyPost}</span>
    </label>

    <p class="form-error" id="formError" hidden>{t.error}</p>

    <button type="submit" class="btn btn-primary form-submit" id="formSubmit">{t.enviar}</button>
  </form>

  <div class="page view-block form-success" id="formSuccess" hidden>
    <p class="eyebrow">{t.recibido}</p>
    <h2 class="section-title">{t.gracias}</h2>
    <p class="section-sub">{t.graciasSub}</p>
  </div>
</div>

<script>
  import { track } from '../../scripts/analytics';

  (function () {
    const form = document.getElementById('altaForm') as HTMLFormElement | null;
    if (!form) return;

    const success = document.getElementById('formSuccess') as HTMLElement;
    const errorEl = document.getElementById('formError') as HTMLElement;
    const submitBtn = document.getElementById('formSubmit') as HTMLButtonElement;

    const params = new URLSearchParams(window.location.search);

    // El link de este formulario se manda ya personalizado con el NIF del
    // cliente (?nif=..., añadido por el workflow de n8n al enviarlo — ver
    // "Preparar mail"), que es el mismo id con el que se creó su fila en
    // `clientes`. Se precarga en el campo NIF/NIE que ya existía y se deja
    // de solo lectura para que no pueda desincronizarse del cliente al que
    // está vinculado el envío.
    const nifInput = document.getElementById('fNif') as HTMLInputElement;
    const nifParam = params.get('nif');
    if (nifParam) {
      nifInput.value = nifParam;
      nifInput.readOnly = true;
    }
    // El email con el que damos de alta al cliente también viaja en el enlace (?email=).
    const emailParam = params.get('email');
    if (emailParam) (document.getElementById('fEmail') as HTMLInputElement).value = emailParam;

    // Si el servidor dice qué campo no valida (`field`), el aviso lo nombra.
    // Nombres de campo y plantilla del aviso en el idioma de la página
    // (src/i18n/formularios.ts), pasados como data-* del formulario.
    const CAMPOS: Record<string, string> = JSON.parse(form.dataset.campos || '{}');
    const MSG_CAMPO = form.dataset.msgCampo || '';
    const MENSAJE_GENERICO = errorEl.textContent;
    async function mostrarError(res: Response | null) {
      let campo = '';
      try { campo = (await res?.json())?.field ?? ''; } catch { /* sin detalle */ }
      errorEl.textContent = campo && CAMPOS[campo]
        ? MSG_CAMPO.replace('{campo}', CAMPOS[campo])
        : MENSAJE_GENERICO;
      errorEl.hidden = false;
    }

    const tipoLocalWrap = document.getElementById('fDomicilioLocalWrap') as HTMLElement;
    const domicilioLocalInput = document.getElementById('fDomicilioLocal') as HTMLTextAreaElement;
    form.querySelectorAll<HTMLInputElement>('[name="tipoLocal"]').forEach(function (radio) {
      radio.addEventListener('change', function () {
        const sinLocal = radio.value === 'sin_local' && radio.checked;
        tipoLocalWrap.hidden = sinLocal;
        if (sinLocal) domicilioLocalInput.value = '';
      });
    });

    const multiplesLocales = document.getElementById('fMultiplesLocales') as HTMLInputElement;
    const detalleLocalesWrap = document.getElementById('fDetalleLocalesWrap') as HTMLElement;
    const detalleLocalesInput = document.getElementById('fDetalleLocales') as HTMLTextAreaElement;
    multiplesLocales.addEventListener('change', function () {
      detalleLocalesWrap.hidden = !multiplesLocales.checked;
      if (!multiplesLocales.checked) detalleLocalesInput.value = '';
    });

    const colegiada = document.getElementById('fColegiada') as HTMLInputElement;
    const regimenWrap = document.getElementById('fRegimenCotizacionWrap') as HTMLElement;
    colegiada.addEventListener('change', function () {
      regimenWrap.hidden = !colegiada.checked;
      if (!colegiada.checked) {
        form.querySelectorAll<HTMLInputElement>('[name="regimenCotizacion"]').forEach(function (r) { r.checked = false; });
      }
    });

    function radioValue(name: string): string | undefined {
      const checked = form?.querySelector<HTMLInputElement>(`[name="${name}"]:checked`);
      return checked?.value;
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      errorEl.hidden = true;

      const identificacionDigital = radioValue('identificacionDigital');
      const tipoLocal = radioValue('tipoLocal');
      const retencionIrpf = radioValue('retencionIrpf');
      const regimenCotizacion = colegiada.checked ? radioValue('regimenCotizacion') : undefined;

      if (!identificacionDigital || !tipoLocal || !retencionIrpf || (colegiada.checked && !regimenCotizacion)) {
        errorEl.hidden = false;
        return;
      }

      const body: Record<string, unknown> = {
        identificacionDigital,
        nombreCompleto: (document.getElementById('fNombre') as HTMLInputElement).value.trim(),
        nifNie: (document.getElementById('fNif') as HTMLInputElement).value.trim(),
        email: (document.getElementById('fEmail') as HTMLInputElement).value.trim(),
        telefono: (document.getElementById('fTelefono') as HTMLInputElement).value.trim(),
        domicilioFiscal: (document.getElementById('fDomicilioFiscal') as HTMLTextAreaElement).value.trim(),
        iban: (document.getElementById('fIban') as HTMLInputElement).value.trim(),
        epigrafesIae: (document.getElementById('fEpigrafes') as HTMLTextAreaElement).value.trim(),
        fechaInicioActividad: (document.getElementById('fFechaInicio') as HTMLInputElement).value,
        tipoLocal,
        multiplesLocales: multiplesLocales.checked,
        profesionColegiada: colegiada.checked,
        operacionesIntracomunitarias: (document.getElementById('fIntracomunitarias') as HTMLInputElement).checked,
        retencionIrpf,
        tendraTrabajadores: (document.getElementById('fTrabajadores') as HTMLInputElement).checked,
        privacyAccepted: (document.getElementById('fPrivacy') as HTMLInputElement).checked,
        idioma: form.dataset.lang,
      };

      const domicilioNotif = (document.getElementById('fDomicilioNotif') as HTMLTextAreaElement).value.trim();
      if (domicilioNotif) body.domicilioNotificaciones = domicilioNotif;

      if (tipoLocal !== 'sin_local') body.domicilioLocal = domicilioLocalInput.value.trim();

      if (multiplesLocales.checked) {
        const detalle = detalleLocalesInput.value.trim();
        if (detalle) body.detalleLocalesAdicionales = detalle;
      }

      if (colegiada.checked) body.regimenCotizacion = regimenCotizacion;

      submitBtn.disabled = true;
      try {
        const res = await fetch('/api/alta-autonomo', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        if (!res.ok) { await mostrarError(res); submitBtn.disabled = false; return; }
        track('formulario_enviado', { tipo: 'alta' });
        form.hidden = true;
        success.hidden = false;
      } catch (err) {
        errorEl.hidden = false;
        submitBtn.disabled = false;
      }
    });
  })();
</script>
