---
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div id="view-servicios">
  <div class="page view-intro">
    <p class="eyebrow">{t.servicios.eyebrow}</p>
    <h1 class="section-title">{t.servicios.title}</h1>
  </div>
  <div class="page view-block">
    <p class="section-sub">{t.servicios.comingSoon}</p>
  </div>
</div>
