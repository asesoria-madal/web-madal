---
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const s = t.servicios;

// Mismo trazo que el gráfico real del área de cliente (ver Portal.astro,
// renderEvolucion): tres polylines sobre un viewBox fijo, con un punto por
// mes. Aquí, en vez de datos reales de Supabase, es un ejemplo fijo — la
// promesa de "reporting y dashboards" se demuestra en vez de solo contarse
// en texto, sin fabricar datos de ningún cliente real (por eso llevan el
// aviso "ejemplo ilustrativo" explícito, igual que el resto del sitio evita
// prueba social inventada).
const evoExample = [
  { mes: 'Ene', ingresos: 4200, gastos: 2800 },
  { mes: 'Feb', ingresos: 3900, gastos: 3100 },
  { mes: 'Mar', ingresos: 5100, gastos: 2600 },
  { mes: 'Abr', ingresos: 4700, gastos: 3400 },
  { mes: 'May', ingresos: 5800, gastos: 2900 },
  { mes: 'Jun', ingresos: 6200, gastos: 3300 },
];
const evoPuntos = evoExample.map((p) => ({ ...p, beneficio: p.ingresos - p.gastos }));
const evoValores = evoPuntos.flatMap((p) => [p.ingresos, p.gastos, p.beneficio]);
const EVO_W = 640;
const EVO_H = 200;
const EVO_PAD_X = 20;
const EVO_PAD_Y = 18;
const evoMax = Math.max(...evoValores, 0);
const evoMin = Math.min(...evoValores, 0);
const evoRango = Math.max(evoMax - evoMin, 1);
const evoStepX = evoPuntos.length > 1 ? (EVO_W - EVO_PAD_X * 2) / (evoPuntos.length - 1) : 0;
const evoX = (i: number) => EVO_PAD_X + i * evoStepX;
const evoY = (v: number) => EVO_H - EVO_PAD_Y - ((v - evoMin) / evoRango) * (EVO_H - EVO_PAD_Y * 2);
const evoBaselineY = evoY(0);
const evoShowBaseline = evoMin < 0 && evoMax > 0;
const evoSeries = [
  { valores: evoPuntos.map((p) => p.ingresos), color: 'var(--accent)', label: s.dashboards.exampleLegend.ingresos },
  { valores: evoPuntos.map((p) => p.gastos), color: 'var(--warm)', label: s.dashboards.exampleLegend.gastos },
  { valores: evoPuntos.map((p) => p.beneficio), color: 'var(--ink)', label: s.dashboards.exampleLegend.beneficio },
];
---

<div id="view-servicios">
  <div class="page view-intro founders-hero">
    <p class="eyebrow">{s.eyebrow}</p>
    <h1 class="section-title">{s.heroTitle}</h1>
    <p class="section-sub">{s.heroDek}</p>
  </div>

  <section class="section" id="acompanamiento">
    <div class="label-col"><p class="eyebrow">{s.acompanamiento.eyebrow}</p></div>
    <div>
      <h2 class="section-title">{s.acompanamiento.title}</h2>
      <p class="section-sub">{s.acompanamiento.sub}</p>
      <div class="feature-grid cols-3">
        {s.acompanamiento.channels.map((c) => (
          <div class="feature-card">
            <h3>{c.title}</h3>
            <p>{c.desc}</p>
            <a
              href={c.linkHref}
              class="feature-card-link"
              target={c.linkHref.startsWith('http') ? '_blank' : undefined}
              rel={c.linkHref.startsWith('http') ? 'noopener' : undefined}
            >{c.linkLabel}</a>
          </div>
        ))}
      </div>
      <p class="section-sub servicios-follow">{s.acompanamiento.detail}</p>
    </div>
  </section>

  <section class="section" id="dashboards">
    <div class="label-col"><p class="eyebrow">{s.dashboards.eyebrow}</p></div>
    <div>
      <h2 class="section-title">{s.dashboards.title}</h2>
      <p class="section-sub">{s.dashboards.sub}</p>
      <div class="servicios-shift">
        <p class="from">{s.dashboards.from}</p>
        <p class="to">{s.dashboards.to}</p>
      </div>

      <div class="finanzas-evolucion servicios-follow">
        <svg viewBox={`0 0 ${EVO_W} ${EVO_H}`} class="finanzas-evo-svg" preserveAspectRatio="none">
          {evoShowBaseline && (
            <line x1={EVO_PAD_X} x2={EVO_W - EVO_PAD_X} y1={evoBaselineY} y2={evoBaselineY} class="finanzas-evo-baseline" />
          )}
          {evoSeries.map((serie) => (
            <>
              <polyline points={serie.valores.map((v, i) => `${evoX(i)},${evoY(v)}`).join(' ')} class="finanzas-evo-line" style={`stroke:${serie.color}`} />
              {serie.valores.map((v, i) => (
                <circle cx={evoX(i)} cy={evoY(v)} r="3.5" style={`fill:${serie.color}`} />
              ))}
            </>
          ))}
        </svg>
        <div class="finanzas-evo-labels">
          {evoPuntos.map((p) => <span>{p.mes}</span>)}
        </div>
        <div class="finanzas-evo-legend">
          {evoSeries.map((serie) => (
            <span><span class="dot" style={`background:${serie.color}`}></span>{serie.label}</span>
          ))}
        </div>
      </div>
      <p class="servicios-note">{s.dashboards.exampleCaption}</p>

      <p class="section-sub servicios-follow">{s.dashboards.detail}</p>
    </div>
  </section>

  <section class="section" id="asistente">
    <div class="label-col"><p class="eyebrow">{s.asistente.eyebrow}</p></div>
    <div>
      <div class="servicios-heading">
        <h2 class="section-title">{s.asistente.title}</h2>
        <span class="tag soon">{s.asistente.badge}</span>
      </div>
      <p class="section-sub">{s.asistente.sub}</p>
      <ul class="servicios-list">
        {s.asistente.items.map((item) => <li>{item}</li>)}
      </ul>
      <p class="servicios-note">{s.asistente.note}</p>
    </div>
  </section>

  <section class="section" id="futuro">
    <div class="label-col"><p class="eyebrow">{s.futuro.eyebrow}</p></div>
    <div>
      <h2 class="section-title">{s.futuro.title}</h2>
      <p class="section-sub">{s.futuro.sub}</p>
      <ul class="roadmap">
        {s.futuro.items.map((item, i) => (
          <li>
            <span class="num">{i + 1}</span>
            <div class="item">
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
            <span class="tag soon">{s.futuro.badge}</span>
          </li>
        ))}
      </ul>
      <p class="servicios-closing">{s.futuro.closing}</p>
    </div>
  </section>
</div>
