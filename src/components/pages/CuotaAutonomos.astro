---
// Calculadora de cuota de autónomos 2026 (2026-11-14). Rendimiento computable mensual =
// (ingresos − gastos) × (1 − 7 %, o 3 % si es societario) / 12; con él se busca el tramo de la
// tabla oficial (TRAMOS_2026) y la cuota mínima = base mínima × 31,5 %. Todo en el navegador.
import type { Locale } from '../../i18n/ui';
import { HERRAMIENTAS, TRAMOS_2026, TIPO_RETA_2026 } from '../../i18n/herramientas';
import HerramientaShell from '../herramientas/HerramientaShell.astro';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const c = HERRAMIENTAS[lang].cuota;
const locale = { es: 'es-ES', ca: 'ca-ES', en: 'en-GB' }[lang];
const eur = new Intl.NumberFormat(locale, { style: 'currency', currency: 'EUR' });
const num = new Intl.NumberFormat(locale, { maximumFractionDigits: 2 });
const cuota = (b: number) => Math.round(b * TIPO_RETA_2026 * 100) / 100;
const rango = (t: (typeof TRAMOS_2026)[number]) => t.hasta === null ? `> ${num.format(t.desde)} €` : t.desde === 0 ? `≤ ${num.format(t.hasta)} €` : `${num.format(t.desde)} – ${num.format(t.hasta)} €`;
const datos = JSON.stringify({ tramos: TRAMOS_2026, tipo: TIPO_RETA_2026, reducida: c.tablaReducida, general: c.tablaGeneral });
---

<HerramientaShell lang={lang} title={c.title} dek={c.dek} info={c.info} infoTitle={c.infoTitle} herramienta="cuota">
  <div class="hr-calc" id="calc-cuota" data-locale={locale} data-datos={datos}>
    <form class="hr-form">
      <label class="hr-campo">
        <span>{c.ingresos}</span>
        <input type="number" name="ingresos" inputmode="decimal" min="0" step="100" value="30000" />
      </label>
      <label class="hr-campo">
        <span>{c.gastos}</span>
        <input type="number" name="gastos" inputmode="decimal" min="0" step="100" value="6000" />
        <small>{c.gastosHint}</small>
      </label>
      <label class="hr-check">
        <input type="checkbox" name="societario" />
        <span>{c.societario}</span>
      </label>
    </form>
    <div class="hr-resultado" aria-live="polite">
      <dl>
        <div><dt>{c.rendimiento}</dt><dd data-r="rend">–</dd></div>
        <div><dt>{c.tramo}</dt><dd data-r="tramo">–</dd></div>
        <div><dt>{c.base}</dt><dd data-r="base">–</dd></div>
        <div class="hr-destacado"><dt>{c.cuotaMes}</dt><dd data-r="cuota">–</dd></div>
        <div><dt>{c.cuotaAno}</dt><dd data-r="ano">–</dd></div>
      </dl>
      <p class="hr-explica">{c.nota}</p>
      <p class="hr-explica hr-explica-destacada">{c.tarifaPlana}</p>
    </div>
  </div>

  <h2 class="hr-h2 hr-tabla-titulo">{c.tablaTitle}</h2>
  <div class="hr-tabla-wrap">
    <table class="hr-tabla" id="tabla-tramos">
      <thead><tr><th>{c.colTramo}</th><th>{c.colRend}</th><th>{c.colBase}</th><th>{c.colCuota}</th></tr></thead>
      <tbody>
        {TRAMOS_2026.map((t, i) => (
          <tr data-i={i}>
            <td>{t.tabla === 'reducida' ? c.tablaReducida : c.tablaGeneral} {t.n}</td>
            <td>{rango(t)}</td>
            <td>{eur.format(t.base)}</td>
            <td>{eur.format(cuota(t.base))}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</HerramientaShell>

<script>
  import { track } from '../../scripts/analytics';
  type Tramo = { tabla: string; n: number; desde: number; hasta: number | null; base: number };
  function init() {
    const raiz = document.getElementById('calc-cuota');
    if (!raiz || raiz.dataset.listo) return;
    raiz.dataset.listo = '1';
    const d = JSON.parse(raiz.dataset.datos || '{}') as { tramos: Tramo[]; tipo: number; reducida: string; general: string };
    const form = raiz.querySelector('form') as HTMLFormElement;
    const eur = new Intl.NumberFormat(raiz.dataset.locale, { style: 'currency', currency: 'EUR' });
    const out = (k: string, v: string) => { const el = raiz.querySelector(`[data-r="${k}"]`); if (el) el.textContent = v; };
    let usado = false;
    const calcular = () => {
      const f = new FormData(form);
      const neto = (Number(f.get('ingresos')) || 0) - (Number(f.get('gastos')) || 0);
      const rend = (neto * (f.get('societario') ? 0.97 : 0.93)) / 12;
      // Los tramos van "hasta" incluido, salvo el último de la tabla reducida (< 1.166,70).
      const i = Math.max(0, d.tramos.findIndex((t) => t.hasta === null || (t.hasta === 1166.7 ? rend < t.hasta : rend <= t.hasta)));
      const t = d.tramos[i];
      const cuota = Math.round(t.base * d.tipo * 100) / 100;
      out('rend', eur.format(Math.round(rend * 100) / 100));
      out('tramo', `${t.tabla === 'reducida' ? d.reducida : d.general} ${t.n}`);
      out('base', eur.format(t.base));
      out('cuota', eur.format(cuota));
      out('ano', eur.format(Math.round(cuota * 12 * 100) / 100));
      document.querySelectorAll('#tabla-tramos tbody tr').forEach((tr) => tr.classList.toggle('hr-fila-activa', (tr as HTMLElement).dataset.i === String(i)));
    };
    form.addEventListener('submit', (e) => e.preventDefault());
    form.addEventListener('input', () => {
      calcular();
      if (!usado) { usado = true; track('herramienta_uso', { herramienta: 'cuota' }); }
    });
    calcular();
  }
  document.addEventListener('astro:page-load', init);
</script>
