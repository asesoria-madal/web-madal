---
import { useTranslations, localizedPath } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';
import ContactSwitch from '../ContactSwitch.astro';
import Simulador from './Simulador.astro';
import { getSortedBlogPosts } from '../../lib/blog';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useTranslations(lang);

// Enlace profundo al artículo más reciente del idioma: ayuda a Google a
// descubrir e indexar la página del artículo (no solo el índice del blog).
const latestPost = (await getSortedBlogPosts(lang))[0];

// Tinte progresivo de marca por tramo (primero cálido, medio neutro/tint,
// último sólido) — puramente visual, no cambia el orden ni el contenido
// de los planes.
function tierTintClass(index: number, total: number): string {
  if (index === total - 1) return 'tier-solid';
  if (index === 0) return 'tier-warm';
  if (index === total - 2) return 'tier-tint';
  return '';
}
---

<div id="view-home">
  <section class="hero">
    <div class="hero-field"></div>
    <div class="hero-seam"></div>
    <div class="page hero-grid">
      <div class="hero-copy">
        <p class="hero-kicker">{t.hero.eyebrow}</p>
        <h1>{t.hero.title}</h1>
        <p class="dek">{t.hero.dek}</p>

        <div class="hero-actions">
          <div class="hero-magnet">
            <div class="hero-magnet-inner">
              <ContactSwitch lang={lang} triggerClass="btn-volume" origen="home_hero" />
            </div>
          </div>
        </div>

        <p class="trust">{t.hero.trust}</p>
      </div>

      <div class="hero-visual">
        <div class="hero-dot hero-dot-a"><span></span></div>
        <div class="hero-dot hero-dot-b"><span></span></div>
        <div class="hero-dot hero-dot-c"><span></span></div>

        <div class="hero-ticket-wrap">
          <div class="hero-ticket">
            <span class="hero-ticket-pip"></span>
            <span class="hero-price-label">{t.hero.priceLabel}</span>
            <span class="hero-price-amount"><span data-countup>{t.hero.priceAmount}</span><small>{t.hero.priceUnit}</small></span>
            <p class="hero-price-claim">{t.hero.priceClaim}</p>
          </div>
        </div>

        <div class="hero-magnet">
          <div class="hero-magnet-inner">
            <a href={localizedPath('/simulador', lang)} class="btn-circle">{t.hero.ctaSim}</a>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-scroll-cue" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"></path></svg>
    </div>
  </section>

  <div class="sim-embed" id="simulador">
    <Simulador lang={lang} embedded />
  </div>

  <section class="section" id="como-trabajamos">
    <div class="label-col"><p class="eyebrow">{t.proceso.eyebrow}</p></div>
    <div>
      <h2 class="section-title">{t.proceso.title}</h2>
      <div class="process">
        {t.proceso.steps.map((step, i) => (
          <div class="step">
            <span class="num">{i + 1}</span>
            <div><h3>{step.title}</h3><p>{step.desc}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="diferencia">
    <div class="label-col"><p class="eyebrow">{t.diferencia.eyebrow}</p></div>
    <div>
      <h2 class="section-title">{t.diferencia.title}</h2>
      <p class="section-sub">{t.diferencia.sub}</p>
      <div class="compare-table">
        <div class="cell cell-head col-trad">{t.diferencia.colTraditional}</div>
        <div class="cell cell-head col-online">{t.diferencia.colOnline}</div>
        <div class="cell cell-head col-madal">{t.diferencia.colMadal}</div>
        {t.diferencia.rows.map((row) => (
          <>
            <div class="cell col-trad">{row.trad}</div>
            <div class="cell col-online">{row.online}</div>
            <div class="cell col-madal">{row.madal}</div>
          </>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="precios">
    <div class="label-col"><p class="eyebrow">{t.precios.eyebrow}</p></div>
    <div>
      <h2 class="section-title">{t.precios.title}</h2>
      <p class="section-sub">{t.precios.sub}</p>

      <p class="pricing-group-title">{t.precios.autonomoTitle}</p>
      <div class="pricing-tiers">
        {t.precios.autonomoTiers.map((tier, i) => (
          <div class={`pricing-tier ${tierTintClass(i, t.precios.autonomoTiers.length)}`}>
            <h3>{tier.name}</h3>
            <p class="pricing-tier-desc">{tier.desc}</p>
            <p class="amount"><span data-countup>{tier.amount}</span><small>{tier.unit}</small></p>
            <p class="pricing-tier-iva">{tier.ivaNote}</p>
            {'durationNote' in tier && tier.durationNote && <p class="pricing-tier-duration">{tier.durationNote}</p>}
            {'includesPrevious' in tier && tier.includesPrevious && <p class="pricing-tier-includes">{tier.includesPrevious}</p>}
            <ul class="finanzas-preview-list pricing-tier-features">
              {tier.features.map((f) => (<li>{f}</li>))}
            </ul>
            {'transitionNote' in tier && tier.transitionNote && <p class="pricing-tier-transition">{tier.transitionNote}</p>}
            {'dashboardNote' in tier && tier.dashboardNote && <p class="pricing-tier-dashboard">{tier.dashboardNote}</p>}
          </div>
        ))}
      </div>
      <div class="pricing-footnotes">
        {t.precios.autonomoFootnotes.map((f) => (<p>{f}</p>))}
      </div>

      <p class="pricing-group-title">{t.precios.pymeTitle}</p>
      <div class="pricing-tiers">
        {t.precios.pymeTiers.map((tier, i) => (
          <div class={`pricing-tier ${tierTintClass(i, t.precios.pymeTiers.length)}`}>
            <h3>{tier.name}</h3>
            <p class="pricing-tier-desc">{tier.desc}</p>
            <p class="amount"><span data-countup>{tier.amount}</span><small>{tier.unit}</small></p>
            <p class="pricing-tier-iva">{tier.ivaNote}</p>
            {'includesPrevious' in tier && tier.includesPrevious && <p class="pricing-tier-includes">{tier.includesPrevious}</p>}
            <ul class="finanzas-preview-list pricing-tier-features">
              {tier.features.map((f) => (<li>{f}</li>))}
            </ul>
            {'dashboardNote' in tier && tier.dashboardNote && <p class="pricing-tier-dashboard">{tier.dashboardNote}</p>}
          </div>
        ))}
      </div>
      <div class="pricing-footnotes">
        {t.precios.pymeFootnotes.map((f) => (<p>{f}</p>))}
      </div>

      <p class="price-note">{t.precios.note}</p>

      <div class="alta-box">
        <div class="copy">
          <h3>{t.alta.title}</h3>
          <p>{t.alta.desc}</p>
          <a href={localizedPath('/simulador', lang)} class="alta-link">{t.alta.link}</a>
        </div>
        <div>
          <p class="price"><span data-countup>{t.alta.price}</span><br /><small>{t.alta.priceNote}</small></p>
        </div>
      </div>

      <div class="blog-teaser">
        {latestPost ? (
          <p>
            <span class="blog-teaser-label">{t.blogTeaser.latestLabel}</span>
            <a href={localizedPath(`/blog/${latestPost.data.slug}`, lang)}>{latestPost.data.title}</a>
          </p>
        ) : (
          <p>{t.blogTeaser.text}</p>
        )}
        <a class="blog-teaser-all" href={localizedPath('/blog', lang)}>{t.blogTeaser.link}</a>
      </div>
    </div>
  </section>
</div>

<script>
  import { observeCountUp } from '../../scripts/countup';
  import { initHeroInteractions } from '../../scripts/heroInteractions';
  document.addEventListener('astro:page-load', () => {
    observeCountUp();
    initHeroInteractions();
  });
</script>
