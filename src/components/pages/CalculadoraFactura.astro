---
// Calculadora de factura con IVA y retención de IRPF (2026-11-14). Dos modos:
//  - base: el usuario pone la base imponible.
//  - cobro: pone lo que quiere recibir del cliente; base = cobro / (1 + IVA - retención).
// Todo se calcula en el navegador; no se envía nada.
import type { Locale } from '../../i18n/ui';
import { HERRAMIENTAS } from '../../i18n/herramientas';
import HerramientaShell from '../herramientas/HerramientaShell.astro';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const f = HERRAMIENTAS[lang].factura;
const locale = { es: 'es-ES', ca: 'ca-ES', en: 'en-GB' }[lang];
---

<HerramientaShell lang={lang} title={f.title} dek={f.dek} info={f.info} infoTitle={f.infoTitle} herramienta="factura">
  <div class="hr-calc" id="calc-factura" data-locale={locale}>
    <form class="hr-form">
      <fieldset class="hr-campo">
        <legend>{f.modo}</legend>
        <div class="hr-segmentos">
          {f.modos.map((m, i) => (
            <label><input type="radio" name="modo" value={m.v} checked={i === 0} /><span>{m.t}</span></label>
          ))}
        </div>
      </fieldset>
      <label class="hr-campo">
        <span>{f.importe}</span>
        <input type="number" name="importe" inputmode="decimal" min="0" step="0.01" value="1000" />
      </label>
      <label class="hr-campo">
        <span>{f.iva}</span>
        <select name="iva">{f.ivas.map((o) => <option value={o.v}>{o.t}</option>)}</select>
      </label>
      <label class="hr-campo">
        <span>{f.ret}</span>
        <select name="ret">{f.rets.map((o) => <option value={o.v}>{o.t}</option>)}</select>
      </label>
      <label class="hr-campo" data-otro hidden>
        <span>{f.otro}</span>
        <input type="number" name="otro" inputmode="decimal" min="0" max="50" step="0.5" value="19" />
      </label>
    </form>
    <div class="hr-resultado" aria-live="polite">
      <dl>
        <div><dt>{f.base}</dt><dd data-r="base">–</dd></div>
        <div><dt>{f.cuotaIva} <span data-r="ivaPct"></span></dt><dd data-r="iva">–</dd></div>
        <div><dt>{f.retencion} <span data-r="retPct"></span></dt><dd data-r="ret">–</dd></div>
        <div class="hr-total"><dt>{f.total}</dt><dd data-r="total">–</dd></div>
        <div class="hr-destacado"><dt>{f.cobras}</dt><dd data-r="cobro">–</dd></div>
      </dl>
      <p class="hr-explica">{f.explicaIva}</p>
      <p class="hr-explica">{f.explicaRet}</p>
    </div>
  </div>
</HerramientaShell>

<script>
  import { track } from '../../scripts/analytics';
  function init() {
    const raiz = document.getElementById('calc-factura');
    if (!raiz || raiz.dataset.listo) return;
    raiz.dataset.listo = '1';
    const form = raiz.querySelector('form') as HTMLFormElement;
    const eur = new Intl.NumberFormat(raiz.dataset.locale, { style: 'currency', currency: 'EUR' });
    const pct = (n: number) => `(${n.toLocaleString(raiz.dataset.locale)} %)`;
    const out = (k: string, v: string) => { const el = raiz.querySelector(`[data-r="${k}"]`); if (el) el.textContent = v; };
    const otroCampo = raiz.querySelector('[data-otro]') as HTMLElement;
    let usado = false;
    const calcular = () => {
      const d = new FormData(form);
      const importe = Math.max(0, Number(d.get('importe')) || 0);
      const iva = Number(d.get('iva')) / 100;
      const retSel = String(d.get('ret'));
      otroCampo.hidden = retSel !== 'otro';
      const ret = Math.min(50, Math.max(0, retSel === 'otro' ? Number(d.get('otro')) || 0 : Number(retSel))) / 100;
      const base = d.get('modo') === 'cobro' ? importe / (1 + iva - ret) : importe;
      const r2 = (n: number) => Math.round(n * 100) / 100;
      const cuotaIva = r2(base * iva);
      const cuotaRet = r2(base * ret);
      const b = r2(base);
      out('base', eur.format(b));
      out('iva', eur.format(cuotaIva));
      out('ret', cuotaRet ? '−' + eur.format(cuotaRet) : eur.format(0));
      out('ivaPct', pct(iva * 100));
      out('retPct', pct(ret * 100));
      out('total', eur.format(r2(b + cuotaIva)));
      out('cobro', eur.format(r2(b + cuotaIva - cuotaRet)));
    };
    form.addEventListener('submit', (e) => e.preventDefault());
    form.addEventListener('input', () => {
      calcular();
      if (!usado) { usado = true; track('herramienta_uso', { herramienta: 'factura' }); }
    });
    calcular();
  }
  document.addEventListener('astro:page-load', init);
</script>
