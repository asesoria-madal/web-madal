---
// Portal de clientes. Login por enlace mágico (Supabase Auth), sin
// contraseña. Toda la lógica corre en el navegador: el acceso a los datos
// lo protege RLS en la base de datos, no este código.
//
// La ficha del cliente en la tabla `clientes` se vincula por email (no por
// el id interno de Supabase Auth): así se puede dar de alta a un cliente
// con solo su email, antes incluso de que haya iniciado sesión por primera
// vez. Ver el SQL de configuración en la memoria del proyecto.
//
// Disponible en es/ca/en: los textos vienen de ui.ts (t.portal). Los que
// necesita el <script> del navegador viajan en el <script type="application/json">
// del final; las fechas e importes se formatean con `locale` (data-locale).
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';
import { WHATSAPP_NUMBER, CONTACT_EMAIL } from '../../lib/contact';
import CarpetaDocumentos from '../CarpetaDocumentos.astro';
import { guiaApoderamientoAeat, guiaApoderamientoSs, guiaExportarCertificado } from '../../lib/guias';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useTranslations(lang).portal;

const localeTag: Record<Locale, string> = { es: 'es-ES', ca: 'ca-ES', en: 'en-GB' };
const locale = localeTag[lang];

const EMAIL = CONTACT_EMAIL;

// Carpetas de la pestaña Documentación. Los códigos se guardan en
// facturas_subidas.carpeta y los usa n8n para decidir la carpeta de Drive
// (ver schema.sql). "banco", "tarjeta", "escrituras" y "prestamos" solo se ofrecen a las SL
// (los oculta el script, ver SOLO_SL).
const CARPETAS_CONTABILIDAD = ['emitidas', 'recibidas', 'simplificadas', 'tickets', 'banco', 'tarjeta'] as const;
const CARPETAS_DOCUMENTACION = ['escrituras', 'contratos', 'prestamos', 'seguros', 'vehiculos', 'subvenciones', 'notificaciones', 'certificados', 'laboral', 'otros'] as const;
const textosCarpeta = { subir: t.doc.subir, foto: t.facturas.cameraSubmit, ver: t.doc.verArchivos, desde: t.doc.desde, hasta: t.doc.hasta };

---

<div class="portal-page" data-locale={locale}>
  <p class="eyebrow">{t.eyebrow}</p>
  <h1 class="section-title">{t.title}</h1>

  <div class="portal-box">
    <div id="portal-loading">
      <p>{t.loading}</p>
    </div>

    <div id="portal-unconfigured" hidden>
      <p>{t.unconfiguredPre}<a href={`mailto:${EMAIL}`}>{EMAIL}</a>{t.unconfiguredPost}</p>
    </div>

    <!-- Correo y contraseña (2026-11-17, Edurne). "¿Has olvidado tu contraseña?" y "Entrar sin
         contraseña" piden un correo a api/portal-login (lo envía n8n en el idioma del cliente). -->
    <form id="portal-login-form" hidden class="portal-form-wrap">
      <p>{t.loginIntro}</p>
      <div class="portal-login-campos">
        <label class="portal-campo">{t.emailLabel}
          <input type="email" id="portal-email" name="email" placeholder={t.emailPlaceholder} required autocomplete="username" />
        </label>
        <label class="portal-campo">{t.passwordLabel}
          <input type="password" id="portal-password" name="password" required autocomplete="current-password" />
        </label>
        <button type="submit" class="btn btn-primary">{t.loginSubmit}</button>
      </div>
      <div class="portal-login-alt">
        <button type="button" id="portal-olvido" class="portal-link-btn">{t.forgot}</button>
        <button type="button" id="portal-sin-contrasena" class="portal-link-btn">{t.noPassword}</button>
      </div>
      <p id="portal-login-msg" class="portal-msg" hidden></p>
    </form>

    <!-- Elegir contraseña: al llegar con el enlace de "crea tu contraseña" o "¿has olvidado…?". -->
    <!-- El campo de correo (oculto) es para el gestor de contraseñas del navegador: sin él, Chrome guardaba la nueva
         sin asociarla a la cuenta y al entrar rellenaba la antigua ("la contraseña no es correcta", 2026-11-21). -->
    <form id="portal-password-form" hidden class="portal-form-wrap" action="#" method="post">
      <p>{t.newPasswordIntro}</p>
      <input type="email" id="portal-password-user" name="username" autocomplete="username" readonly hidden />
      <div class="portal-login-campos">
        <label class="portal-campo">{t.newPassword}
          <input type="password" id="portal-new-password" name="new-password" minlength="8" required autocomplete="new-password" />
        </label>
        <label class="portal-campo">{t.repeatPassword}
          <input type="password" id="portal-new-password-2" name="new-password-2" minlength="8" required autocomplete="new-password" />
        </label>
        <button type="submit" class="btn btn-primary">{t.savePassword}</button>
      </div>
      <p id="portal-password-msg" class="portal-msg" hidden></p>
    </form>

    <div id="portal-unlinked" hidden>
      <p>{t.unlinkedPre}<a href={`mailto:${EMAIL}`}>{EMAIL}</a>{t.unlinkedPost}</p>
      <button type="button" id="portal-logout-1" class="portal-logout">{t.logout}</button>
    </div>

    <div id="portal-dash" class="portal-dash" hidden>
      <div class="app-shell">
        <aside class="app-sidebar">
          <a href="/" class="wordmark">Asesoría<span>Madal</span></a>
          <nav class="app-nav">
            <button type="button" class="app-nav-link active" data-panel="prevision">{t.nav.prevision}</button>
            <button type="button" class="app-nav-link" data-panel="informes">{t.nav.informes}</button>
            <button type="button" class="app-nav-link" data-panel="documentos">{t.nav.documentos}</button>
            <button type="button" class="app-nav-link" data-panel="misfacturas">{t.nav.misFacturas}</button>
            <button type="button" class="app-nav-link" data-panel="documentacion">{t.nav.documentacion}</button>
            <button type="button" class="app-nav-link" data-panel="inicio" hidden>{t.nav.inicio}</button>
          </nav>
          <div class="app-sidebar-foot">
            <div id="duda-rapida" class="duda-rapida">
              <p class="duda-rapida-label">{t.dudaRapida.label}</p>
              <a
                id="duda-rapida-whatsapp"
                class="duda-rapida-link duda-rapida-whatsapp"
                href={`https://wa.me/${WHATSAPP_NUMBER}`}
                target="_blank"
                rel="noopener noreferrer"
                hidden
              >
                {t.dudaRapida.whatsapp}
              </a>
              <a class="duda-rapida-link" href={`mailto:${EMAIL}`}>{t.dudaRapida.email}</a>
            </div>
            <span class="app-saludo">{t.greeting} <span id="portal-nombre"></span></span>
            <div class="app-lang" aria-label={t.langLabel}>
              <a href="/portal" class={lang === 'es' ? 'active' : ''} hreflang="es">ES</a>
              <a href="/ca/portal" class={lang === 'ca' ? 'active' : ''} hreflang="ca">CA</a>
              <a href="/en/portal" class={lang === 'en' ? 'active' : ''} hreflang="en">EN</a>
            </div>
            <button type="button" id="portal-logout-2" class="portal-logout">{t.logout}</button>
          </div>
        </aside>

        <div class="app-main">
          <div id="portal-admin-bar" class="portal-admin-bar" hidden>
            <span class="portal-admin-tag">
              {t.admin.bannerPrefix} <strong id="portal-admin-cliente-nombre"></strong>
            </span>
            <label class="portal-admin-select">
              <span>{t.admin.selectLabel}</span>
              <select id="portal-admin-cliente-select"></select>
            </label>
            <span class="portal-admin-note">{t.admin.readonlyNote}</span>
            <button type="button" id="portal-alta-toggle" class="btn btn-primary portal-alta-toggle">{t.admin.alta.open}</button>
          </div>

          <form id="portal-alta-form" class="portal-alta-form" hidden novalidate>
            <div class="portal-alta-grid">
              <label>{t.admin.alta.nif}
                <input type="text" id="alta-nif" maxlength="12" autocomplete="off" />
              </label>
              <label>{t.admin.alta.nombre}
                <input type="text" id="alta-nombre" required maxlength="150" autocomplete="off" />
              </label>
              <label>{t.admin.alta.empresa}
                <input type="text" id="alta-empresa" maxlength="150" autocomplete="off" />
              </label>
              <label>{t.admin.alta.email}
                <input type="email" id="alta-email" maxlength="254" autocomplete="off" />
              </label>
              <label>{t.admin.alta.telefono}
                <input type="tel" id="alta-telefono" maxlength="20" autocomplete="off" />
              </label>
              <label>{t.admin.alta.idioma}
                <select id="alta-idioma">
                  <option value="es">Español</option>
                  <option value="ca">Català</option>
                  <option value="en">English</option>
                </select>
              </label>
              <label>{t.admin.alta.plan}
                <select id="alta-plan">
                  <option value="">{t.admin.alta.planSinDefinir}</option>
                  <option value="debut">Debut</option>
                  <option value="esencial">Esencial</option>
                  <option value="crece">Crece</option>
                  <option value="total">Total</option>
                  <option value="sl">SL</option>
                </select>
              </label>
              <label>{t.admin.alta.tipo}
                <select id="alta-tipo">
                  <option value="autonomo">{t.admin.alta.tipoAutonomo}</option>
                  <option value="sl">{t.admin.alta.tipoSl}</option>
                </select>
              </label>
              <label id="alta-tramitamos-wrap">{t.admin.alta.tramitamos}
                <select id="alta-tramitamos">
                  <option value="si">{t.admin.alta.tramitamosSi}</option>
                  <option value="no">{t.admin.alta.tramitamosNo}</option>
                </select>
              </label>
              <label class="portal-alta-check">
                <input type="checkbox" id="alta-reporting" /> {t.admin.alta.reporting}
              </label>
              <label class="portal-alta-check">
                <input type="checkbox" id="alta-formulario" checked /> {t.admin.alta.enviarFormulario}
              </label>
            </div>
            <button type="submit" class="btn btn-primary" id="alta-submit">{t.admin.alta.submit}</button>
            <p id="alta-msg" class="portal-msg" hidden></p>
            <!-- Enlace del formulario ya personalizado (NIF + email), para mandarlo en un
                 correo propio cuando se desmarca el correo automático del formulario. -->
            <div id="alta-enlace" class="portal-alta-enlace" hidden>
              <label for="alta-enlace-url">{t.admin.alta.enlaceLabel}</label>
              <div class="portal-alta-enlace-row">
                <input type="text" id="alta-enlace-url" readonly />
                <button type="button" class="btn" id="alta-enlace-copiar">{t.admin.alta.copiar}</button>
              </div>
            </div>
          </form>

          <!-- Programa de facturación de Cegid (2026-11-21, Edurne): solo para quien lo tiene activado (casilla de la Empresa
               en HubSpot "Programa de facturación activado" → clientes.facturacion_cegid). Las facturas NO se suben a Cegid:
               se suben a nuestro portal. El iframe se carga solo si toca. -->
          <section class="app-panel" data-panel="inicio" hidden>
            <h2>{t.portalExterno.title}</h2>
            <p>{t.portalExterno.desc}</p>
            <iframe id="cegid-frame" class="portal-externo-frame" data-src="https://portal.portaldespacho.com/acceso/frame" width="220" height="180" title={t.portalExterno.title}></iframe>
          </section>

          <!-- Informes (2026-11-21): los calcula n8n ("Informes del portal") con los datos de Cegid al pedirlos. -->
          <section class="app-panel app-panel-ancho" data-panel="informes" hidden>
            <h2>{t.informes.title}</h2>
            <p>{t.informes.intro}</p>
            <p id="inf-sin-conta" class="pf-estado" hidden>{t.informes.sinConta}</p>
            <form id="inf-form" class="inf-form">
              <label>{t.informes.informe}<select id="inf-tipo"></select></label>
              <label id="inf-l-desde">{t.informes.desde}<input type="date" id="inf-desde" required /></label>
              <label><span id="inf-t-hasta">{t.informes.hasta}</span><input type="date" id="inf-hasta" required /></label>
              <label id="inf-l-cuenta" hidden>{t.informes.cuenta}<input id="inf-cuenta" inputmode="numeric" placeholder={t.informes.cuentaPh} /></label>
              <button type="submit" class="inf-generar">{t.informes.generar}</button>
            </form>
            <p id="inf-nota" class="pf-aviso" hidden>{t.informes.notaAutonomo}</p>
            <p id="inf-estado" class="pf-estado" aria-live="polite"></p>
            <div id="inf-resultado" hidden>
              <div class="inf-cabecera">
                <div><h3 id="inf-titulo"></h3><p id="inf-subtitulo" class="pf-estado"></p></div>
                <div class="inf-botones"><button type="button" id="inf-csv" class="pf-descargar">{t.informes.csv}</button><button type="button" id="inf-imprimir" class="pf-descargar">{t.informes.imprimir}</button></div>
              </div>
              <div class="mf-tabla-caja"><table class="mf-tabla inf-tabla"><thead><tr id="inf-cols"></tr></thead><tbody id="inf-filas"></tbody></table></div>
              <p id="inf-notas" class="pf-aviso"></p>
            </div>
          </section>

          <!-- Previsión fiscal (2026-11-20): la calcula cada noche n8n ("Previsión fiscal") con los datos de
               Cegid y la guarda en prevision_fiscal; aquí solo se lee el trimestre en curso. -->
          <section class="app-panel app-panel-ancho" data-panel="prevision">
            <h2>{t.prevision.title}</h2>
            <div class="pf-layout">
            <div class="pf-main">
            <div class="mf-tabs" role="tablist">
              <button type="button" class="pf-tab is-active" data-pf-vista="actual" role="tab">{t.prevision.tabActual} <span id="pf-periodo" class="pf-periodo"></span></button>
              <button type="button" class="pf-tab" data-pf-vista="modelos" role="tab">{t.prevision.tabModelos}</button>
            </div>
            <div id="pf-vista-actual">
              <p>{t.prevision.intro}</p>
              <p id="pf-estado" class="pf-estado"></p>
              <div id="pf-modelos" class="pf-modelos"></div>
              <p id="pf-total" class="pf-total" hidden></p>
            </div>
            <!-- Modelos presentados (2026-11-20): copia de las hojas de "Impuestos trimestrales" (tabla modelos_fiscales). -->
            <div id="pf-vista-modelos" hidden>
              <p>{t.prevision.modelosIntro}</p>
              <p id="pf-modelos-vacio" class="pf-estado" hidden>{t.prevision.modelosVacio}</p>
              <div class="mf-filtros" id="pf-filtros" hidden>
                <label>{t.prevision.cols.anio}<select id="pf-f-anio"></select></label>
                <label>{t.prevision.cols.modelo}<select id="pf-f-modelo"></select></label>
                <label>{t.prevision.cols.estado}<select id="pf-f-estado"></select></label>
              </div>
              <div class="mf-tabla-caja" id="pf-tabla-caja" hidden>
                <table class="mf-tabla pf-tabla">
                  <thead><tr><th>{t.prevision.cols.anio}</th><th>{t.prevision.cols.periodo}</th><th>{t.prevision.cols.modelo}</th><th class="num">{t.prevision.cols.importe}</th><th>{t.prevision.cols.estado}</th><th>{t.prevision.cols.descargar}</th></tr></thead>
                  <tbody id="pf-filas"></tbody>
                </table>
              </div>
            </div>
            </div>
            <aside class="pf-lateral">
              <p>{t.prevision.aviso}</p>
              <p>{t.prevision.otraInfoPre}<a href={`mailto:${EMAIL}`}>{EMAIL}</a>{t.prevision.otraInfoPost}</p>
            </aside>
            </div>
          </section>

          <!-- Mis documentos (2026-11-12): cada carpeta es una tarjeta visible con su botón de
               subir. El código de la carpeta va a facturas_subidas.carpeta y n8n ("Descarga de
               facturas") decide con él dónde se guarda en Drive. Ver schema.sql. -->
          <section class="app-panel" data-panel="documentos" hidden>
            <h2>{t.doc.misTitulo}</h2>
            <p>{t.doc.misIntro}</p>
            <p id="docAdminNota" class="portal-msg" hidden>{t.doc.adminNota}</p>
            <input type="file" id="facturaFile" accept="application/pdf,image/jpeg,image/png,image/webp" multiple hidden aria-label={t.doc.subir} />
            <input type="file" id="facturaCamera" accept="image/*,.heic,.heif" capture="environment" hidden aria-label={t.facturas.cameraSubmit} />

            <h3 class="doc-grupo">{t.doc.grupoContabilidad}</h3>
            <div class="doc-carpetas">
              {CARPETAS_CONTABILIDAD.map((c) => (
                <CarpetaDocumentos codigo={c} nombre={t.doc.carpetas[c]} extracto={c === 'banco' || c === 'tarjeta'}
                  textos={{ ...textosCarpeta, digitos: c === 'tarjeta' ? t.doc.digitosTarjeta : t.doc.digitosBanco, nota: c === 'tarjeta' ? t.doc.tarjetaNota : undefined }} />
              ))}
              <CarpetaDocumentos codigo="sinCarpeta" nombre={t.doc.carpetas.sinCarpeta} textos={textosCarpeta} soloLista />
            </div>

            <h3 class="doc-grupo">{t.doc.grupoDocumentacion}</h3>
            <div class="doc-carpetas">
              {CARPETAS_DOCUMENTACION.map((c) => <CarpetaDocumentos codigo={c} nombre={t.doc.carpetas[c]} textos={textosCarpeta} />)}
            </div>
          </section>

          <!-- Mis facturas (2026-11-17): cada factura o ticket subido con lo que se ha leído de él y
               su estado (Recibida, En revisión, Contabilizada o No contabilizada con el motivo).
               Datos: facturas_subidas + facturas_lectura (RLS: el cliente solo ve las suyas). -->
          <section class="app-panel" data-panel="misfacturas" hidden>
            <h2>{t.misFacturas.title}</h2>
            <p>{t.misFacturas.intro}</p>
            <div class="mf-tabs" role="tablist">
              <button type="button" class="mf-tab is-active" data-mf-tipo="recibida" role="tab">{t.misFacturas.recibidas}</button>
              <button type="button" class="mf-tab" data-mf-tipo="emitida" role="tab">{t.misFacturas.emitidas}</button>
            </div>
            <div class="mf-filtros">
              <label>{t.misFacturas.trimestre}<select id="mf-trimestre"><option value="">{t.misFacturas.todos}</option></select></label>
              <label class="mf-buscar">{t.misFacturas.buscar}<input type="search" id="mf-buscar" placeholder={t.misFacturas.buscarPh} /></label>
            </div>
            <div class="mf-totales" id="mf-totales"></div>
            <div class="mf-tabla-caja">
              <table class="mf-tabla">
                <thead>
                  <tr>
                    <th>{t.misFacturas.cols.ref}</th><th id="mf-col-tercero">{t.misFacturas.cols.proveedor}</th><th>{t.misFacturas.cols.fecha}</th><th>{t.misFacturas.cols.fechaCont}</th>
                    <th class="num">{t.misFacturas.cols.base}</th><th class="num">{t.misFacturas.cols.iva}</th><th class="num">{t.misFacturas.cols.ret}</th><th class="num">{t.misFacturas.cols.total}</th>
                    <th>{t.misFacturas.cols.estado}</th><th><span class="sr-only">{t.misFacturas.cols.descargar}</span></th>
                  </tr>
                </thead>
                <tbody id="mf-filas"></tbody>
              </table>
            </div>
            <p id="mf-vacio" class="mf-nota" hidden>{t.misFacturas.vacio}</p>
            <p class="mf-nota">{t.misFacturas.leyenda}</p>
          </section>

          <!-- Documentos de Asesoría Madal: guía, presentación, apoderamiento y RGPD. Separados
               de "Mis documentos" a petición de Edurne (2026-11-12). -->
          <section class="app-panel" data-panel="documentacion" hidden>
            <h2>{t.doc.grupoNuestros}</h2>

            <div class="field-group">
              <p class="field-group-label">{t.doc.guiaGroup}</p>
              <ul class="doc-list">
                <li>
                  <a href="https://suslwmgqdzingeqhfrpw.supabase.co/storage/v1/object/public/docs-publicos/Guia_Area_Clientes.pdf" target="_blank" rel="noopener">
                    {t.doc.guiaLink}
                  </a>
                </li>
              </ul>
            </div>

            <div class="field-group">
              <p class="field-group-label">{t.doc.presentacionGroup}</p>
              <ul id="doc-presentacion-autonomo" class="doc-list" hidden>
                <li>
                  <a href="https://suslwmgqdzingeqhfrpw.supabase.co/storage/v1/object/public/docs-publicos/Presentacion_Autonomos.pdf" target="_blank" rel="noopener">
                    {t.doc.presentacionAutonomo}
                  </a>
                </li>
              </ul>
              <ul id="doc-presentacion-sl" class="doc-list" hidden>
                <li>
                  <a href="https://suslwmgqdzingeqhfrpw.supabase.co/storage/v1/object/public/docs-publicos/Presentacion_SL.pdf" target="_blank" rel="noopener">
                    {t.doc.presentacionSl}
                  </a>
                </li>
              </ul>
              <p id="doc-presentacion-pendiente" class="field-hint" hidden>
                {t.doc.presentacionPendientePre}<a href={`mailto:${EMAIL}`}>{EMAIL}</a>{t.doc.presentacionPendientePost}
              </p>
            </div>

            {/* Apoderamiento: solo autónomos; a una SL le pedimos siempre el certificado digital
                (Edurne, 2026-11-15). Oculto hasta saber el tipo de cliente. Guías en el idioma del portal. */}
            <div id="doc-apoderamiento" class="field-group" hidden>
              <p class="field-group-label">{t.doc.apoderamientoGroup}</p>
              <ul class="doc-list">
                <li>
                  <a href={guiaApoderamientoAeat(lang)} target="_blank" rel="noopener">
                    {t.doc.apoderamientoAeat}
                  </a>
                </li>
                <li>
                  <a href={guiaApoderamientoSs(lang)} target="_blank" rel="noopener">
                    {t.doc.apoderamientoSs}
                  </a>
                </li>
              </ul>
            </div>

            <div class="field-group">
              <p class="field-group-label">{t.doc.certificadoGroup}</p>
              <ul class="doc-list">
                <li>
                  <a href={guiaExportarCertificado(lang)} target="_blank" rel="noopener">
                    {t.doc.certificadoLink}
                  </a>
                </li>
              </ul>
            </div>

            <div class="field-group">
              <p class="field-group-label">{t.doc.rgpdGroup}</p>
              <ul class="doc-list">
                <li>
                  <a href="https://suslwmgqdzingeqhfrpw.supabase.co/storage/v1/object/public/docs-publicos/RGPD.pdf" target="_blank" rel="noopener">
                    {t.doc.rgpdLink}
                  </a>
                </li>
              </ul>
            </div>
          </section>
        </div>
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="portal-i18n" is:inline set:html={JSON.stringify(t)} />

<style>
  .app-lang { display: flex; gap: 0.35rem; margin: 0.15rem 0 0.1rem; }
  .app-lang a {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--ink-soft);
    text-decoration: none;
    padding: 0.1rem 0.32rem;
    border-radius: 6px;
  }
  .app-lang a:hover { color: var(--ink); }
  .app-lang a.active {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .portal-externo-frame { border: none; border-radius: 6px; display: block; margin-top: 0.75rem; }

  .portal-admin-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.1rem;
    padding: 0.7rem 1rem;
    margin-bottom: 1.4rem;
    border: 1px solid var(--accent);
    border-radius: 10px;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    font-size: 0.9rem;
  }
  .portal-admin-tag { font-weight: 600; }
  .portal-admin-select { display: flex; align-items: center; gap: 0.4rem; }
  .portal-admin-select select {
    padding: 0.32rem 0.5rem;
    border-radius: 6px;
    border: 1px solid var(--accent);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    max-width: 60vw;
  }
  .portal-admin-note { color: var(--ink-soft); font-size: 0.8rem; }
  .portal-alta-toggle { margin-left: auto; padding: 0.4rem 0.9rem; font-size: 0.85rem; }
  .portal-alta-form {
    display: grid;
    gap: 1rem;
    padding: 1rem;
    margin: -0.6rem 0 1.4rem;
    border: 1px solid var(--accent);
    border-radius: 10px;
  }
  .portal-alta-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 0.75rem 1rem; }
  .portal-alta-form label { display: grid; gap: 0.25rem; font-size: 0.85rem; color: var(--ink-soft); }
  .portal-alta-form input[type='text'],
  .portal-alta-form input[type='email'],
  .portal-alta-form select {
    padding: 0.45rem 0.6rem;
    border-radius: 6px;
    border: 1px solid var(--accent);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
  }
  .portal-alta-form .portal-alta-check { display: flex; align-items: center; gap: 0.5rem; align-self: end; }
  .portal-alta-form button[type='submit'] { justify-self: start; }
  .portal-alta-enlace { display: grid; gap: 0.35rem; }
  .portal-alta-enlace[hidden] { display: none; }
  .portal-alta-enlace-row { display: flex; gap: 0.5rem; }
  .portal-alta-enlace-row input { flex: 1; min-width: 0; font-size: 0.85rem; }
  .portal-alta-enlace-row button { padding: 0.4rem 0.9rem; font-size: 0.85rem; }

  /* Mis documentos: una tarjeta por carpeta (CarpetaDocumentos.astro). Estilos globales
     (:global) porque los elementos vienen de otro componente. */
  .doc-grupo { font-size: 1.05rem; margin: 1.8rem 0 0.8rem; }
  .doc-carpetas { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr)); gap: 0.8rem; }
  :global(.doc-carpeta) {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--paper-raised);
  }
  :global(.doc-carpeta[hidden]) { display: none; }
  :global(.doc-carpeta-cab) { display: flex; justify-content: space-between; align-items: baseline; gap: 0.6rem; }
  :global(.doc-carpeta-nombre) { font-weight: 600; font-size: 0.95rem; color: var(--ink); }
  :global(.doc-carpeta-n) {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-tint);
    border-radius: 999px;
    padding: 0.05rem 0.55rem;
  }
  :global(.doc-carpeta-nota) { font-size: 0.82rem; color: var(--ink-soft); margin: 0; }
  :global(.doc-extracto) { display: flex; flex-wrap: wrap; gap: 0.5rem 0.75rem; }
  :global(.doc-campo) { display: grid; gap: 0.2rem; font-size: 0.8rem; color: var(--ink-soft); }
  :global(.doc-campo input) {
    padding: 0.4rem 0.55rem;
    border-radius: 6px;
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: 0.88rem;
    max-width: 100%;
  }
  :global(.doc-campo input[data-digitos]) { width: 5.5rem; }
  :global(.doc-carpeta-botones) { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  :global(.doc-btn) { padding: 0.45rem 0.95rem; font-size: 0.85rem; }
  :global(.doc-carpeta-msg) { margin: 0; font-size: 0.85rem; }
  :global(.doc-carpeta-lista summary) { cursor: pointer; font-size: 0.85rem; color: var(--accent); font-weight: 600; }
  :global(.doc-carpeta-lista .factura-list) { margin-top: 0.6rem; }

</style>

<script>
  import { getSupabaseBrowser } from '../../lib/supabaseClient';
  import type { Session } from '@supabase/supabase-js';

  // Textos que necesita este script (viajan serializados desde el servidor,
  // ya en el idioma de la página) y locale para formatear fechas/importes.
  const I18N = JSON.parse(document.getElementById('portal-i18n')?.textContent || '{}');
  const LOCALE = (document.querySelector('.portal-page') as HTMLElement | null)?.dataset.locale || 'es-ES';

  function tpl(str: string, vars: Record<string, string | number>): string {
    return str.replace(/\{(\w+)\}/g, (_m, key) => String(vars[key] ?? ''));
  }

  const loadingEl = document.getElementById('portal-loading') as HTMLElement;
  const unconfiguredEl = document.getElementById('portal-unconfigured') as HTMLElement;
  const loginForm = document.getElementById('portal-login-form') as HTMLFormElement;
  const emailInput = document.getElementById('portal-email') as HTMLInputElement;
  const loginMsg = document.getElementById('portal-login-msg') as HTMLElement;
  const passwordInput = document.getElementById('portal-password') as HTMLInputElement;
  const olvidoBtn = document.getElementById('portal-olvido') as HTMLButtonElement;
  const sinContrasenaBtn = document.getElementById('portal-sin-contrasena') as HTMLButtonElement;
  const passwordForm = document.getElementById('portal-password-form') as HTMLFormElement;
  const newPass1 = document.getElementById('portal-new-password') as HTMLInputElement;
  const newPass2 = document.getElementById('portal-new-password-2') as HTMLInputElement;
  const passwordMsg = document.getElementById('portal-password-msg') as HTMLElement;
  // Enlace de los correos de acceso: Supabase deja el tipo en el fragmento (#...&type=recovery|invite|magiclink).
  // Se lee antes de crear el cliente de Supabase, que limpia el fragmento al recoger la sesión.
  // recovery ("¿has olvidado…?") e invite (primer acceso) llevan a elegir la contraseña.
  const TIPO_ENLACE = new URLSearchParams(window.location.hash.slice(1)).get('type');
  let pedirContrasena = TIPO_ENLACE === 'recovery' || TIPO_ENLACE === 'invite';
  const unlinkedEl = document.getElementById('portal-unlinked') as HTMLElement;
  const dashEl = document.getElementById('portal-dash') as HTMLElement;
  const nombreEl = document.getElementById('portal-nombre') as HTMLElement;
  const logoutBtn1 = document.getElementById('portal-logout-1') as HTMLButtonElement;
  const logoutBtn2 = document.getElementById('portal-logout-2') as HTMLButtonElement;

  const adminBar = document.getElementById('portal-admin-bar') as HTMLElement;
  const adminClienteSelect = document.getElementById('portal-admin-cliente-select') as HTMLSelectElement;
  const adminClienteNombre = document.getElementById('portal-admin-cliente-nombre') as HTMLElement;

  const dudaRapidaWhatsappEl = document.getElementById('duda-rapida-whatsapp') as HTMLAnchorElement;

  const docPresentacionAutonomoEl = document.getElementById('doc-presentacion-autonomo') as HTMLElement;
  const docPresentacionSlEl = document.getElementById('doc-presentacion-sl') as HTMLElement;
  const docPresentacionPendienteEl = document.getElementById('doc-presentacion-pendiente') as HTMLElement;
  const docApoderamientoEl = document.getElementById('doc-apoderamiento') as HTMLElement;

  const navLinks = Array.from(document.querySelectorAll<HTMLButtonElement>('.app-nav-link'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.app-panel'));

  // --- Mis documentos: carpetas (tarjetas CarpetaDocumentos) ---
  const facturaFile = document.getElementById('facturaFile') as HTMLInputElement;
  const facturaCamera = document.getElementById('facturaCamera') as HTMLInputElement;
  const docAdminNota = document.getElementById('docAdminNota') as HTMLElement;
  const carpetas = Array.from(document.querySelectorAll<HTMLElement>('.doc-carpeta[data-carpeta]'));
  const carpeta = (codigo: string) => carpetas.find((c) => c.dataset.carpeta === codigo)!;

  const ES_EXTRACTO = (c: string) => c === 'banco' || c === 'tarjeta';
  // Solo facturas y tickets se contabilizan (pasan por Pendientes en Drive).
  const SE_CONTABILIZA = (c: string) => ['emitidas', 'recibidas', 'simplificadas', 'tickets', 'sinCarpeta'].includes(c);

  // Carpeta en la que se está subiendo (la del botón pulsado) y, en extractos, sus datos.
  let carpetaActual = '';
  // Extractos de banco y tarjeta: solo los 4 últimos dígitos; sin fechas desde el 2026-11-14 (Edurne).
  let extractoActual: { cuenta_digitos: string } | null = null;

  function mensaje(codigo: string, texto: string, tipo: '' | 'is-ok' | 'is-error') {
    const el = carpeta(codigo).querySelector<HTMLElement>('[data-msg]')!;
    el.hidden = !texto;
    el.className = `portal-msg doc-carpeta-msg ${tipo}`.trim();
    el.textContent = texto;
  }

  // Carpetas solo para SL (Edurne, 2026-11-13): extractos bancarios y de tarjetas de crédito,
  // escrituras y préstamos/leasing. Los autónomos no las ven.
  const SOLO_SL = ['banco', 'tarjeta', 'escrituras', 'prestamos'];
  function ajustarCarpetas(tipoPersona: string | null) {
    SOLO_SL.forEach((c) => { carpeta(c).hidden = tipoPersona !== 'sl'; });
  }

  // Cada carpeta: "Subir" abre el selector de archivos y "Hacer foto", la cámara del móvil.
  // En extractos, antes de abrirlos se comprueban los 4 dígitos.
  carpetas.forEach((el) => {
    const codigo = el.dataset.carpeta!;
    const preparar = (): boolean => {
      carpetaActual = codigo;
      extractoActual = null;
      if (ES_EXTRACTO(codigo)) {
        const v = (s: string) => (el.querySelector<HTMLInputElement>(s)?.value ?? '').trim();
        extractoActual = { cuenta_digitos: v('[data-digitos]') };
        if (!/^\d{4}$/.test(extractoActual.cuenta_digitos)) {
          mensaje(codigo, I18N.doc.faltanDatosExtracto, 'is-error');
          return false;
        }
      }
      mensaje(codigo, '', '');
      return true;
    };
    el.querySelector('[data-subir]')?.addEventListener('click', () => { if (preparar()) facturaFile.click(); });
    el.querySelector('[data-foto]')?.addEventListener('click', () => { if (preparar()) facturaCamera.click(); });
  });

  function showOnly(el: HTMLElement) {
    for (const section of [unconfiguredEl, loginForm, passwordForm, unlinkedEl, dashEl]) {
      section.hidden = section !== el;
    }
    loadingEl.hidden = true;
    // El área de cliente logueada sustituye la cabecera y el pie de la web
    // de marketing por su propia barra lateral: una vez dentro, no tiene
    // sentido volver a "Inicio" o "Altas" desde la barra horizontal.
    document.body.classList.toggle('portal-app', el === dashEl);
  }

  navLinks.forEach((link) => {
    link.addEventListener('click', () => {
      const target = link.dataset.panel;
      navLinks.forEach((l) => l.classList.toggle('active', l === link));
      panels.forEach((p) => { p.hidden = p.dataset.panel !== target; });
    });
  });

  // El email está siempre disponible; el WhatsApp solo si `clientes.contacto_whatsapp`
  // lo marca (no todos los planes lo incluyen - ver nota en schema.sql).
  function renderDudaRapida(tieneWhatsapp: boolean) {
    dudaRapidaWhatsappEl.hidden = !tieneWhatsapp;
  }

  // tipo_persona: 'autonomo' | 'sl' | null (todavía sin marcar por el equipo).
  function renderDocumentacionPanel(tipoPersona: string | null) {
    docPresentacionAutonomoEl.hidden = tipoPersona !== 'autonomo';
    docPresentacionSlEl.hidden = tipoPersona !== 'sl';
    docPresentacionPendienteEl.hidden = tipoPersona === 'autonomo' || tipoPersona === 'sl';
    docApoderamientoEl.hidden = tipoPersona === 'sl';
    ajustarCarpetas(tipoPersona);
  }

  const supabase = getSupabaseBrowser();

  if (!supabase) {
    showOnly(unconfiguredEl);
  } else {
    function formatFecha(iso: string) {
      return new Date(iso).toLocaleDateString(LOCALE, { day: '2-digit', month: '2-digit', year: 'numeric' });
    }

    // Id interno de clientes (no el auth.uid() de la sesión) - es lo que
    // usa facturas_subidas.cliente_id. Se rellena al cargar el dashboard.
    let currentClienteId: string | null = null;

    async function renderFacturaList(clienteId: string) {
      const { data, error } = await supabase!
        .from('facturas_subidas')
        .select('id, referencia, nombre_archivo, storage_path, drive_file_id, fecha_subida, fecha_contabilizado, carpeta, cuenta_digitos, periodo_desde, periodo_hasta, facturas_lectura(estado, datos, datos_revisados, decision, motivo_no, motivo_detalle, contabilizado_at)')
        .eq('cliente_id', clienteId)
        .order('fecha_subida', { ascending: false });

      if (error) console.error('facturas_subidas select error:', error);
      const rows = !error && data ? data : [];
      renderMisFacturas(rows as Record<string, unknown>[]);

      // Agrupa por carpeta; dentro, lo más reciente primero (ya viene ordenado).
      const porCarpeta = new Map<string, typeof rows>();
      for (const row of rows) {
        const c = (row.carpeta as string | null) || 'sinCarpeta';
        if (!porCarpeta.has(c)) porCarpeta.set(c, []);
        porCarpeta.get(c)!.push(row);
      }

      // En cada carpeta: número de archivos y su lista (plegable). Las subidas anteriores a las
      // carpetas van a "sinCarpeta", que solo se muestra si tiene algo.
      for (const el of carpetas) {
        const codigo = el.dataset.carpeta!;
        const filas = porCarpeta.get(codigo) ?? [];
        el.querySelector<HTMLElement>('[data-n]')!.textContent = String(filas.length);
        const lista = el.querySelector<HTMLDetailsElement>('.doc-carpeta-lista')!;
        const ul = lista.querySelector('ul')!;
        ul.innerHTML = '';
        filas.forEach((row) => ul.appendChild(filaArchivo(row, codigo)));
        lista.hidden = filas.length === 0;
        if (codigo === 'sinCarpeta') el.hidden = filas.length === 0;
      }
    }

    // Workflow de n8n "Archivo del portal": devuelve el archivo desde Drive si la sesión es suya o de un admin.
    const ARCHIVO_URL = 'https://n8n.asesoriamadal.es/webhook/archivo-portal';

    async function descargarDeDrive(row: Record<string, unknown>): Promise<boolean> {
      const { data: { session } } = await supabase!.auth.getSession();
      if (!session) return false;
      try {
        const r = await fetch(`${ARCHIVO_URL}?id=${encodeURIComponent(String(row.id))}`, {
          headers: { Authorization: `Bearer ${session.access_token}` },
        });
        if (!r.ok) return false;
        const blob = await r.blob();
        const ext = ((row.nombre_archivo as string).match(/\.[a-zA-Z0-9]{2,5}$/) || ['.pdf'])[0].toLowerCase();
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${(row.referencia as string) || 'documento'}${ext}`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 60_000);
        return true;
      } catch {
        return false;
      }
    }

    // Descarga un documento subido: de la web si sigue ahí; si no, de su copia en Drive.
    async function descargarArchivo(row: Record<string, unknown>) {
      if (row.storage_path) {
        const { data: signed } = await supabase!.storage.from('facturas').createSignedUrl(row.storage_path as string, 60);
        if (signed?.signedUrl) {
          window.open(signed.signedUrl, '_blank');
          return;
        }
      }
      if (row.drive_file_id && (await descargarDeDrive(row))) return;
      alert(I18N.facturas.gone);
    }

    // --- Mis facturas (2026-11-17): tabla con lo leído de cada factura y su estado ---
    const MF_CARPETAS_RECIBIDAS = ['recibidas', 'simplificadas', 'tickets'];
    let mfFilas: Record<string, unknown>[] = [];
    let mfTipo: 'recibida' | 'emitida' = 'recibida';
    const mfImporte = (n: unknown) => (typeof n === 'number' ? n.toLocaleString(LOCALE, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €' : '·');
    const mfFecha = (iso: unknown) => (typeof iso === 'string' && iso ? formatFecha(iso) : '·');
    const mfTrimestre = (iso: string) => `${iso.slice(0, 4)}-${Math.floor((Number(iso.slice(5, 7)) - 1) / 3) + 1}`;

    function mfDatos(row: Record<string, unknown>) {
      const raw = row.facturas_lectura as unknown;
      const l = (Array.isArray(raw) ? raw[0] : raw) as Record<string, unknown> | null | undefined;
      const d = ((l && (l.datos_revisados || l.datos)) || {}) as Record<string, any>;
      let estado: 'recibida' | 'revision' | 'contabilizada' | 'noContabilizada' = 'recibida';
      if (row.fecha_contabilizado || (l && l.contabilizado_at)) estado = 'contabilizada';
      else if (l && l.decision === 'no_contabilizar') estado = 'noContabilizada';
      else if (l) estado = 'revision';
      return { l, d, estado };
    }

    function renderMisFacturas(rows: Record<string, unknown>[]) {
      mfFilas = rows.filter((r) => ['emitidas', ...MF_CARPETAS_RECIBIDAS].includes((r.carpeta as string) || 'recibidas'));
      // Trimestres presentes (por fecha contable, o de factura, o de subida).
      const sel = document.getElementById('mf-trimestre') as HTMLSelectElement;
      const previo = sel.value;
      const trimestres = new Set<string>();
      for (const r of mfFilas) { const { d } = mfDatos(r); trimestres.add(mfTrimestre(String(d.fecha_contable || d.fecha || r.fecha_subida))); }
      sel.innerHTML = `<option value="">${I18N.misFacturas.todos}</option>` + [...trimestres].sort().reverse().map((q) => `<option value="${q}">${q.split('-')[1]}T ${q.split('-')[0]}</option>`).join('');
      sel.value = trimestres.has(previo) ? previo : '';
      pintarMisFacturas();
    }

    function pintarMisFacturas() {
      const q = (document.getElementById('mf-trimestre') as HTMLSelectElement).value;
      const busca = (document.getElementById('mf-buscar') as HTMLInputElement).value.trim().toLowerCase();
      const tbody = document.getElementById('mf-filas')!;
      (document.getElementById('mf-col-tercero') as HTMLElement).textContent = mfTipo === 'emitida' ? I18N.misFacturas.cols.cliente : I18N.misFacturas.cols.proveedor;
      tbody.innerHTML = '';
      let base = 0, iva = 0, ret = 0, pend = 0, n = 0;
      for (const r of mfFilas) {
        const esEmitida = r.carpeta === 'emitidas';
        if (esEmitida !== (mfTipo === 'emitida')) continue;
        const { l, d, estado } = mfDatos(r);
        if (q && mfTrimestre(String(d.fecha_contable || d.fecha || r.fecha_subida)) !== q) continue;
        const tercero = (esEmitida ? d.receptor : d.emisor) || {};
        const nombre = tercero.nombre || tercero.nif || '';
        if (busca && ![r.referencia, nombre, d.numero].some((x) => String(x || '').toLowerCase().includes(busca))) continue;
        n++;
        if (estado !== 'noContabilizada') { base += Number(d.base) || 0; iva += Number(d.cuota_iva) || 0; ret += Number(d.retencion?.cuota) || 0; }
        if (estado === 'recibida' || estado === 'revision') pend++;
        const tr = document.createElement('tr');
        const td = (texto: string, clase = '') => { const c = document.createElement('td'); c.textContent = texto; if (clase) c.className = clase; tr.appendChild(c); return c; };
        td(String(r.referencia || '')).classList.add('mf-ref');
        td(estado === 'recibida' ? String(r.nombre_archivo || '') : (nombre || '·'));
        td(mfFecha(d.fecha));
        const fc = td(mfFecha(d.fecha_contable || d.fecha));
        if (d.nota_fecha) { const s = document.createElement('div'); s.className = 'mf-sub'; s.textContent = tpl(I18N.misFacturas.movida, { mes: String(d.nota_fecha).replace(/[()]/g, '') }); fc.appendChild(s); }
        td(mfImporte(d.base), 'num'); td(mfImporte(d.cuota_iva), 'num'); td(d.retencion ? mfImporte(d.retencion.cuota) : '·', 'num'); td(mfImporte(d.total), 'num mf-total');
        const est = td('');
        const pill = document.createElement('span'); pill.className = `mf-pill mf-${estado}`; pill.textContent = I18N.misFacturas.estados[estado]; est.appendChild(pill);
        if (estado === 'noContabilizada' && l) {
          const m = document.createElement('div'); m.className = 'mf-sub';
          m.textContent = [I18N.misFacturas.motivos[String(l.motivo_no)] || '', l.motivo_detalle || ''].filter(Boolean).join(' ');
          est.appendChild(m);
        }
        const dl = td('');
        if (r.storage_path || r.drive_file_id) {
          const b = document.createElement('button'); b.type = 'button'; b.className = 'mf-descargar'; b.setAttribute('aria-label', `${I18N.misFacturas.cols.descargar} ${r.referencia || ''}`);
          b.innerHTML = '<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="M7 10l5 5 5-5"/><path d="M5 21h14"/></svg>';
          b.addEventListener('click', () => void descargarArchivo(r));
          dl.appendChild(b);
        }
        tbody.appendChild(tr);
      }
      (document.getElementById('mf-vacio') as HTMLElement).hidden = n > 0;
      const tot = document.getElementById('mf-totales')!;
      tot.innerHTML = '';
      for (const [k, v] of [['base', mfImporte(base)], ['iva', mfImporte(iva)], ['ret', mfImporte(ret)], ['pendientes', tpl(I18N.misFacturas.facturasN, { n: pend })]] as const) {
        const div = document.createElement('div'); div.className = 'mf-tarjeta' + (k === 'pendientes' && pend ? ' mf-aviso' : '');
        const a = document.createElement('div'); a.className = 'mf-tarjeta-lab'; a.textContent = I18N.misFacturas.totales[k];
        const b = document.createElement('div'); b.className = 'mf-tarjeta-num'; b.textContent = v;
        div.append(a, b); tot.appendChild(div);
      }
    }

    document.querySelectorAll<HTMLButtonElement>('.mf-tab').forEach((b) => b.addEventListener('click', () => {
      mfTipo = b.dataset.mfTipo === 'emitida' ? 'emitida' : 'recibida';
      document.querySelectorAll('.mf-tab').forEach((x) => x.classList.toggle('is-active', x === b));
      pintarMisFacturas();
    }));
    (document.getElementById('mf-trimestre') as HTMLSelectElement).addEventListener('change', pintarMisFacturas);
    (document.getElementById('mf-buscar') as HTMLInputElement).addEventListener('input', pintarMisFacturas);

    function filaArchivo(row: Record<string, unknown>, carpeta: string): HTMLLIElement {
        const li = document.createElement('li');

        const nombre = document.createElement('div');
        nombre.className = 'factura-nombre';
        // Referencia AM-AAAA-NNNNNN (2026-11-17): la misma que va en Cegid y en el nombre del archivo en Drive.
        if (row.referencia) {
          const ref = document.createElement('strong');
          ref.textContent = `${row.referencia as string} · `;
          nombre.appendChild(ref);
        }
        nombre.appendChild(document.createTextNode(row.nombre_archivo as string));
        li.appendChild(nombre);

        const meta = document.createElement('div');
        meta.className = 'factura-meta';
        const partes = [`${I18N.facturas.uploadedPrefix} ${formatFecha(row.fecha_subida as string)}`];
        if (ES_EXTRACTO(carpeta) && row.cuenta_digitos) {
          const desde = row.periodo_desde ? formatFecha(row.periodo_desde as string) : '';
          const hasta = row.periodo_hasta ? formatFecha(row.periodo_hasta as string) : '';
          partes.unshift(`${I18N.doc.cuentaPrefix} ${row.cuenta_digitos}${desde || hasta ? ` · ${desde} – ${hasta}` : ''}`);
        }
        if (SE_CONTABILIZA(carpeta)) {
          partes.push(row.fecha_contabilizado
            ? `${I18N.facturas.accountedPrefix} ${formatFecha(row.fecha_contabilizado as string)}`
            : I18N.facturas.pendingAccounting);
        }
        meta.textContent = partes.join(' · ');
        li.appendChild(meta);

        // Desde el 2026-11-17 los documentos no se pierden: el Storage se sigue vaciando a los 7 días
        // (n8n, "Borrado facturas Storage"), pero si ya no está ahí se descarga de su copia en Drive
        // a través de n8n ("Archivo del portal"), que comprueba con la sesión que es del cliente o de un admin.
        if (row.storage_path || row.drive_file_id) {
          const descargar = document.createElement('button');
          descargar.type = 'button';
          descargar.className = 'factura-descargar';
          descargar.textContent = I18N.facturas.download;
          descargar.addEventListener('click', () => void descargarArchivo(row));
          li.appendChild(descargar);
        }

        return li;
    }

    type ClienteRow = {
      id: string;
      nombre: string;
      tipo_persona: string | null;
      email?: string | null;
      contacto_whatsapp?: boolean;
      facturacion_cegid?: boolean;
    };

    // Pinta el área de un cliente concreto. La usan los dos caminos: el
    // cliente normal (su propia fila) y el admin (la fila que elija en el
    // selector). Las consultas a las tablas hijas van filtradas por
    // cliente_id; en modo admin RLS las deja leer por la política
    // "admin ve todo".
    function aplicarCliente(cliente: ClienteRow) {
      currentClienteId = cliente.id;
      nombreEl.textContent = cliente.nombre ?? '';
      renderDocumentacionPanel(cliente.tipo_persona ?? null);
      renderFacturaList(cliente.id);
      void renderPrevision(cliente.id);
      void renderModelosPresentados(cliente.id);
      prepararInformes(cliente.tipo_persona ?? null);
      renderDudaRapida(Boolean(cliente.contacto_whatsapp));
      mostrarCegid(Boolean(cliente.facturacion_cegid));
    }

    // Pestaña del programa de facturación de Cegid: solo con la casilla de HubSpot marcada.
    function mostrarCegid(activo: boolean) {
      const nav = navLinks.find((l) => l.dataset.panel === 'inicio');
      const frame = document.getElementById('cegid-frame') as HTMLIFrameElement | null;
      if (nav) nav.hidden = !activo;
      if (activo && frame && !frame.src) frame.src = frame.dataset.src || '';
      if (!activo && nav && nav.classList.contains('active')) navLinks.find((l) => l.dataset.panel === 'prevision')?.click();
    }

    // --- Previsión fiscal (2026-11-20) ---
    // Plazo: hasta el 20 del mes siguiente al trimestre; el 4T, el 30 de enero (303 y 130) o el 20 (111 y 115).
    // Si cae en fin de semana, el lunes. Los festivos no se contemplan.
    function pfPlazo(modelo: string, anio: number, q: number) {
      const d = q === 4 ? new Date(anio + 1, 0, ['303', '130'].includes(modelo) ? 30 : 20) : new Date(anio, q * 3, 20);
      while (d.getDay() === 0 || d.getDay() === 6) d.setDate(d.getDate() + 1);
      return d.toLocaleDateString(LOCALE, { day: 'numeric', month: 'long', year: 'numeric' });
    }
    // Domiciliación (Edurne, 2026-11-21): el día 20 del mes siguiente al trimestre en todos los modelos (4T: 20 de enero).
    function pfDomiciliacion(anio: number, q: number) {
      const d = q === 4 ? new Date(anio + 1, 0, 20) : new Date(anio, q * 3, 20);
      while (d.getDay() === 0 || d.getDay() === 6) d.setDate(d.getDate() + 1);
      return d.toLocaleDateString(LOCALE, { day: 'numeric', month: 'long', year: 'numeric' });
    }
    async function renderPrevision(clienteId: string) {
      const P = I18N.prevision;
      const hoy = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Madrid' }));
      const anio = hoy.getFullYear(), q = Math.floor(hoy.getMonth() / 3) + 1;
      (document.getElementById('pf-periodo') as HTMLElement).textContent = `· ${q}T ${anio}`;
      const estado = document.getElementById('pf-estado') as HTMLElement;
      const caja = document.getElementById('pf-modelos') as HTMLElement;
      const totalEl = document.getElementById('pf-total') as HTMLElement;
      caja.innerHTML = ''; totalEl.hidden = true; estado.textContent = '';
      const { data } = await supabase!.from('prevision_fiscal').select('modelos, resumen, error, calculado_at')
        .eq('cliente_id', clienteId).eq('anio', anio).eq('trimestre', q).maybeSingle();
      if (clienteId !== currentClienteId) return;
      const modelos = ((data && data.modelos) || []) as { modelo: string; importe: number; resultado: string; detalle: Record<string, number> }[];
      if (!data || !data.calculado_at || !modelos.length) { estado.textContent = P.vacio; return; }
      const resumen = (data.resumen || {}) as { facturas?: number; incompleto?: boolean };
      estado.textContent = (data.error ? tpl(P.error, { fecha: formatFecha(data.calculado_at) }) : tpl(P.calculado, { fecha: formatFecha(data.calculado_at), n: resumen.facturas ?? 0 }))
        + (resumen.incompleto ? ' ' + P.incompleto : '');
      const eur = (n: number) => n.toLocaleString(LOCALE, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
      const filas: Record<string, string[]> = {
        '303': ['repercutido', 'soportado', 'compensacion'],
        '130': ['ingresos', 'gastos', 'dificil', 'rendimiento', 'cuota20', 'retenciones', 'pagosAnteriores'],
        '111': ['retencionesFacturas', 'nominas'],
        '115': [],
      };
      let total = 0;
      for (const m of modelos) {
        if (m.resultado === 'pagar') total += m.importe;
        const card = document.createElement('article');
        card.className = 'pf-tarjeta pf-' + m.resultado;
        const h = document.createElement('h3'); h.textContent = tpl(P.modeloTitulo, { m: m.modelo }) + ' · ' + (P.modelos[m.modelo] || ''); card.appendChild(h);
        const num = document.createElement('p'); num.className = 'pf-importe'; num.textContent = (m.resultado === 'devolver' ? '-' : '') + eur(Math.abs(m.importe)); card.appendChild(num);
        const res = document.createElement('p'); res.className = 'pf-resultado'; res.textContent = P.resultados[m.resultado] || ''; card.appendChild(res);
        const pl = document.createElement('p'); pl.className = 'pf-plazo'; pl.textContent = m.resultado === 'pagar' ? tpl(P.domiciliacion, { fecha: pfDomiciliacion(anio, q) }) : tpl(P.plazo, { fecha: pfPlazo(m.modelo, anio, q) }); card.appendChild(pl);
        const lineas = (filas[m.modelo] || []).filter((k) => typeof m.detalle?.[k] === 'number' && !(['compensacion', 'dificil', 'nominas', 'pagosAnteriores'].includes(k) && !m.detalle[k]));
        if (m.modelo === '115' && m.detalle?.facturas) lineas.push('alquileres');
        if (lineas.length) {
          const det = document.createElement('details'); const sum = document.createElement('summary'); sum.textContent = P.ver; det.appendChild(sum);
          const dl = document.createElement('dl');
          for (const k of lineas) {
            const dt = document.createElement('dt'); dt.textContent = k === 'alquileres' ? tpl(P.detalle.alquileres, { n: m.detalle.facturas }) : P.detalle[k];
            const dd = document.createElement('dd'); dd.textContent = eur(k === 'alquileres' ? m.importe : m.detalle[k]);
            dl.append(dt, dd);
          }
          det.appendChild(dl); card.appendChild(det);
        }
        caja.appendChild(card);
      }
      if (total > 0) { totalEl.hidden = false; totalEl.textContent = P.total + ': ' + eur(Math.round(total * 100) / 100); }
    }

    // --- Modelos presentados (2026-11-20) ---
    const JUSTIFICANTE_URL = 'https://n8n.asesoriamadal.es/webhook/justificante-portal';
    document.querySelectorAll<HTMLButtonElement>('.pf-tab').forEach((b) => b.addEventListener('click', () => {
      document.querySelectorAll('.pf-tab').forEach((x) => x.classList.toggle('is-active', x === b));
      (document.getElementById('pf-vista-actual') as HTMLElement).hidden = b.dataset.pfVista !== 'actual';
      (document.getElementById('pf-vista-modelos') as HTMLElement).hidden = b.dataset.pfVista !== 'modelos';
    }));
    async function descargarJustificante(id: number, nombre: string) {
      const { data: { session } } = await supabase!.auth.getSession();
      try {
        if (!session) throw new Error('sin sesión');
        const r = await fetch(`${JUSTIFICANTE_URL}?id=${encodeURIComponent(String(id))}`, { headers: { Authorization: `Bearer ${session.access_token}` } });
        if (!r.ok) throw new Error(String(r.status));
        const url = URL.createObjectURL(await r.blob());
        const a = document.createElement('a'); a.href = url; a.download = nombre + '.pdf';
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 60_000);
      } catch { alert(I18N.prevision.descargaError); }
    }
    // Filtros (2026-11-21): año, modelo y estado, con las opciones de lo que tiene el cliente. Se filtra en el navegador.
    let pfModelos: Record<string, any>[] = [];
    const pfClaveEstado = (f: Record<string, any>) => { const e = String(f.estado || '').toLowerCase(); return e.startsWith('present') ? 'presentado' : e.startsWith('borrador') ? 'borrador' : e.startsWith('acept') ? 'aceptado' : e.startsWith('sin act') ? 'sinActividad' : 'preparacion'; };
    for (const id of ['pf-f-anio', 'pf-f-modelo', 'pf-f-estado']) (document.getElementById(id) as HTMLSelectElement).addEventListener('change', () => pintarModelosPresentados());
    async function renderModelosPresentados(clienteId: string) {
      const P = I18N.prevision;
      (document.getElementById('pf-filas') as HTMLElement).innerHTML = '';
      const { data } = await supabase!.from('modelos_fiscales')
        .select('id, modelo, periodo, anio, trimestre, estado, resultado, importe, importe_texto, presentado_el, justificante_drive_id')
        .eq('cliente_id', clienteId);
      if (clienteId !== currentClienteId) return;
      const filas = ((data || []) as Record<string, any>[]).sort((a, b) => (b.anio || 0) - (a.anio || 0) || String(b.periodo).localeCompare(String(a.periodo)) || String(a.modelo).localeCompare(String(b.modelo)));
      pfModelos = filas;
      (document.getElementById('pf-modelos-vacio') as HTMLElement).hidden = filas.length > 0;
      (document.getElementById('pf-tabla-caja') as HTMLElement).hidden = filas.length === 0;
      (document.getElementById('pf-filtros') as HTMLElement).hidden = filas.length === 0;
      const opciones = (id: string, valores: [string, string][]) => {
        const sel = document.getElementById(id) as HTMLSelectElement;
        sel.innerHTML = `<option value="">${I18N.misFacturas.todos}</option>` + valores.map(([v, t]) => `<option value="${v}">${t}</option>`).join('');
      };
      opciones('pf-f-anio', [...new Set(filas.map((f) => String(f.anio ?? '')).filter(Boolean))].sort().reverse().map((a) => [a, a]));
      opciones('pf-f-modelo', [...new Set(filas.map((f) => String(f.modelo)))].sort().map((m) => [m, m + (P.nombresModelo[m] ? ' · ' + P.nombresModelo[m] : '')]));
      opciones('pf-f-estado', [...new Set(filas.map(pfClaveEstado))].map((k) => [k, P.estados[k]]));
      pintarModelosPresentados();
    }
    function pintarModelosPresentados() {
      const P = I18N.prevision;
      const tbody = document.getElementById('pf-filas') as HTMLElement;
      tbody.innerHTML = '';
      const fa = (document.getElementById('pf-f-anio') as HTMLSelectElement).value;
      const fm = (document.getElementById('pf-f-modelo') as HTMLSelectElement).value;
      const fe = (document.getElementById('pf-f-estado') as HTMLSelectElement).value;
      const filas = pfModelos.filter((f) => (!fa || String(f.anio) === fa) && (!fm || String(f.modelo) === fm) && (!fe || pfClaveEstado(f) === fe));
      const eur = (n: number) => n.toLocaleString(LOCALE, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
      for (const f of filas) {
        const tr = document.createElement('tr');
        const td = (texto: string, clase = '') => { const c = document.createElement('td'); c.textContent = texto; if (clase) c.className = clase; tr.appendChild(c); return c; };
        td(String(f.anio ?? ''));
        td(String(f.periodo || '').replace(/\s*\d{4}$/, ''));
        const tm = td(tpl(P.modeloTitulo, { m: f.modelo }));
        if (P.nombresModelo[f.modelo]) { const s = document.createElement('div'); s.className = 'mf-sub'; s.textContent = P.nombresModelo[f.modelo]; tm.appendChild(s); }
        const est = String(f.estado || '').toLowerCase();
        const clave = est.startsWith('present') ? 'presentado' : est.startsWith('borrador') ? 'borrador' : est.startsWith('acept') ? 'aceptado' : est.startsWith('sin act') ? 'sinActividad' : 'preparacion';
        const conImporte = ['presentado', 'borrador', 'aceptado'].includes(clave) && typeof f.importe === 'number';
        const res = P.resultadosHoja[String(f.resultado || '').toLowerCase()] ?? '';
        const ti = td(conImporte ? (String(f.resultado || '').toLowerCase() === 'a devolver' ? '-' : '') + eur(Math.abs(f.importe)) : '·', 'num');
        if (conImporte && res) { const s = document.createElement('div'); s.className = 'mf-sub'; s.textContent = res; ti.appendChild(s); }
        const te = td('');
        const pill = document.createElement('span'); pill.className = 'mf-pill pf-estado-' + clave;
        pill.textContent = clave === 'presentado' && f.presentado_el ? tpl(P.estados.presentadoEl, { fecha: formatFecha(f.presentado_el) }) : P.estados[clave];
        te.appendChild(pill);
        const tdesc = td('');
        if (f.justificante_drive_id) {
          const b = document.createElement('button'); b.type = 'button'; b.className = 'pf-descargar'; b.textContent = P.descargar;
          b.addEventListener('click', () => void descargarJustificante(f.id, 'Modelo ' + f.modelo + ' ' + f.periodo));
          tdesc.appendChild(b);
        } else tdesc.textContent = '·';
        tbody.appendChild(tr);
      }
    }

    // --- Informes (2026-11-21) ---
    const INFORMES_URL = 'https://n8n.asesoriamadal.es/webhook/informes-portal';
    let infTipoPersona: string | null = null;
    let infUltimo: { titulo: string; subtitulo: string; columnas: { k: string; t: string; n?: number }[]; filas: { tipo: string; c: Record<string, unknown> }[]; notas: string[] } | null = null;
    const infEur = (v: unknown) => typeof v === 'number' ? v.toLocaleString(LOCALE, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '';
    function prepararInformes(tipo: string | null) {
      const I = I18N.informes;
      infTipoPersona = tipo;
      const sel = document.getElementById('inf-tipo') as HTMLSelectElement;
      const lista = tipo === 'sl' ? ['pyg', 'balance', 'sumas', 'mayor', 'diario', 'emitidas', 'recibidas'] : ['pyg', 'emitidas', 'recibidas'];
      sel.innerHTML = lista.map((k) => `<option value="${k}">${I.opciones[k]}</option>`).join('');
      (document.getElementById('inf-nota') as HTMLElement).hidden = tipo === 'sl';
      const hoy = new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Madrid' });
      (document.getElementById('inf-desde') as HTMLInputElement).value = hoy.slice(0, 4) + '-01-01';
      (document.getElementById('inf-hasta') as HTMLInputElement).value = hoy;
      (document.getElementById('inf-resultado') as HTMLElement).hidden = true;
      (document.getElementById('inf-estado') as HTMLElement).textContent = '';
      ajustarFormInformes();
    }
    function ajustarFormInformes() {
      const v = (document.getElementById('inf-tipo') as HTMLSelectElement).value;
      (document.getElementById('inf-l-desde') as HTMLElement).hidden = v === 'balance';
      (document.getElementById('inf-l-cuenta') as HTMLElement).hidden = v !== 'mayor';
      (document.getElementById('inf-t-hasta') as HTMLElement).textContent = v === 'balance' ? I18N.informes.aFecha : I18N.informes.hasta;
    }
    function pintarInforme(inf: NonNullable<typeof infUltimo>) {
      infUltimo = inf;
      (document.getElementById('inf-titulo') as HTMLElement).textContent = inf.titulo;
      (document.getElementById('inf-subtitulo') as HTMLElement).textContent = inf.subtitulo;
      const cols = document.getElementById('inf-cols') as HTMLElement;
      cols.innerHTML = '';
      for (const c of inf.columnas) { const th = document.createElement('th'); th.textContent = c.t; if (c.n) th.className = 'num'; cols.appendChild(th); }
      const tbody = document.getElementById('inf-filas') as HTMLElement;
      tbody.innerHTML = '';
      for (const f of inf.filas) {
        const tr = document.createElement('tr'); tr.className = 'inf-' + f.tipo;
        for (const c of inf.columnas) { const td = document.createElement('td'); const v = f.c[c.k]; td.textContent = c.n ? infEur(v) : String(v ?? ''); if (c.n) td.className = 'num'; tr.appendChild(td); }
        tbody.appendChild(tr);
      }
      (document.getElementById('inf-notas') as HTMLElement).textContent = (inf.filas.length <= 1 ? I18N.informes.vacio + ' ' : '') + inf.notas.join(' ');
      (document.getElementById('inf-resultado') as HTMLElement).hidden = false;
    }
    (document.getElementById('inf-tipo') as HTMLSelectElement).addEventListener('change', ajustarFormInformes);
    (document.getElementById('inf-form') as HTMLFormElement).addEventListener('submit', async (e) => {
      e.preventDefault();
      const I = I18N.informes;
      const estado = document.getElementById('inf-estado') as HTMLElement;
      const boton = (e.target as HTMLFormElement).querySelector('button[type=submit]') as HTMLButtonElement;
      const informe = (document.getElementById('inf-tipo') as HTMLSelectElement).value;
      const hasta = (document.getElementById('inf-hasta') as HTMLInputElement).value;
      const desde = informe === 'balance' ? hasta.slice(0, 4) + '-01-01' : (document.getElementById('inf-desde') as HTMLInputElement).value;
      const params = new URLSearchParams({ informe, desde, hasta, cliente: currentClienteId || '' });
      const cuenta = (document.getElementById('inf-cuenta') as HTMLInputElement).value.trim();
      if (informe === 'mayor' && cuenta) params.set('cuenta', cuenta);
      estado.textContent = I.generando; boton.disabled = true;
      (document.getElementById('inf-resultado') as HTMLElement).hidden = true;
      try {
        const { data: { session } } = await supabase!.auth.getSession();
        if (!session) throw new Error('sesión');
        const r = await fetch(INFORMES_URL + '?' + params.toString(), { headers: { Authorization: `Bearer ${session.access_token}` } });
        const j = await r.json().catch(() => ({}));
        if (r.status === 404) { estado.textContent = I.sinConta; return; }
        if (!r.ok || j.error) { estado.textContent = j.error || I.error; return; }
        estado.textContent = '';
        pintarInforme(j);
      } catch { estado.textContent = I.error; }
      finally { boton.disabled = false; }
    });
    (document.getElementById('inf-csv') as HTMLButtonElement).addEventListener('click', () => {
      if (!infUltimo) return;
      const celda = (v: unknown, num?: number) => { const t = num ? (typeof v === 'number' ? String(v).replace('.', ',') : '') : String(v ?? ''); return /[;"\n]/.test(t) ? '"' + t.replace(/"/g, '""') + '"' : t; };
      const lineas = [infUltimo.titulo, infUltimo.subtitulo, '', infUltimo.columnas.map((c) => celda(c.t)).join(';'),
        ...infUltimo.filas.map((f) => infUltimo!.columnas.map((c) => celda(f.c[c.k], c.n)).join(';'))];
      const url = URL.createObjectURL(new Blob(['\ufeff' + lineas.join('\r\n')], { type: 'text/csv;charset=utf-8' }));
      const a = document.createElement('a'); a.href = url; a.download = (infUltimo.titulo + ' ' + infUltimo.subtitulo).replace(/[\\/:*?"<>|]/g, '-') + '.csv';
      document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(url), 60_000);
    });
    (document.getElementById('inf-imprimir') as HTMLButtonElement).addEventListener('click', () => {
      document.body.classList.add('inf-imprimiendo');
      window.print();
      setTimeout(() => document.body.classList.remove('inf-imprimiendo'), 500);
    });

    let adminClientes: ClienteRow[] = [];

    // Modo admin: en vez de "tu ficha", un desplegable con todos los
    // clientes. La consulta devuelve todas las filas gracias a la política
    // RLS "admin ve todos los clientes"; para un cliente normal esa misma
    // consulta solo devolvería la suya (y no llegamos aquí).
    async function renderAdmin(forzar = false) {
      // Ya montado (p.ej. un TOKEN_REFRESHED posterior de Supabase Auth):
      // no reconstruir el selector ni perder el cliente que se estaba viendo.
      // `forzar` lo salta tras un alta manual, para que aparezca el nuevo cliente.
      if (!forzar && !adminBar.hidden && adminClientes.length > 0) {
        showOnly(dashEl);
        return;
      }

      const { data, error } = await supabase!
        .from('clientes')
        .select('id, nombre, email, tipo_persona, contacto_whatsapp, facturacion_cegid')
        .order('nombre', { ascending: true });

      adminClientes = (!error && data ? data : []) as ClienteRow[];
      adminClienteSelect.innerHTML = '';

      if (adminClientes.length === 0) {
        const opt = document.createElement('option');
        opt.value = '';
        opt.textContent = I18N.admin.noClientes;
        adminClienteSelect.appendChild(opt);
      } else {
        adminClientes.forEach((c) => {
          const opt = document.createElement('option');
          opt.value = c.id;
          opt.textContent = c.email ? `${c.nombre} - ${c.email}` : `${c.nombre} (${c.id})`;
          adminClienteSelect.appendChild(opt);
        });
      }

      adminClienteSelect.onchange = () => {
        const c = adminClientes.find((x) => x.id === adminClienteSelect.value);
        if (c) {
          adminClienteNombre.textContent = c.nombre ?? '';
          aplicarCliente(c);
        }
      };

      adminBar.hidden = false;
      // El admin puede subir documentos en nombre del cliente seleccionado (2026-11-12): se
      // guardan en su cuenta. Necesita las políticas "admin …" de schema.sql.
      docAdminNota.hidden = false;

      if (adminClientes.length > 0) {
        adminClienteSelect.value = adminClientes[0].id;
        adminClienteNombre.textContent = adminClientes[0].nombre ?? '';
        aplicarCliente(adminClientes[0]);
      }
      showOnly(dashEl);
    }

    // Una sola carga por sesión (2026-11-15). Antes el portal se pintaba tres veces al entrar (la
    // llamada directa, INITIAL_SESSION y SIGNED_IN del enlace) y repetía todas las consultas. Ahora
    // solo se pinta cuando cambia el usuario de la sesión, y las dos primeras consultas van en paralelo.
    let usuarioPintado: string | null = null;

    async function renderForSession(session: Session | null, intento = 1) {
      if (!session) {
        usuarioPintado = null;
        showOnly(loginForm);
        return;
      }
      // Ha entrado con el enlace de "crea tu contraseña" o "¿has olvidado…?": primero la elige.
      if (pedirContrasena) {
        usuarioPintado = null;
        (document.getElementById('portal-password-user') as HTMLInputElement).value = session.user.email || '';
        showOnly(passwordForm);
        newPass1.focus();
        return;
      }
      if (usuarioPintado === session.user.id) return;
      usuarioPintado = session.user.id;

      // ¿La sesión es de un miembro del equipo con acceso admin? La política RLS de portal_admins
      // solo deja ver la fila propia, así que devuelve algo únicamente si eres admin.
      // Cliente normal: sin filtro por email, RLS ya limita clientes a la fila vinculada
      // (auth_user_id = auth.uid()); si el trigger de alta todavía no la ha vinculado, no devuelve
      // nada y cae en "unlinked". limit(1): a un admin RLS le devuelve todas y aquí no se usan.
      const [{ data: adminRow, error: adminError }, { data: cliente, error: clienteError }] = await Promise.all([
        supabase!.from('portal_admins').select('auth_user_id').maybeSingle(),
        supabase!.from('clientes').select('id, nombre, tipo_persona, contacto_whatsapp, facturacion_cegid').limit(1).maybeSingle(),
      ]);

      // Justo al entrar con el enlace del correo, Supabase puede rechazar una vez el token recién
      // emitido (401). Antes lo tapaba la carga repetida; ahora se reintenta hasta 3 veces en vez de
      // dar por hecho que no hay ficha. Mientras, se sigue viendo "Cargando".
      if (adminError || clienteError) {
        usuarioPintado = null;
        if (intento < 4) setTimeout(() => void renderForSession(session, intento + 1), 700 * intento);
        else showOnly(unlinkedEl);
        return;
      }

      if (adminRow) {
        await renderAdmin();
        return;
      }

      if (!cliente) {
        showOnly(unlinkedEl);
        return;
      }

      adminBar.hidden = true;
      docAdminNota.hidden = true;
      aplicarCliente(cliente as ClienteRow);
      showOnly(dashEl);
    }

    // --- Alta manual de cliente (vía /api/alta-cliente) ---
    // Solo inserta la fila en `clientes`; el correo con el formulario, HubSpot y
    // Drive los dispara n8n (Onboarding) a partir de ese INSERT. El acceso al
    // portal lo manda n8n (Responden formulario) al recibir el primer formulario.
    const altaToggle = document.getElementById('portal-alta-toggle') as HTMLButtonElement;
    const altaForm = document.getElementById('portal-alta-form') as HTMLFormElement;
    const altaMsg = document.getElementById('alta-msg') as HTMLElement;
    const altaTipo = document.getElementById('alta-tipo') as HTMLSelectElement;
    const altaTramitamosWrap = document.getElementById('alta-tramitamos-wrap') as HTMLElement;

    const altaEnlace = document.getElementById('alta-enlace') as HTMLElement;
    const altaEnlaceUrl = document.getElementById('alta-enlace-url') as HTMLInputElement;
    const altaEnlaceCopiar = document.getElementById('alta-enlace-copiar') as HTMLButtonElement;
    altaEnlaceCopiar.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(altaEnlaceUrl.value);
      } catch {
        // Sin permiso de portapapeles: se deja seleccionado para copiarlo a mano.
        altaEnlaceUrl.select();
        return;
      }
      altaEnlaceCopiar.textContent = I18N.admin.alta.copiado;
      setTimeout(() => (altaEnlaceCopiar.textContent = I18N.admin.alta.copiar), 2000);
    });

    function syncAltaTipo() {
      altaTramitamosWrap.hidden = altaTipo.value !== 'autonomo';
    }
    altaTipo.addEventListener('change', syncAltaTipo);
    syncAltaTipo();

    altaToggle.addEventListener('click', () => {
      altaForm.hidden = !altaForm.hidden;
      altaToggle.textContent = altaForm.hidden ? I18N.admin.alta.open : I18N.admin.alta.close;
    });

    altaForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const boton = document.getElementById('alta-submit') as HTMLButtonElement;
      const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();
      const tipoPersona = altaTipo.value;

      boton.disabled = true;
      altaMsg.hidden = false;
      altaMsg.textContent = I18N.admin.alta.sending;
      try {
        const {
          data: { session },
        } = await supabase!.auth.getSession();
        const res = await fetch('/api/alta-cliente', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${session?.access_token ?? ''}` },
          body: JSON.stringify({
            nif: val('alta-nif'),
            nombre: val('alta-nombre'),
            empresa: val('alta-empresa') || undefined,
            email: val('alta-email') || undefined,
            telefono: val('alta-telefono') || undefined,
            plan: val('alta-plan') || undefined,
            idioma: val('alta-idioma') || 'es',
            tipoPersona,
            tramitamosAlta: tipoPersona === 'autonomo' ? (document.getElementById('alta-tramitamos') as HTMLSelectElement).value === 'si' : undefined,
            reporting: (document.getElementById('alta-reporting') as HTMLInputElement).checked,
            enviarFormulario: (document.getElementById('alta-formulario') as HTMLInputElement).checked,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          altaMsg.textContent = data.error || I18N.admin.alta.error;
          return;
        }
        // Correo del formulario desmarcado = "se lo mando yo": se muestra el enlace
        // del formulario que le toca, con NIF y email ya puestos, en inglés si el
        // cliente es en inglés (en catalán no hay formulario: va el castellano).
        const enviaFormulario = (document.getElementById('alta-formulario') as HTMLInputElement).checked;
        const emailAlta = val('alta-email');
        let enlaceFormulario = '';
        if (!enviaFormulario) {
          const prefijo = val('alta-idioma') === 'en' ? '/en' : '';
          const ruta =
            prefijo +
            (tipoPersona === 'sl'
              ? '/formulario-traspaso-sl'
              : (document.getElementById('alta-tramitamos') as HTMLSelectElement).value === 'si'
                ? '/formulario-alta'
                : '/formulario-traspaso-autonomo');
          // Ficha provisional (sin NIF): el enlace va solo con el email y el
          // cliente escribe su NIF en el formulario.
          const params = new URLSearchParams();
          if (!String(data.id).startsWith('PENDIENTE-')) params.set('nif', data.id);
          if (emailAlta) params.set('email', emailAlta.toLowerCase());
          enlaceFormulario = `${window.location.origin}${ruta}?${params.toString()}`;
          altaMsg.textContent = I18N.admin.alta.okManual;
        } else {
          altaMsg.textContent = I18N.admin.alta.ok;
        }
        altaForm.reset(); // vacía también el campo del enlace: se rellena justo después
        altaEnlaceUrl.value = enlaceFormulario;
        altaEnlace.hidden = !enlaceFormulario;
        syncAltaTipo();
        await renderAdmin(true);
        adminClienteSelect.value = data.id;
        adminClienteSelect.dispatchEvent(new Event('change'));
      } catch {
        altaMsg.textContent = I18N.admin.alta.error;
      } finally {
        boton.disabled = false;
      }
    });

    // INITIAL_SESSION llega siempre al suscribirse, así que no hace falta otra llamada al arrancar.
    // Fuera del callback (setTimeout) para no hacer consultas dentro del aviso de Supabase Auth, y sin
    // repintar al renovar el token.
    supabase.auth.onAuthStateChange((evento, session) => {
      if (evento === 'PASSWORD_RECOVERY') pedirContrasena = true;
      if (evento === 'TOKEN_REFRESHED' || evento === 'USER_UPDATED') return;
      setTimeout(() => void renderForSession(session), 0);
    });

    function avisoLogin(texto: string, clase = '') {
      loginMsg.hidden = false;
      loginMsg.className = `portal-msg ${clase}`.trim();
      loginMsg.textContent = texto;
    }

    // Correo y contraseña (2026-11-17). Supabase limita los intentos fallidos.
    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      avisoLogin(I18N.login.entering);
      const { error } = await supabase!.auth.signInWithPassword({
        email: emailInput.value.trim().toLowerCase(),
        password: passwordInput.value,
      });
      if (error) {
        const codigo = (error as { code?: string }).code || '';
        console.error('signInWithPassword:', codigo, error.message);
        const texto = codigo === 'invalid_credentials' ? I18N.login.wrong
          : codigo === 'email_not_confirmed' ? I18N.login.notConfirmed
          : /rate|too many|429/i.test(codigo + ' ' + error.message) ? I18N.login.tooMany
          : I18N.login.otherError;
        avisoLogin(texto, 'is-error');
        return;
      }
      loginMsg.hidden = true;
      passwordInput.value = '';
    });

    // "¿Has olvidado tu contraseña?" y "Entrar sin contraseña": el correo lo manda n8n, en el idioma
    // del cliente y solo si el email es de una ficha o de un admin (ver api/portal-login.ts).
    async function pedirCorreo(tipo: 'contrasena' | 'entrar') {
      const email = emailInput.value.trim();
      if (!emailInput.checkValidity() || !email) {
        avisoLogin(I18N.login.needEmail, 'is-error');
        emailInput.focus();
        return;
      }
      avisoLogin(I18N.login.sending);
      let ok = false;
      try {
        const res = await fetch('/api/portal-login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, tipo, idioma: (document.documentElement.lang || 'es').slice(0, 2) }),
        });
        ok = res.ok;
      } catch {
        ok = false;
      }
      if (ok) avisoLogin(tipo === 'contrasena' ? I18N.login.sentPassword : I18N.login.sent, 'is-ok');
      else avisoLogin(I18N.login.error, 'is-error');
    }
    olvidoBtn.addEventListener('click', () => void pedirCorreo('contrasena'));
    sinContrasenaBtn.addEventListener('click', () => void pedirCorreo('entrar'));

    // Elegir contraseña (primer acceso o recuperación).
    passwordForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const aviso = (texto: string, clase = '') => {
        passwordMsg.hidden = false;
        passwordMsg.className = `portal-msg ${clase}`.trim();
        passwordMsg.textContent = texto;
      };
      if (newPass1.value.length < 8) return aviso(I18N.login.passShort, 'is-error');
      if (newPass1.value !== newPass2.value) return aviso(I18N.login.passMismatch, 'is-error');
      aviso(I18N.login.sending);
      const { error } = await supabase!.auth.updateUser({ password: newPass1.value });
      if (error) {
        console.error('updateUser password:', error.message);
        return aviso(I18N.login.passError, 'is-error');
      }
      pedirContrasena = false;
      try { if ('PasswordCredential' in window) await navigator.credentials.store(new (window as any).PasswordCredential({ id: (document.getElementById('portal-password-user') as HTMLInputElement).value, password: newPass1.value })); } catch { /* el navegador no lo admite */ }
      newPass1.value = '';
      newPass2.value = '';
      passwordMsg.hidden = true;
      history.replaceState(null, '', window.location.pathname);
      const { data: { session } } = await supabase!.auth.getSession();
      void renderForSession(session);
    });

    const FACTURA_TIPOS_ACEPTADOS = ['application/pdf', 'image/jpeg', 'image/png', 'image/webp'];

    const FACTURA_TIPO_POR_EXTENSION: Record<string, string> = { pdf: 'application/pdf', jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', webp: 'image/webp' };

    // Algunos móviles entregan la foto sin tipo o en HEIC: el tipo se deduce de
    // la extensión y lo que el navegador sepa decodificar se pasa a JPEG.
    async function normalizarFactura(file: File): Promise<File | null> {
      if (FACTURA_TIPOS_ACEPTADOS.includes(file.type)) return file;
      const ext = file.name.split('.').pop()?.toLowerCase() ?? '';
      const tipo = FACTURA_TIPO_POR_EXTENSION[ext];
      if (tipo) return new File([file], file.name, { type: tipo });
      if (!file.type.startsWith('image/') && !/^(heic|heif)$/.test(ext)) return null;
      try {
        const imagen = await createImageBitmap(file);
        const canvas = document.createElement('canvas');
        canvas.width = imagen.width;
        canvas.height = imagen.height;
        canvas.getContext('2d')!.drawImage(imagen, 0, 0);
        const jpeg = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/jpeg', 0.9));
        if (!jpeg) return null;
        return new File([jpeg], file.name.replace(/\.[^.]*$/, '') + '.jpg', { type: 'image/jpeg' });
      } catch {
        return null;
      }
    }

    // Storage rechaza claves con tildes y símbolos raros.
    function nombreParaStorage(nombre: string): string {
      return nombre.normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-zA-Z0-9._-]+/g, '_');
    }

    async function subirFacturas(originales: File[]) {
      if (originales.length === 0) return;

      // Carpeta y datos del extracto: los del botón pulsado (ya comprobados al pulsarlo).
      const carpeta = carpetaActual;
      const extracto = extractoActual;
      if (!carpeta) return;
      const mostrarError = (texto: string) => {
        mensaje(carpeta, texto, 'is-error');
        facturaFile.value = '';
        facturaCamera.value = '';
      };

      const normalizadas = await Promise.all(originales.map(normalizarFactura));
      if (normalizadas.some((f) => f === null)) {
        mostrarError(I18N.facturas.onlyPdf);
        return;
      }
      const files = normalizadas as File[];

      const {
        data: { session },
      } = await supabase!.auth.getSession();
      if (!session || !currentClienteId) {
        mostrarError(`${I18N.facturas.failAll} (${!session ? 'no session' : 'no client'})`);
        return;
      }
      const clienteId = currentClienteId;

      mensaje(carpeta, files.length > 1 ? tpl(I18N.facturas.uploadingMany, { n: files.length }) : I18N.facturas.uploadingOne, '');

      // Cada archivo es una subida y una fila independiente en
      // facturas_subidas: varias facturas seleccionadas a la vez cuentan
      // como varias facturas, no como una sola. Se suben en secuencia (no en
      // paralelo) para no saturar la conexión con varios PDFs a la vez.
      let subidas = 0;
      let fallos = 0;
      let ultimoError = '';

      for (const file of files) {
        // La ruta en Storage usa el NIF del cliente tanto para la carpeta
        // (así lo exige la política de Storage, ver schema.sql) como para
        // prefijar el propio nombre de archivo - mismo id que cliente_id en
        // facturas_subidas, para que carpeta y archivo sean identificables a
        // mano (Drive, revisión manual) en vez de un uid opaco. El timestamp
        // (día/mes-hora/minuto/segundo, hora local del navegador) y el sufijo
        // aleatorio evitan que dos subidas choquen de nombre: el iPhone llama
        // image.jpg a todas las fotos - se usan guiones en vez de barras
        // porque "/" en la ruta de Storage crearía subcarpetas.
        const now = new Date();
        const pad = (n: number) => String(n).padStart(2, '0');
        const timestamp = `${pad(now.getDate())}${pad(now.getMonth() + 1)}-${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}`;
        const sufijo = crypto.randomUUID().slice(0, 4);
        const path = `${clienteId}/${clienteId}-${timestamp}-${sufijo}-${nombreParaStorage(file.name)}`;
        const { error } = await supabase!.storage.from('facturas').upload(path, file, {
          contentType: file.type,
        });

        if (error) {
          console.error('facturas upload error:', error);
          ultimoError = error.message;
          fallos++;
          continue;
        }

        // Si el archivo sube bien pero falla el registro de la fila, no lo
        // contamos como fallo de cara al cliente (el equipo verá el archivo
        // en el Storage igualmente y podrá revisarlo a mano) - pero sí lo
        // dejamos en consola para poder diagnosticar por qué falla el insert
        // (RLS, FK, tipo de columna...).
        const { error: insertError } = await supabase!.from('facturas_subidas').insert({
          cliente_id: clienteId,
          nombre_archivo: file.name,
          storage_path: path,
          carpeta,
          ...(extracto ?? {}),
        });
        if (insertError) {
          // Antes solo se anotaba en la consola: el archivo quedaba en Storage sin fila y nunca
          // bajaba a Drive. Ahora cuenta como fallo, para que se vea y se pueda repetir.
          console.error('facturas_subidas insert error:', insertError);
          ultimoError = insertError.message;
          fallos++;
          continue;
        }
        subidas++;
      }

      if (fallos === 0) {
        mensaje(carpeta, subidas > 1 ? tpl(I18N.facturas.okMany, { n: subidas }) : I18N.facturas.okOne, 'is-ok');
      } else if (subidas > 0) {
        mensaje(carpeta, `${tpl(I18N.facturas.partial, { ok: subidas, fail: fallos })} (${ultimoError})`, 'is-error');
      } else {
        mensaje(carpeta, `${I18N.facturas.failAll} (${ultimoError})`, 'is-error');
      }

      facturaFile.value = '';
      facturaCamera.value = '';
      renderFacturaList(clienteId);
    }

    facturaFile.addEventListener('change', () => {
      void subirFacturas(Array.from(facturaFile.files ?? []));
    });
    facturaCamera.addEventListener('change', () => {
      void subirFacturas(Array.from(facturaCamera.files ?? []));
    });

    async function logout() {
      await supabase!.auth.signOut();
      showOnly(loginForm);
    }
    logoutBtn1.addEventListener('click', logout);
    logoutBtn2.addEventListener('click', logout);
  }
</script>
