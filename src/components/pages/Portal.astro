---
// Portal de clientes. Login por enlace mágico (Supabase Auth), sin
// contraseña. Toda la lógica corre en el navegador: el acceso a los datos
// lo protege RLS en la base de datos, no este código.
//
// La ficha del cliente en la tabla `clientes` se vincula por email (no por
// el id interno de Supabase Auth): así se puede dar de alta a un cliente
// con solo su email, antes incluso de que haya iniciado sesión por primera
// vez. Ver el SQL de configuración en la memoria del proyecto.
//
// Disponible en es/ca/en: los textos vienen de ui.ts (t.portal). Los que
// necesita el <script> del navegador viajan en el <script type="application/json">
// del final; las fechas e importes se formatean con `locale` (data-locale).
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useTranslations(lang).portal;

const localeTag: Record<Locale, string> = { es: 'es-ES', ca: 'ca-ES', en: 'en-GB' };
const locale = localeTag[lang];

const EMAIL = 'contacto@asesoriamadal.es';

// CTA de "quiero contratar dashboards" con asunto ya escrito: mismo texto en
// el enlace y en el asunto del email, a propósito (distinguir en el buzón
// estos leads de un "Contacta con nosotros" genérico).
const dashboardsCtaSubject = t.dashboards.reportingCta;
const dashboardsCtaHref = `mailto:${EMAIL}?subject=${encodeURIComponent(dashboardsCtaSubject)}`;
---

<div class="portal-page" data-locale={locale}>
  <p class="eyebrow">{t.eyebrow}</p>
  <h2 class="section-title">{t.title}</h2>

  <div class="portal-box">
    <div id="portal-loading">
      <p>{t.loading}</p>
    </div>

    <div id="portal-unconfigured" hidden>
      <p>{t.unconfiguredPre}<a href={`mailto:${EMAIL}`}>{EMAIL}</a>{t.unconfiguredPost}</p>
    </div>

    <form id="portal-login-form" hidden class="portal-form-wrap">
      <p>{t.loginIntro}</p>
      <div class="portal-form">
        <input type="email" id="portal-email" name="email" placeholder={t.emailPlaceholder} required autocomplete="email" />
        <button type="submit" class="btn btn-primary">{t.sendLink}</button>
      </div>
      <p id="portal-login-msg" class="portal-msg" hidden></p>
    </form>

    <div id="portal-unlinked" hidden>
      <p>{t.unlinkedPre}<a href={`mailto:${EMAIL}`}>{EMAIL}</a>{t.unlinkedPost}</p>
      <button type="button" id="portal-logout-1" class="portal-logout">{t.logout}</button>
    </div>

    <div id="portal-dash" class="portal-dash" hidden>
      <div class="app-shell">
        <aside class="app-sidebar">
          <a href="/" class="wordmark">Asesoría<span>Madal</span></a>
          <nav class="app-nav">
            <button type="button" class="app-nav-link active" data-panel="dashboards">{t.nav.dashboards}</button>
            <button type="button" class="app-nav-link" data-panel="facturas">{t.nav.facturas}</button>
            <button type="button" class="app-nav-link" data-panel="documentacion">{t.nav.documentacion}</button>
          </nav>
          <div class="app-sidebar-foot">
            <span>{t.greeting} <span id="portal-nombre"></span></span>
            <div class="app-lang" aria-label={t.langLabel}>
              <a href="/portal" class={lang === 'es' ? 'active' : ''} hreflang="es">ES</a>
              <a href="/ca/portal" class={lang === 'ca' ? 'active' : ''} hreflang="ca">CA</a>
              <a href="/en/portal" class={lang === 'en' ? 'active' : ''} hreflang="en">EN</a>
            </div>
            <button type="button" id="portal-logout-2" class="portal-logout">{t.logout}</button>
          </div>
        </aside>

        <main class="app-main">
          <section class="app-panel" data-panel="dashboards">
            <h2>{t.dashboards.title}</h2>
            <div id="proximo-impuesto" class="portal-stats" hidden>
              <div class="portal-stat">
                <span class="portal-stat-value" id="stat-dias-impuesto">—</span>
                <span class="portal-stat-label" id="stat-dias-impuesto-label">{t.dashboards.diasImpuestoLabel}</span>
              </div>
            </div>
            <div id="panel-reporting-off" hidden>
              <div class="portal-stats">
                <div class="portal-stat">
                  <span class="portal-stat-value" id="stat-facturas-mes">—</span>
                  <span class="portal-stat-label">{t.dashboards.facturasMes}</span>
                </div>
                <div class="portal-stat">
                  <span class="portal-stat-value" id="stat-facturas-media">—</span>
                  <span class="portal-stat-label">{t.dashboards.facturasMedia}</span>
                </div>
              </div>
              <div class="portal-empty">
                <p>{t.dashboards.reportingOffIntro}</p>
                <ul class="finanzas-preview-list">
                  {t.dashboards.reportingOffList.map((it) => (
                    <li><strong>{it.strong}</strong>{it.rest}</li>
                  ))}
                </ul>
                <p>{t.dashboards.reportingOffPrice}</p>
              </div>
              <a href={dashboardsCtaHref} class="btn btn-primary">{t.dashboards.reportingCta}</a>
            </div>
            <div id="panel-reporting-on" hidden>
              <div id="finanzas-empty" class="portal-empty">
                {t.dashboards.noData}
              </div>
              <div id="finanzas-datos" hidden>
                <div class="finanzas-periodo-bar">
                  <label for="finanzas-periodo-select">{t.dashboards.mesLabel}</label>
                  <select id="finanzas-periodo-select"></select>
                </div>
                <p class="field-hint" id="finanzas-actualizado"></p>

                <div class="portal-stats portal-stats-color">
                  <div class="portal-stat">
                    <span class="portal-stat-value is-good" id="stat-ingresos">—</span>
                    <span class="portal-stat-label">{t.dashboards.ingresosMes}</span>
                  </div>
                  <div class="portal-stat">
                    <span class="portal-stat-value is-bad" id="stat-gastos">—</span>
                    <span class="portal-stat-label">{t.dashboards.gastosMes}</span>
                  </div>
                  <div class="portal-stat">
                    <span class="portal-stat-value" id="stat-resultado">—</span>
                    <span class="portal-stat-label">{t.dashboards.resultadoMes}</span>
                  </div>
                  <div class="portal-stat" id="tesoreria-card">
                    <span class="portal-stat-value" id="stat-tesoreria">—</span>
                    <span class="portal-stat-label">{t.dashboards.tesoreria}</span>
                  </div>
                </div>

                <h3 class="finanzas-subtitle">{t.dashboards.evolucionTitle}</h3>
                <div id="finanzas-evolucion" class="finanzas-evolucion"></div>
                <div class="finanzas-evo-legend">
                  <span><i class="dot" style="background:var(--accent)"></i> {t.dashboards.legendIngresos}</span>
                  <span><i class="dot" style="background:var(--warm)"></i> {t.dashboards.legendGastos}</span>
                  <span><i class="dot" style="background:var(--ink)"></i> {t.dashboards.legendBeneficio}</span>
                </div>

                <h3 class="finanzas-subtitle">{t.dashboards.acumuladoTitle}</h3>
                <div class="portal-stats portal-stats-color">
                  <div class="portal-stat">
                    <span class="portal-stat-value is-good" id="stat-ingresos-ytd">—</span>
                    <span class="portal-stat-label">{t.dashboards.ingresosAcum}</span>
                  </div>
                  <div class="portal-stat">
                    <span class="portal-stat-value is-bad" id="stat-gastos-ytd">—</span>
                    <span class="portal-stat-label">{t.dashboards.gastosAcum}</span>
                  </div>
                  <div class="portal-stat">
                    <span class="portal-stat-value" id="stat-beneficio-ytd">—</span>
                    <span class="portal-stat-label">{t.dashboards.beneficioAcum}</span>
                  </div>
                </div>

                <h3 class="finanzas-subtitle">{t.dashboards.gastosTipoTitle}</h3>
                <p id="gastosCategoriaEmpty" class="factura-empty" hidden>{t.dashboards.gastosTipoEmpty}</p>
                <div id="gastosCategoriaList" class="finanzas-barlist"></div>

                <h3 class="finanzas-subtitle">{t.dashboards.ivaTitle}</h3>
                <div class="finanzas-detalle">
                  <div class="finanzas-detalle-linea"><span>{t.dashboards.ivaRepercutido}</span><span id="iva-repercutido">—</span></div>
                  <div class="finanzas-detalle-linea"><span>{t.dashboards.ivaSoportado}</span><span id="iva-soportado">—</span></div>
                  <div class="finanzas-detalle-linea"><span>{t.dashboards.ivaCompensar}</span><span id="iva-compensar">—</span></div>
                  <div class="finanzas-detalle-linea finanzas-detalle-total"><span id="iva-resultado-label">{t.dashboards.ivaResultado}</span><span id="iva-resultado-final">—</span></div>
                </div>

                <div id="modelo-130-section">
                  <h3 class="finanzas-subtitle">{t.dashboards.m130Title}</h3>
                  <div class="finanzas-detalle">
                    <div class="finanzas-detalle-linea"><span>{t.dashboards.m130Ingresos}</span><span id="m130-ingresos">—</span></div>
                    <div class="finanzas-detalle-linea"><span>{t.dashboards.m130Gastos}</span><span id="m130-gastos">—</span></div>
                    <div class="finanzas-detalle-linea"><span>{t.dashboards.m130Rendimiento}</span><span id="m130-rendimiento">—</span></div>
                    <div class="finanzas-detalle-linea"><span>{t.dashboards.m130Retenciones}</span><span id="m130-retenciones">—</span></div>
                    <div class="finanzas-detalle-linea"><span>{t.dashboards.m130Anteriores}</span><span id="m130-anteriores">—</span></div>
                    <div class="finanzas-detalle-linea finanzas-detalle-total"><span>{t.dashboards.m130Pago}</span><span id="m130-pago">—</span></div>
                  </div>
                </div>

                <h3 class="finanzas-subtitle">{t.dashboards.pendientesTitle} <span class="finanzas-actual-tag">{t.dashboards.pendientesTag}</span></h3>
                <div class="finanzas-pendientes">
                  <div>
                    <p class="field-group-label">{t.dashboards.cobrosTitle}</p>
                    <p id="cobrosEmpty" class="factura-empty" hidden>{t.dashboards.cobrosEmpty}</p>
                    <ul id="cobrosList" class="factura-list"></ul>
                  </div>
                  <div>
                    <p class="field-group-label">{t.dashboards.pagosTitle}</p>
                    <p id="pagosEmpty" class="factura-empty" hidden>{t.dashboards.pagosEmpty}</p>
                    <ul id="pagosList" class="factura-list"></ul>
                  </div>
                </div>

                <p class="field-hint finanzas-disclaimer">
                  {t.dashboards.disclaimer}
                </p>
              </div>
            </div>
          </section>

          <section class="app-panel" data-panel="facturas" hidden>
            <h2>{t.facturas.title}</h2>
            <p>{t.facturas.intro}</p>
            <form id="facturaForm" class="factura-upload">
              <input type="file" id="facturaFile" accept="application/pdf" multiple required />
              <button type="submit" class="btn btn-primary">{t.facturas.submit}</button>
            </form>
            <p id="facturaMsg" class="portal-msg" hidden></p>
            <p id="facturaEmpty" class="factura-empty" hidden>{t.facturas.empty}</p>
            <ul id="facturaList" class="factura-list"></ul>
          </section>

          <section class="app-panel" data-panel="documentacion" hidden>
            <h2>{t.doc.title}</h2>

            <div class="field-group">
              <p class="field-group-label">{t.doc.guiaGroup}</p>
              <ul class="doc-list">
                <li>
                  <a href="https://suslwmgqdzingeqhfrpw.supabase.co/storage/v1/object/public/docs-publicos/Guia_Area_Clientes.pdf" target="_blank" rel="noopener">
                    {t.doc.guiaLink}
                  </a>
                </li>
              </ul>
            </div>

            <div class="field-group">
              <p class="field-group-label">{t.doc.presentacionGroup}</p>
              <ul id="doc-presentacion-autonomo" class="doc-list" hidden>
                <li>
                  <a href="https://suslwmgqdzingeqhfrpw.supabase.co/storage/v1/object/public/docs-publicos/Presentacion_Autonomos.pdf" target="_blank" rel="noopener">
                    {t.doc.presentacionAutonomo}
                  </a>
                </li>
              </ul>
              <ul id="doc-presentacion-sl" class="doc-list" hidden>
                <li>
                  <a href="https://suslwmgqdzingeqhfrpw.supabase.co/storage/v1/object/public/docs-publicos/Presentacion_SL.pdf" target="_blank" rel="noopener">
                    {t.doc.presentacionSl}
                  </a>
                </li>
              </ul>
              <p id="doc-presentacion-pendiente" class="field-hint" hidden>
                {t.doc.presentacionPendientePre}<a href={`mailto:${EMAIL}`}>{EMAIL}</a>{t.doc.presentacionPendientePost}
              </p>
            </div>

            <div class="field-group">
              <p class="field-group-label">{t.doc.apoderamientoGroup}</p>
              <ul class="doc-list">
                <li>
                  <a href="https://suslwmgqdzingeqhfrpw.supabase.co/storage/v1/object/public/docs-publicos/Pasos_Apoderamiento_AEAT.pdf" target="_blank" rel="noopener">
                    {t.doc.apoderamientoAeat}
                  </a>
                </li>
                <li>
                  <a href="https://suslwmgqdzingeqhfrpw.supabase.co/storage/v1/object/public/docs-publicos/Pasos_Apoderamiento_Seguridad_Social.pdf" target="_blank" rel="noopener">
                    {t.doc.apoderamientoSs}
                  </a>
                </li>
              </ul>
            </div>

            <div class="field-group">
              <p class="field-group-label">{t.doc.rgpdGroup}</p>
              <ul class="doc-list">
                <li>
                  <a href="https://suslwmgqdzingeqhfrpw.supabase.co/storage/v1/object/public/docs-publicos/RGPD.pdf" target="_blank" rel="noopener">
                    {t.doc.rgpdLink}
                  </a>
                </li>
              </ul>
            </div>
          </section>
        </main>
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="portal-i18n" is:inline set:html={JSON.stringify(t)} />

<style>
  .app-lang { display: flex; gap: 0.35rem; margin: 0.15rem 0 0.1rem; }
  .app-lang a {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--ink-soft);
    text-decoration: none;
    padding: 0.1rem 0.32rem;
    border-radius: 6px;
  }
  .app-lang a:hover { color: var(--ink); }
  .app-lang a.active {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
</style>

<script>
  import { getSupabaseBrowser } from '../../lib/supabaseClient';
  import { proximaPresentacion } from '../../lib/modelosFiscales';

  // Textos que necesita este script (viajan serializados desde el servidor,
  // ya en el idioma de la página) y locale para formatear fechas/importes.
  const I18N = JSON.parse(document.getElementById('portal-i18n')?.textContent || '{}');
  const LOCALE = (document.querySelector('.portal-page') as HTMLElement | null)?.dataset.locale || 'es-ES';

  function tpl(str: string, vars: Record<string, string | number>): string {
    return str.replace(/\{(\w+)\}/g, (_m, key) => String(vars[key] ?? ''));
  }

  const loadingEl = document.getElementById('portal-loading') as HTMLElement;
  const unconfiguredEl = document.getElementById('portal-unconfigured') as HTMLElement;
  const loginForm = document.getElementById('portal-login-form') as HTMLFormElement;
  const emailInput = document.getElementById('portal-email') as HTMLInputElement;
  const loginMsg = document.getElementById('portal-login-msg') as HTMLElement;
  const unlinkedEl = document.getElementById('portal-unlinked') as HTMLElement;
  const dashEl = document.getElementById('portal-dash') as HTMLElement;
  const nombreEl = document.getElementById('portal-nombre') as HTMLElement;
  const logoutBtn1 = document.getElementById('portal-logout-1') as HTMLButtonElement;
  const logoutBtn2 = document.getElementById('portal-logout-2') as HTMLButtonElement;

  const reportingOffEl = document.getElementById('panel-reporting-off') as HTMLElement;
  const reportingOnEl = document.getElementById('panel-reporting-on') as HTMLElement;
  const statFacturasMesEl = document.getElementById('stat-facturas-mes') as HTMLElement;
  const statFacturasMediaEl = document.getElementById('stat-facturas-media') as HTMLElement;

  const proximoImpuestoEl = document.getElementById('proximo-impuesto') as HTMLElement;
  const statDiasImpuestoEl = document.getElementById('stat-dias-impuesto') as HTMLElement;
  const statDiasImpuestoLabelEl = document.getElementById('stat-dias-impuesto-label') as HTMLElement;

  const finanzasEmptyEl = document.getElementById('finanzas-empty') as HTMLElement;
  const finanzasDatosEl = document.getElementById('finanzas-datos') as HTMLElement;
  const finanzasPeriodoSelectEl = document.getElementById('finanzas-periodo-select') as HTMLSelectElement;
  const finanzasActualizadoEl = document.getElementById('finanzas-actualizado') as HTMLElement;
  const statIngresosEl = document.getElementById('stat-ingresos') as HTMLElement;
  const statGastosEl = document.getElementById('stat-gastos') as HTMLElement;
  const statResultadoEl = document.getElementById('stat-resultado') as HTMLElement;
  const statTesoreriaEl = document.getElementById('stat-tesoreria') as HTMLElement;
  const tesoreriaCardEl = document.getElementById('tesoreria-card') as HTMLElement;
  const modelo130SectionEl = document.getElementById('modelo-130-section') as HTMLElement;
  const statIngresosYtdEl = document.getElementById('stat-ingresos-ytd') as HTMLElement;
  const statGastosYtdEl = document.getElementById('stat-gastos-ytd') as HTMLElement;
  const statBeneficioYtdEl = document.getElementById('stat-beneficio-ytd') as HTMLElement;
  const finanzasEvolucionEl = document.getElementById('finanzas-evolucion') as HTMLElement;
  const gastosCategoriaEmptyEl = document.getElementById('gastosCategoriaEmpty') as HTMLElement;
  const gastosCategoriaListEl = document.getElementById('gastosCategoriaList') as HTMLElement;
  const ivaRepercutidoEl = document.getElementById('iva-repercutido') as HTMLElement;
  const ivaSoportadoEl = document.getElementById('iva-soportado') as HTMLElement;
  const ivaCompensarEl = document.getElementById('iva-compensar') as HTMLElement;
  const ivaResultadoLabelEl = document.getElementById('iva-resultado-label') as HTMLElement;
  const ivaResultadoFinalEl = document.getElementById('iva-resultado-final') as HTMLElement;
  const m130IngresosEl = document.getElementById('m130-ingresos') as HTMLElement;
  const m130GastosEl = document.getElementById('m130-gastos') as HTMLElement;
  const m130RendimientoEl = document.getElementById('m130-rendimiento') as HTMLElement;
  const m130RetencionesEl = document.getElementById('m130-retenciones') as HTMLElement;
  const m130AnterioresEl = document.getElementById('m130-anteriores') as HTMLElement;
  const m130PagoEl = document.getElementById('m130-pago') as HTMLElement;
  const cobrosEmptyEl = document.getElementById('cobrosEmpty') as HTMLElement;
  const cobrosListEl = document.getElementById('cobrosList') as HTMLElement;
  const pagosEmptyEl = document.getElementById('pagosEmpty') as HTMLElement;
  const pagosListEl = document.getElementById('pagosList') as HTMLElement;

  const docPresentacionAutonomoEl = document.getElementById('doc-presentacion-autonomo') as HTMLElement;
  const docPresentacionSlEl = document.getElementById('doc-presentacion-sl') as HTMLElement;
  const docPresentacionPendienteEl = document.getElementById('doc-presentacion-pendiente') as HTMLElement;

  const navLinks = Array.from(document.querySelectorAll<HTMLButtonElement>('.app-nav-link'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.app-panel'));

  const facturaForm = document.getElementById('facturaForm') as HTMLFormElement;
  const facturaFile = document.getElementById('facturaFile') as HTMLInputElement;
  const facturaMsg = document.getElementById('facturaMsg') as HTMLElement;
  const facturaEmpty = document.getElementById('facturaEmpty') as HTMLElement;
  const facturaList = document.getElementById('facturaList') as HTMLElement;

  function showOnly(el: HTMLElement) {
    for (const section of [unconfiguredEl, loginForm, unlinkedEl, dashEl]) {
      section.hidden = section !== el;
    }
    loadingEl.hidden = true;
    // El área de cliente logueada sustituye la cabecera y el pie de la web
    // de marketing por su propia barra lateral: una vez dentro, no tiene
    // sentido volver a "Inicio" o "Altas" desde la barra horizontal.
    document.body.classList.toggle('portal-app', el === dashEl);
  }

  navLinks.forEach((link) => {
    link.addEventListener('click', () => {
      const target = link.dataset.panel;
      navLinks.forEach((l) => l.classList.toggle('active', l === link));
      panels.forEach((p) => { p.hidden = p.dataset.panel !== target; });
    });
  });

  function renderReportingPanel(hasReporting: boolean) {
    reportingOffEl.hidden = hasReporting;
    reportingOnEl.hidden = !hasReporting;
  }

  // Independiente de `reporting`: saber cuándo toca presentar impuestos es
  // información básica de gestoría, no una funcionalidad de pago. Se oculta
  // solo si el cliente todavía no tiene ningún modelo marcado en Supabase.
  function renderProximoImpuesto(modelos: string[]) {
    const proxima = proximaPresentacion(modelos);
    proximoImpuestoEl.hidden = !proxima;
    if (proxima) {
      statDiasImpuestoEl.textContent = String(proxima.dias);
      const fechaTexto = proxima.fecha.toLocaleDateString(LOCALE, { day: '2-digit', month: '2-digit', year: 'numeric' });
      // Varios modelos suelen compartir la misma fecha (130/111/303 se
      // presentan el mismo día): se listan todos, no solo el primero.
      const codigos = proxima.modelos.map((m) => m.modelo);
      const listaModelos =
        codigos.length > 1
          ? `${codigos.slice(0, -1).join(', ')} ${I18N.dashboards.joinY} ${codigos[codigos.length - 1]}`
          : codigos[0];
      const prefijo = codigos.length > 1 ? I18N.dashboards.diasHastaModeloPlur : I18N.dashboards.diasHastaModeloSing;
      statDiasImpuestoLabelEl.textContent = `${prefijo} ${listaModelos} (${fechaTexto})`;
    }
  }

  // tipo_persona: 'autonomo' | 'sl' | null (todavía sin marcar por el equipo).
  function renderDocumentacionPanel(tipoPersona: string | null) {
    docPresentacionAutonomoEl.hidden = tipoPersona !== 'autonomo';
    docPresentacionSlEl.hidden = tipoPersona !== 'sl';
    docPresentacionPendienteEl.hidden = tipoPersona === 'autonomo' || tipoPersona === 'sl';
  }

  // Tesorería no aplica a autónomos (mezcla caja personal/negocio, no es una
  // métrica útil para ellos); modelo 130 es pago fraccionado de IRPF, no
  // aplica a SL (tributan por Impuesto de Sociedades, modelo 202). Si
  // tipo_persona todavía no está marcado (null), se muestran ambos por
  // defecto en vez de ocultar información sin saber a quién aplica.
  function renderFinanzasVisibilidadPorTipo(tipoPersona: string | null) {
    tesoreriaCardEl.hidden = tipoPersona === 'autonomo';
    modelo130SectionEl.hidden = tipoPersona === 'sl';
  }

  // "Media de facturas al mes" se calcula solo sobre los meses en los que
  // ya hay al menos una factura subida (no desde el alta del cliente): así
  // un cliente recién incorporado sin histórico no arranca con una media
  // engañosamente baja por meses sin actividad todavía.
  function renderFacturaStats(rows: { fecha_subida: string }[]) {
    const now = new Date();
    const mesActualKey = `${now.getFullYear()}-${now.getMonth()}`;
    const mesesConFacturas = new Set<string>();
    let facturasEsteMes = 0;

    rows.forEach((row) => {
      const fecha = new Date(row.fecha_subida);
      const key = `${fecha.getFullYear()}-${fecha.getMonth()}`;
      mesesConFacturas.add(key);
      if (key === mesActualKey) facturasEsteMes++;
    });

    statFacturasMesEl.textContent = String(facturasEsteMes);
    statFacturasMediaEl.textContent = rows.length > 0 ? (rows.length / mesesConFacturas.size).toFixed(1) : '0';
  }

  const supabase = getSupabaseBrowser();

  if (!supabase) {
    showOnly(unconfiguredEl);
  } else {
    function formatFecha(iso: string) {
      return new Date(iso).toLocaleDateString(LOCALE, { day: '2-digit', month: '2-digit', year: 'numeric' });
    }

    function formatEur(v: number) {
      return new Intl.NumberFormat(LOCALE, { style: 'currency', currency: 'EUR' }).format(v);
    }

    // Id interno de clientes (no el auth.uid() de la sesión) — es lo que
    // usa facturas_subidas.cliente_id. Se rellena al cargar el dashboard.
    let currentClienteId: string | null = null;

    async function renderFacturaList(clienteId: string) {
      const { data, error } = await supabase!
        .from('facturas_subidas')
        .select('id, nombre_archivo, storage_path, fecha_subida, fecha_contabilizado')
        .eq('cliente_id', clienteId)
        .order('fecha_subida', { ascending: false });

      facturaList.innerHTML = '';
      const rows = !error && data ? data : [];
      facturaEmpty.hidden = rows.length > 0;
      renderFacturaStats(rows);

      rows.forEach((row) => {
        const li = document.createElement('li');

        const nombre = document.createElement('div');
        nombre.className = 'factura-nombre';
        nombre.textContent = row.nombre_archivo as string;
        li.appendChild(nombre);

        const meta = document.createElement('div');
        meta.className = 'factura-meta';
        const subida = `${I18N.facturas.uploadedPrefix} ${formatFecha(row.fecha_subida as string)}`;
        const contabilizado = row.fecha_contabilizado
          ? `${I18N.facturas.accountedPrefix} ${formatFecha(row.fecha_contabilizado as string)}`
          : I18N.facturas.pendingAccounting;
        meta.textContent = `${subida} · ${contabilizado}`;
        li.appendChild(meta);

        if (row.storage_path) {
          const descargar = document.createElement('button');
          descargar.type = 'button';
          descargar.className = 'factura-descargar';
          descargar.textContent = I18N.facturas.download;
          descargar.addEventListener('click', async () => {
            const { data: signed } = await supabase!.storage
              .from('facturas')
              .createSignedUrl(row.storage_path as string, 60);
            if (signed?.signedUrl) {
              window.open(signed.signedUrl, '_blank');
            } else {
              // El registro sigue aquí pero el archivo ya no está en el Storage
              // (borrado a mano sin limpiar storage_path, o ya archivado en Drive).
              alert(I18N.facturas.gone);
            }
          });
          li.appendChild(descargar);
        }

        facturaList.appendChild(li);
      });
    }

    type Pendiente = { nombre: string | null; fecha_vencimiento: string | null; importe: number };

    function renderPendienteList(listEl: HTMLElement, emptyEl: HTMLElement, rows: Pendiente[]) {
      listEl.innerHTML = '';
      emptyEl.hidden = rows.length > 0;

      rows.forEach((row) => {
        const li = document.createElement('li');

        const nombre = document.createElement('div');
        nombre.className = 'factura-nombre';
        nombre.textContent = row.nombre || I18N.dashboards.sinNombre;
        li.appendChild(nombre);

        const meta = document.createElement('div');
        meta.className = 'factura-meta';
        const fecha = row.fecha_vencimiento
          ? `${I18N.dashboards.vencePrefix} ${formatFecha(row.fecha_vencimiento)}`
          : I18N.dashboards.sinVencimiento;
        meta.textContent = `${fecha} · ${formatEur(row.importe ?? 0)}`;
        li.appendChild(meta);

        listEl.appendChild(li);
      });
    }

    const CATEGORIA_COLORS = ['var(--accent)', 'var(--warm)', 'var(--accent-strong)', 'color-mix(in srgb, var(--accent) 50%, var(--warm) 50%)'];

    // Para importes donde positivo = "toca pagar" (IVA a pagar, por ejemplo).
    function setSigno(el: HTMLElement, valor: number) {
      el.classList.toggle('is-bad', valor > 0);
      el.classList.toggle('is-good', valor <= 0);
    }

    // Para importes donde positivo = bueno (beneficio, tesorería a favor).
    function setSignoInvertido(el: HTMLElement, valor: number) {
      el.classList.toggle('is-good', valor >= 0);
      el.classList.toggle('is-bad', valor < 0);
    }

    const SVG_NS = 'http://www.w3.org/2000/svg';

    // Grafico de lineas (ingresos/gastos/beneficio) en SVG a mano, sin
    // libreria: tres <polyline> sobre un viewBox fijo, con un punto <circle>
    // por mes (con su valor exacto como title, al pasar el raton) y una
    // linea de base en cero si el rango de valores la cruza (para que un
    // beneficio negativo se vea claramente por debajo de la linea).
    function renderEvolucion(rows: { periodo: string; ingresos: number; gastos: number }[]) {
      finanzasEvolucionEl.innerHTML = '';
      if (rows.length === 0) {
        const p = document.createElement('p');
        p.className = 'factura-empty';
        p.textContent = I18N.dashboards.evolucionEmpty;
        finanzasEvolucionEl.appendChild(p);
        return;
      }

      const puntos = rows.map((r) => ({ periodo: r.periodo, ingresos: r.ingresos, gastos: r.gastos, beneficio: r.ingresos - r.gastos }));
      const valores = puntos.flatMap((p) => [p.ingresos, p.gastos, p.beneficio]);
      const W = 640;
      const H = 200;
      const PAD_X = 20;
      const PAD_Y = 18;
      const max = Math.max(...valores, 0);
      const min = Math.min(...valores, 0);
      const rango = Math.max(max - min, 1);
      const stepX = puntos.length > 1 ? (W - PAD_X * 2) / (puntos.length - 1) : 0;
      const x = (i: number) => PAD_X + i * stepX;
      const y = (v: number) => H - PAD_Y - ((v - min) / rango) * (H - PAD_Y * 2);

      const svg = document.createElementNS(SVG_NS, 'svg');
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      svg.setAttribute('class', 'finanzas-evo-svg');
      svg.setAttribute('preserveAspectRatio', 'none');

      if (min < 0 && max > 0) {
        const baseline = document.createElementNS(SVG_NS, 'line');
        baseline.setAttribute('x1', String(PAD_X));
        baseline.setAttribute('x2', String(W - PAD_X));
        baseline.setAttribute('y1', String(y(0)));
        baseline.setAttribute('y2', String(y(0)));
        baseline.setAttribute('class', 'finanzas-evo-baseline');
        svg.appendChild(baseline);
      }

      const series: { valores: number[]; color: string }[] = [
        { valores: puntos.map((p) => p.ingresos), color: 'var(--accent)' },
        { valores: puntos.map((p) => p.gastos), color: 'var(--warm)' },
        { valores: puntos.map((p) => p.beneficio), color: 'var(--ink)' },
      ];

      series.forEach((s) => {
        const polyline = document.createElementNS(SVG_NS, 'polyline');
        polyline.setAttribute('points', s.valores.map((v, i) => `${x(i)},${y(v)}`).join(' '));
        polyline.setAttribute('class', 'finanzas-evo-line');
        polyline.setAttribute('style', `stroke:${s.color}`);
        svg.appendChild(polyline);

        s.valores.forEach((v, i) => {
          const circle = document.createElementNS(SVG_NS, 'circle');
          circle.setAttribute('cx', String(x(i)));
          circle.setAttribute('cy', String(y(v)));
          circle.setAttribute('r', '3.5');
          circle.setAttribute('style', `fill:${s.color}`);
          const title = document.createElementNS(SVG_NS, 'title');
          title.textContent = formatEur(v);
          circle.appendChild(title);
          svg.appendChild(circle);
        });
      });

      finanzasEvolucionEl.appendChild(svg);

      const labels = document.createElement('div');
      labels.className = 'finanzas-evo-labels';
      puntos.forEach((p) => {
        const span = document.createElement('span');
        span.textContent = new Date(p.periodo).toLocaleDateString(LOCALE, { month: 'short', year: '2-digit' });
        labels.appendChild(span);
      });
      finanzasEvolucionEl.appendChild(labels);
    }

    function renderGastosCategoria(rows: { categoria: string; importe: number }[]) {
      gastosCategoriaListEl.innerHTML = '';
      gastosCategoriaEmptyEl.hidden = rows.length > 0;
      if (rows.length === 0) return;

      const ordenado = [...rows].sort((a, b) => b.importe - a.importe);
      const max = Math.max(...ordenado.map((r) => r.importe), 1);

      ordenado.forEach((row, i) => {
        const wrap = document.createElement('div');
        wrap.className = 'finanzas-bar-row';

        const label = document.createElement('div');
        label.className = 'finanzas-bar-label';
        const nombre = document.createElement('span');
        nombre.textContent = row.categoria;
        const amt = document.createElement('span');
        amt.className = 'amt';
        amt.textContent = formatEur(row.importe);
        label.appendChild(nombre);
        label.appendChild(amt);
        wrap.appendChild(label);

        const track = document.createElement('div');
        track.className = 'finanzas-bar-track';
        const fill = document.createElement('div');
        fill.className = 'finanzas-bar-fill';
        fill.style.width = `${Math.max(2, (row.importe / max) * 100)}%`;
        fill.style.background = CATEGORIA_COLORS[i % CATEGORIA_COLORS.length];
        track.appendChild(fill);
        wrap.appendChild(track);

        gastosCategoriaListEl.appendChild(wrap);
      });
    }

    type PeriodoRow = {
      periodo: string;
      ingresos: number;
      gastos: number;
      tesoreria: number;
      iva_repercutido: number;
      iva_soportado: number;
      iva_a_compensar: number;
      pago_fraccionado_130_anteriores: number;
      pago_fraccionado_130: number;
      ingresos_ytd: number;
      gastos_ytd: number;
      retenciones_soportadas_ytd: number;
      sincronizado_at: string;
    };

    // Pinta los paneles que dependen del mes elegido en el desplegable: KPIs
    // del mes, IVA y 130 (estos dos usan los campos *_ytd/*_a_compensar tal
    // como se guardaron en esa fila — cada fila de dashboard_periodos ya
    // lleva su propio acumulado del año calculado en su momento, asi que
    // elegir un mes antiguo enseña el acumulado tal como estaba entonces,
    // no el de hoy) y los gastos por categoria (desde el 1 de enero del año
    // de ese periodo hasta ese mismo periodo, no mas alla).
    async function pintarPeriodo(clienteId: string, row: PeriodoRow) {
      const actualizado = new Date(row.sincronizado_at);
      finanzasActualizadoEl.textContent = `${I18N.dashboards.updatedPrefix} ${actualizado.toLocaleDateString(LOCALE, { day: '2-digit', month: '2-digit', year: 'numeric' })}`;

      const ingresos = Number(row.ingresos) || 0;
      const gastos = Number(row.gastos) || 0;
      const resultado = ingresos - gastos;
      const tesoreria = Number(row.tesoreria) || 0;
      statIngresosEl.textContent = formatEur(ingresos);
      statGastosEl.textContent = formatEur(gastos);
      statResultadoEl.textContent = formatEur(resultado);
      statTesoreriaEl.textContent = formatEur(tesoreria);
      setSignoInvertido(statResultadoEl, resultado);
      setSignoInvertido(statTesoreriaEl, tesoreria);

      const ingresosYtd = Number(row.ingresos_ytd) || 0;
      const gastosYtd = Number(row.gastos_ytd) || 0;
      const beneficioYtd = ingresosYtd - gastosYtd;
      statIngresosYtdEl.textContent = formatEur(ingresosYtd);
      statGastosYtdEl.textContent = formatEur(gastosYtd);
      statBeneficioYtdEl.textContent = formatEur(beneficioYtd);
      setSignoInvertido(statBeneficioYtdEl, beneficioYtd);

      const ivaRepercutido = Number(row.iva_repercutido) || 0;
      const ivaSoportado = Number(row.iva_soportado) || 0;
      const ivaCompensar = Number(row.iva_a_compensar) || 0;
      const ivaResultadoFinal = ivaRepercutido - ivaSoportado - ivaCompensar;
      ivaRepercutidoEl.textContent = formatEur(ivaRepercutido);
      ivaSoportadoEl.textContent = formatEur(ivaSoportado);
      ivaCompensarEl.textContent = formatEur(ivaCompensar);
      ivaResultadoLabelEl.textContent = ivaResultadoFinal >= 0 ? I18N.dashboards.ivaResultadoPagar : I18N.dashboards.ivaResultadoDevolver;
      ivaResultadoFinalEl.textContent = formatEur(ivaResultadoFinal);
      setSigno(ivaResultadoFinalEl, ivaResultadoFinal);

      const rendimientoNeto = ingresosYtd - gastosYtd;
      m130IngresosEl.textContent = formatEur(ingresosYtd);
      m130GastosEl.textContent = formatEur(gastosYtd);
      m130RendimientoEl.textContent = formatEur(rendimientoNeto);
      m130RetencionesEl.textContent = formatEur(Number(row.retenciones_soportadas_ytd) || 0);
      m130AnterioresEl.textContent = formatEur(Number(row.pago_fraccionado_130_anteriores) || 0);
      m130PagoEl.textContent = formatEur(Number(row.pago_fraccionado_130) || 0);

      const anioIniStr = `${new Date(row.periodo).getFullYear()}-01-01`;
      const { data: gastosCategoria } = await supabase!
        .from('dashboard_gastos_categoria')
        .select('categoria, importe')
        .eq('cliente_id', clienteId)
        .gte('periodo', anioIniStr)
        .lte('periodo', row.periodo);

      const acumuladoCategoria = new Map<string, number>();
      ((gastosCategoria ?? []) as { categoria: string; importe: number }[]).forEach((r) => {
        acumuladoCategoria.set(r.categoria, (acumuladoCategoria.get(r.categoria) ?? 0) + (Number(r.importe) || 0));
      });
      renderGastosCategoria(Array.from(acumuladoCategoria, ([categoria, importe]) => ({ categoria, importe })));
    }

    // El desplegable de mes y el grafico de evolucion usan los ultimos 12
    // meses de dashboard_periodos — el sincronizador manda un upsert por mes
    // cada vez que corre, asi que el historico se va acumulando solo. Los
    // cobros/pagos pendientes NO dependen del mes elegido (esa tabla no
    // guarda historico, siempre es el estado actual — ver comentario en
    // schema.sql), asi que se cargan una sola vez aqui.
    async function renderFinanzas(clienteId: string) {
      const { data: periodos } = await supabase!
        .from('dashboard_periodos')
        .select(
          'periodo, ingresos, gastos, tesoreria, iva_repercutido, iva_soportado, iva_a_compensar, pago_fraccionado_130_anteriores, pago_fraccionado_130, ingresos_ytd, gastos_ytd, retenciones_soportadas_ytd, sincronizado_at'
        )
        .eq('cliente_id', clienteId)
        .order('periodo', { ascending: false })
        .limit(12);

      const rows = (periodos ?? []) as PeriodoRow[];
      const ultimo = rows.length > 0 ? rows[0] : null;
      finanzasEmptyEl.hidden = ultimo !== null;
      finanzasDatosEl.hidden = ultimo === null;
      if (!ultimo) return;

      finanzasPeriodoSelectEl.innerHTML = '';
      rows.forEach((row) => {
        const option = document.createElement('option');
        option.value = row.periodo;
        option.textContent = new Date(row.periodo).toLocaleDateString(LOCALE, { month: 'long', year: 'numeric' });
        finanzasPeriodoSelectEl.appendChild(option);
      });
      finanzasPeriodoSelectEl.value = ultimo.periodo;
      finanzasPeriodoSelectEl.onchange = () => {
        const seleccionado = rows.find((r) => r.periodo === finanzasPeriodoSelectEl.value);
        if (seleccionado) pintarPeriodo(clienteId, seleccionado);
      };

      renderEvolucion(
        [...rows].reverse().map((r) => ({ periodo: r.periodo, ingresos: Number(r.ingresos) || 0, gastos: Number(r.gastos) || 0 }))
      );

      await pintarPeriodo(clienteId, ultimo);

      const { data: pendientes } = await supabase!
        .from('dashboard_pendientes')
        .select('tipo, nombre, fecha_vencimiento, importe')
        .eq('cliente_id', clienteId)
        .order('fecha_vencimiento', { ascending: true });

      const pendRows = (pendientes ?? []) as (Pendiente & { tipo: string })[];
      renderPendienteList(cobrosListEl, cobrosEmptyEl, pendRows.filter((r) => r.tipo === 'cobro'));
      renderPendienteList(pagosListEl, pagosEmptyEl, pendRows.filter((r) => r.tipo === 'pago'));
    }

    async function renderForSession() {
      const {
        data: { session },
      } = await supabase!.auth.getSession();

      if (!session) {
        showOnly(loginForm);
        return;
      }

      // Sin filtro por email: RLS ya limita esta consulta a la fila
      // vinculada (auth_user_id = auth.uid()) — si el trigger de alta
      // todavía no la ha vinculado, esto no devuelve nada y cae en
      // "unlinked" más abajo, igual que antes.
      const { data: cliente } = await supabase!
        .from('clientes')
        .select('id, nombre, reporting, tipo_persona, modelos')
        .maybeSingle();

      if (!cliente) {
        showOnly(unlinkedEl);
        return;
      }

      currentClienteId = cliente.id as string;
      nombreEl.textContent = cliente.nombre as string;
      renderReportingPanel(Boolean(cliente.reporting));
      renderProximoImpuesto((cliente.modelos as string[] | null) ?? []);
      if (cliente.reporting) renderFinanzas(currentClienteId);
      renderDocumentacionPanel((cliente.tipo_persona as string | null) ?? null);
      renderFinanzasVisibilidadPorTipo((cliente.tipo_persona as string | null) ?? null);
      renderFacturaList(currentClienteId);
      showOnly(dashEl);
    }

    renderForSession();
    supabase.auth.onAuthStateChange(() => renderForSession());

    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      loginMsg.hidden = false;
      loginMsg.className = 'portal-msg';
      loginMsg.textContent = I18N.login.sending;

      // Vía el endpoint del servidor, no supabase.auth.signInWithOtp
      // directo: así solo un email ya dado de alta en `clientes` puede
      // llegar a recibir el enlace (ver api/portal-login.ts).
      let ok = false;
      try {
        const res = await fetch('/api/portal-login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: emailInput.value, redirectTo: window.location.href.split('?')[0] }),
        });
        ok = res.ok;
      } catch {
        ok = false;
      }

      if (ok) {
        loginMsg.className = 'portal-msg is-ok';
        loginMsg.textContent = I18N.login.sent;
      } else {
        loginMsg.className = 'portal-msg is-error';
        loginMsg.textContent = I18N.login.error;
      }
    });

    facturaForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const files = Array.from(facturaFile.files ?? []);
      if (files.length === 0) return;

      if (files.some((f) => f.type !== 'application/pdf')) {
        facturaMsg.hidden = false;
        facturaMsg.className = 'portal-msg is-error';
        facturaMsg.textContent = I18N.facturas.onlyPdf;
        return;
      }

      const {
        data: { session },
      } = await supabase!.auth.getSession();
      if (!session || !currentClienteId) return;
      const clienteId = currentClienteId;

      facturaMsg.hidden = false;
      facturaMsg.className = 'portal-msg';
      facturaMsg.textContent = files.length > 1 ? tpl(I18N.facturas.uploadingMany, { n: files.length }) : I18N.facturas.uploadingOne;

      // Cada archivo es una subida y una fila independiente en
      // facturas_subidas: varias facturas seleccionadas a la vez cuentan
      // como varias facturas, no como una sola. Se suben en secuencia (no en
      // paralelo) para no saturar la conexión con varios PDFs a la vez.
      let subidas = 0;
      let fallos = 0;

      for (const file of files) {
        // La ruta en Storage usa el NIF del cliente tanto para la carpeta
        // (así lo exige la política de Storage, ver schema.sql) como para
        // prefijar el propio nombre de archivo — mismo id que cliente_id en
        // facturas_subidas, para que carpeta y archivo sean identificables a
        // mano (Drive, revisión manual) en vez de un uid opaco. El timestamp
        // (día/mes-hora/minuto, hora local del navegador) evita que dos
        // subidas del mismo archivo choquen de nombre — se usan guiones en
        // vez de barras porque "/" en la ruta de Storage crearía subcarpetas.
        const now = new Date();
        const pad = (n: number) => String(n).padStart(2, '0');
        const timestamp = `${pad(now.getDate())}${pad(now.getMonth() + 1)}-${pad(now.getHours())}${pad(now.getMinutes())}`;
        const path = `${clienteId}/${clienteId}-${timestamp}-${file.name}`;
        const { error } = await supabase!.storage.from('facturas').upload(path, file, {
          contentType: 'application/pdf',
        });

        if (error) {
          fallos++;
          continue;
        }

        // Si el archivo sube bien pero falla el registro de la fila, no lo
        // contamos como fallo de cara al cliente (el equipo verá el archivo
        // en el Storage igualmente y podrá revisarlo a mano) — pero sí lo
        // dejamos en consola para poder diagnosticar por qué falla el insert
        // (RLS, FK, tipo de columna...).
        const { error: insertError } = await supabase!.from('facturas_subidas').insert({
          cliente_id: clienteId,
          nombre_archivo: file.name,
          storage_path: path,
        });
        if (insertError) {
          console.error('facturas_subidas insert error:', insertError);
        }
        subidas++;
      }

      if (fallos === 0) {
        facturaMsg.className = 'portal-msg is-ok';
        facturaMsg.textContent = subidas > 1 ? tpl(I18N.facturas.okMany, { n: subidas }) : I18N.facturas.okOne;
      } else if (subidas > 0) {
        facturaMsg.className = 'portal-msg is-error';
        facturaMsg.textContent = tpl(I18N.facturas.partial, { ok: subidas, fail: fallos });
      } else {
        facturaMsg.className = 'portal-msg is-error';
        facturaMsg.textContent = I18N.facturas.failAll;
      }

      facturaForm.reset();
      renderFacturaList(clienteId);
    });

    async function logout() {
      await supabase!.auth.signOut();
      showOnly(loginForm);
    }
    logoutBtn1.addEventListener('click', logout);
    logoutBtn2.addEventListener('click', logout);
  }
</script>
