---
// Portal de clientes. Login por enlace mágico (Supabase Auth), sin
// contraseña. Toda la lógica corre en el navegador: el acceso a los datos
// lo protege RLS en la base de datos, no este código.
//
// La ficha del cliente en la tabla `clientes` se vincula por email (no por
// el id interno de Supabase Auth): así se puede dar de alta a un cliente
// con solo su email, antes incluso de que haya iniciado sesión por primera
// vez. Ver el SQL de configuración en la memoria del proyecto.
//
// Disponible en es/ca/en: los textos vienen de ui.ts (t.portal). Los que
// necesita el <script> del navegador viajan en el <script type="application/json">
// del final; las fechas e importes se formatean con `locale` (data-locale).
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';
import { WHATSAPP_NUMBER, CONTACT_EMAIL } from '../../lib/contact';
import CarpetaDocumentos from '../CarpetaDocumentos.astro';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useTranslations(lang).portal;

const localeTag: Record<Locale, string> = { es: 'es-ES', ca: 'ca-ES', en: 'en-GB' };
const locale = localeTag[lang];

const EMAIL = CONTACT_EMAIL;

// Carpetas de la pestaña Documentación. Los códigos se guardan en
// facturas_subidas.carpeta y los usa n8n para decidir la carpeta de Drive
// (ver schema.sql). "banco" solo se ofrece a las SL (lo quita el script).
const CARPETAS_CONTABILIDAD = ['emitidas', 'recibidas', 'simplificadas', 'tickets', 'banco', 'tarjeta'] as const;
const CARPETAS_DOCUMENTACION = ['escrituras', 'contratos', 'prestamos', 'seguros', 'vehiculos', 'subvenciones', 'notificaciones', 'certificados', 'laboral', 'otros'] as const;
const textosCarpeta = { subir: t.doc.subir, foto: t.facturas.cameraSubmit, ver: t.doc.verArchivos, desde: t.doc.desde, hasta: t.doc.hasta };

---

<div class="portal-page" data-locale={locale}>
  <p class="eyebrow">{t.eyebrow}</p>
  <h1 class="section-title">{t.title}</h1>

  <div class="portal-box">
    <div id="portal-loading">
      <p>{t.loading}</p>
    </div>

    <div id="portal-unconfigured" hidden>
      <p>{t.unconfiguredPre}<a href={`mailto:${EMAIL}`}>{EMAIL}</a>{t.unconfiguredPost}</p>
    </div>

    <form id="portal-login-form" hidden class="portal-form-wrap">
      <p>{t.loginIntro}</p>
      <div class="portal-form">
        <input type="email" id="portal-email" name="email" placeholder={t.emailPlaceholder} aria-label={t.emailLabel} required autocomplete="email" />
        <button type="submit" class="btn btn-primary">{t.sendLink}</button>
      </div>
      <p id="portal-login-msg" class="portal-msg" hidden></p>
    </form>

    <div id="portal-unlinked" hidden>
      <p>{t.unlinkedPre}<a href={`mailto:${EMAIL}`}>{EMAIL}</a>{t.unlinkedPost}</p>
      <button type="button" id="portal-logout-1" class="portal-logout">{t.logout}</button>
    </div>

    <div id="portal-dash" class="portal-dash" hidden>
      <div class="app-shell">
        <aside class="app-sidebar">
          <a href="/" class="wordmark">Asesoría<span>Madal</span></a>
          <nav class="app-nav">
            <button type="button" class="app-nav-link active" data-panel="inicio">{t.nav.inicio}</button>
            <button type="button" class="app-nav-link" data-panel="prevision">{t.nav.prevision}</button>
            <button type="button" class="app-nav-link" data-panel="documentos">{t.nav.documentos}</button>
            <button type="button" class="app-nav-link" data-panel="documentacion">{t.nav.documentacion}</button>
          </nav>
          <div class="app-sidebar-foot">
            <div id="duda-rapida" class="duda-rapida">
              <p class="duda-rapida-label">{t.dudaRapida.label}</p>
              <a
                id="duda-rapida-whatsapp"
                class="duda-rapida-link duda-rapida-whatsapp"
                href={`https://wa.me/${WHATSAPP_NUMBER}`}
                target="_blank"
                rel="noopener noreferrer"
                hidden
              >
                {t.dudaRapida.whatsapp}
              </a>
              <a class="duda-rapida-link" href={`mailto:${EMAIL}`}>{t.dudaRapida.email}</a>
            </div>
            <span>{t.greeting} <span id="portal-nombre"></span></span>
            <div class="app-lang" aria-label={t.langLabel}>
              <a href="/portal" class={lang === 'es' ? 'active' : ''} hreflang="es">ES</a>
              <a href="/ca/portal" class={lang === 'ca' ? 'active' : ''} hreflang="ca">CA</a>
              <a href="/en/portal" class={lang === 'en' ? 'active' : ''} hreflang="en">EN</a>
            </div>
            <button type="button" id="portal-logout-2" class="portal-logout">{t.logout}</button>
          </div>
        </aside>

        <div class="app-main">
          <div id="portal-admin-bar" class="portal-admin-bar" hidden>
            <span class="portal-admin-tag">
              {t.admin.bannerPrefix} <strong id="portal-admin-cliente-nombre"></strong>
            </span>
            <label class="portal-admin-select">
              <span>{t.admin.selectLabel}</span>
              <select id="portal-admin-cliente-select"></select>
            </label>
            <span class="portal-admin-note">{t.admin.readonlyNote}</span>
            <button type="button" id="portal-alta-toggle" class="btn btn-primary portal-alta-toggle">{t.admin.alta.open}</button>
          </div>

          <form id="portal-alta-form" class="portal-alta-form" hidden novalidate>
            <div class="portal-alta-grid">
              <label>{t.admin.alta.nif}
                <input type="text" id="alta-nif" maxlength="12" autocomplete="off" />
              </label>
              <label>{t.admin.alta.nombre}
                <input type="text" id="alta-nombre" required maxlength="150" autocomplete="off" />
              </label>
              <label>{t.admin.alta.empresa}
                <input type="text" id="alta-empresa" maxlength="150" autocomplete="off" />
              </label>
              <label>{t.admin.alta.email}
                <input type="email" id="alta-email" maxlength="254" autocomplete="off" />
              </label>
              <label>{t.admin.alta.telefono}
                <input type="tel" id="alta-telefono" maxlength="20" autocomplete="off" />
              </label>
              <label>{t.admin.alta.idioma}
                <select id="alta-idioma">
                  <option value="es">Español</option>
                  <option value="ca">Català</option>
                  <option value="en">English</option>
                </select>
              </label>
              <label>{t.admin.alta.plan}
                <select id="alta-plan">
                  <option value="">{t.admin.alta.planSinDefinir}</option>
                  <option value="debut">Debut</option>
                  <option value="esencial">Esencial</option>
                  <option value="crece">Crece</option>
                  <option value="total">Total</option>
                  <option value="sl">SL</option>
                </select>
              </label>
              <label>{t.admin.alta.tipo}
                <select id="alta-tipo">
                  <option value="autonomo">{t.admin.alta.tipoAutonomo}</option>
                  <option value="sl">{t.admin.alta.tipoSl}</option>
                </select>
              </label>
              <label id="alta-tramitamos-wrap">{t.admin.alta.tramitamos}
                <select id="alta-tramitamos">
                  <option value="si">{t.admin.alta.tramitamosSi}</option>
                  <option value="no">{t.admin.alta.tramitamosNo}</option>
                </select>
              </label>
              <label class="portal-alta-check">
                <input type="checkbox" id="alta-reporting" /> {t.admin.alta.reporting}
              </label>
              <label class="portal-alta-check">
                <input type="checkbox" id="alta-formulario" checked /> {t.admin.alta.enviarFormulario}
              </label>
            </div>
            <button type="submit" class="btn btn-primary" id="alta-submit">{t.admin.alta.submit}</button>
            <p id="alta-msg" class="portal-msg" hidden></p>
            <!-- Enlace del formulario ya personalizado (NIF + email), para mandarlo en un
                 correo propio cuando se desmarca el correo automático del formulario. -->
            <div id="alta-enlace" class="portal-alta-enlace" hidden>
              <label for="alta-enlace-url">{t.admin.alta.enlaceLabel}</label>
              <div class="portal-alta-enlace-row">
                <input type="text" id="alta-enlace-url" readonly />
                <button type="button" class="btn" id="alta-enlace-copiar">{t.admin.alta.copiar}</button>
              </div>
            </div>
          </form>

          <section class="app-panel" data-panel="inicio">
            <h2>{t.portalExterno.title}</h2>
            <p>{t.portalExterno.desc}</p>
            <iframe class="portal-externo-frame" src="https://portal.portaldespacho.com/acceso/frame" width="220" height="180" title={t.portalExterno.title}></iframe>
          </section>

          <section class="app-panel" data-panel="prevision" hidden>
            <h2>{t.prevision.title}</h2>
            <p>{t.prevision.pronto}</p>
            <p>{t.prevision.otraInfoPre}<a href={`mailto:${EMAIL}`}>{EMAIL}</a>{t.prevision.otraInfoPost}</p>
          </section>

          <!-- Mis documentos (2026-11-12): cada carpeta es una tarjeta visible con su botón de
               subir. El código de la carpeta va a facturas_subidas.carpeta y n8n ("Descarga de
               facturas") decide con él dónde se guarda en Drive. Ver schema.sql. -->
          <section class="app-panel" data-panel="documentos" hidden>
            <h2>{t.doc.misTitulo}</h2>
            <p>{t.doc.misIntro}</p>
            <p id="docAdminNota" class="portal-msg" hidden>{t.doc.adminNota}</p>
            <input type="file" id="facturaFile" accept="application/pdf,image/jpeg,image/png,image/webp" multiple hidden aria-label={t.doc.subir} />
            <input type="file" id="facturaCamera" accept="image/*,.heic,.heif" capture="environment" hidden aria-label={t.facturas.cameraSubmit} />

            <h3 class="doc-grupo">{t.doc.grupoContabilidad}</h3>
            <div class="doc-carpetas">
              {CARPETAS_CONTABILIDAD.map((c) => (
                <CarpetaDocumentos codigo={c} nombre={t.doc.carpetas[c]} extracto={c === 'banco' || c === 'tarjeta'}
                  textos={{ ...textosCarpeta, digitos: c === 'tarjeta' ? t.doc.digitosTarjeta : t.doc.digitosBanco, nota: c === 'tarjeta' ? t.doc.tarjetaNota : undefined }} />
              ))}
              <CarpetaDocumentos codigo="sinCarpeta" nombre={t.doc.carpetas.sinCarpeta} textos={textosCarpeta} soloLista />
            </div>

            <h3 class="doc-grupo">{t.doc.grupoDocumentacion}</h3>
            <div class="doc-carpetas">
              {CARPETAS_DOCUMENTACION.map((c) => <CarpetaDocumentos codigo={c} nombre={t.doc.carpetas[c]} textos={textosCarpeta} />)}
            </div>
          </section>

          <!-- Documentos de Asesoría Madal: guía, presentación, apoderamiento y RGPD. Separados
               de "Mis documentos" a petición de Edurne (2026-11-12). -->
          <section class="app-panel" data-panel="documentacion" hidden>
            <h2>{t.doc.grupoNuestros}</h2>

            <div class="field-group">
              <p class="field-group-label">{t.doc.guiaGroup}</p>
              <ul class="doc-list">
                <li>
                  <a href="https://suslwmgqdzingeqhfrpw.supabase.co/storage/v1/object/public/docs-publicos/Guia_Area_Clientes.pdf" target="_blank" rel="noopener">
                    {t.doc.guiaLink}
                  </a>
                </li>
              </ul>
            </div>

            <div class="field-group">
              <p class="field-group-label">{t.doc.presentacionGroup}</p>
              <ul id="doc-presentacion-autonomo" class="doc-list" hidden>
                <li>
                  <a href="https://suslwmgqdzingeqhfrpw.supabase.co/storage/v1/object/public/docs-publicos/Presentacion_Autonomos.pdf" target="_blank" rel="noopener">
                    {t.doc.presentacionAutonomo}
                  </a>
                </li>
              </ul>
              <ul id="doc-presentacion-sl" class="doc-list" hidden>
                <li>
                  <a href="https://suslwmgqdzingeqhfrpw.supabase.co/storage/v1/object/public/docs-publicos/Presentacion_SL.pdf" target="_blank" rel="noopener">
                    {t.doc.presentacionSl}
                  </a>
                </li>
              </ul>
              <p id="doc-presentacion-pendiente" class="field-hint" hidden>
                {t.doc.presentacionPendientePre}<a href={`mailto:${EMAIL}`}>{EMAIL}</a>{t.doc.presentacionPendientePost}
              </p>
            </div>

            <div class="field-group">
              <p class="field-group-label">{t.doc.apoderamientoGroup}</p>
              <ul class="doc-list">
                <li>
                  <a href="https://suslwmgqdzingeqhfrpw.supabase.co/storage/v1/object/public/docs-publicos/Pasos_Apoderamiento_AEAT.pdf" target="_blank" rel="noopener">
                    {t.doc.apoderamientoAeat}
                  </a>
                </li>
                <li>
                  <a href="https://suslwmgqdzingeqhfrpw.supabase.co/storage/v1/object/public/docs-publicos/Pasos_Apoderamiento_Seguridad_Social.pdf" target="_blank" rel="noopener">
                    {t.doc.apoderamientoSs}
                  </a>
                </li>
              </ul>
            </div>

            <div class="field-group">
              <p class="field-group-label">{t.doc.rgpdGroup}</p>
              <ul class="doc-list">
                <li>
                  <a href="https://suslwmgqdzingeqhfrpw.supabase.co/storage/v1/object/public/docs-publicos/RGPD.pdf" target="_blank" rel="noopener">
                    {t.doc.rgpdLink}
                  </a>
                </li>
              </ul>
            </div>
          </section>
        </div>
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="portal-i18n" is:inline set:html={JSON.stringify(t)} />

<style>
  .app-lang { display: flex; gap: 0.35rem; margin: 0.15rem 0 0.1rem; }
  .app-lang a {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--ink-soft);
    text-decoration: none;
    padding: 0.1rem 0.32rem;
    border-radius: 6px;
  }
  .app-lang a:hover { color: var(--ink); }
  .app-lang a.active {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .portal-externo-frame { border: none; border-radius: 6px; display: block; margin-top: 0.75rem; }

  .portal-admin-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.1rem;
    padding: 0.7rem 1rem;
    margin-bottom: 1.4rem;
    border: 1px solid var(--accent);
    border-radius: 10px;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    font-size: 0.9rem;
  }
  .portal-admin-tag { font-weight: 600; }
  .portal-admin-select { display: flex; align-items: center; gap: 0.4rem; }
  .portal-admin-select select {
    padding: 0.32rem 0.5rem;
    border-radius: 6px;
    border: 1px solid var(--accent);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    max-width: 60vw;
  }
  .portal-admin-note { color: var(--ink-soft); font-size: 0.8rem; }
  .portal-alta-toggle { margin-left: auto; padding: 0.4rem 0.9rem; font-size: 0.85rem; }
  .portal-alta-form {
    display: grid;
    gap: 1rem;
    padding: 1rem;
    margin: -0.6rem 0 1.4rem;
    border: 1px solid var(--accent);
    border-radius: 10px;
  }
  .portal-alta-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 0.75rem 1rem; }
  .portal-alta-form label { display: grid; gap: 0.25rem; font-size: 0.85rem; color: var(--ink-soft); }
  .portal-alta-form input[type='text'],
  .portal-alta-form input[type='email'],
  .portal-alta-form select {
    padding: 0.45rem 0.6rem;
    border-radius: 6px;
    border: 1px solid var(--accent);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
  }
  .portal-alta-form .portal-alta-check { display: flex; align-items: center; gap: 0.5rem; align-self: end; }
  .portal-alta-form button[type='submit'] { justify-self: start; }
  .portal-alta-enlace { display: grid; gap: 0.35rem; }
  .portal-alta-enlace[hidden] { display: none; }
  .portal-alta-enlace-row { display: flex; gap: 0.5rem; }
  .portal-alta-enlace-row input { flex: 1; min-width: 0; font-size: 0.85rem; }
  .portal-alta-enlace-row button { padding: 0.4rem 0.9rem; font-size: 0.85rem; }

  /* Mis documentos: una tarjeta por carpeta (CarpetaDocumentos.astro). Estilos globales
     (:global) porque los elementos vienen de otro componente. */
  .doc-grupo { font-size: 1.05rem; margin: 1.8rem 0 0.8rem; }
  .doc-carpetas { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr)); gap: 0.8rem; }
  :global(.doc-carpeta) {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--paper-raised);
  }
  :global(.doc-carpeta[hidden]) { display: none; }
  :global(.doc-carpeta-cab) { display: flex; justify-content: space-between; align-items: baseline; gap: 0.6rem; }
  :global(.doc-carpeta-nombre) { font-weight: 600; font-size: 0.95rem; color: var(--ink); }
  :global(.doc-carpeta-n) {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-tint);
    border-radius: 999px;
    padding: 0.05rem 0.55rem;
  }
  :global(.doc-carpeta-nota) { font-size: 0.82rem; color: var(--ink-soft); margin: 0; }
  :global(.doc-extracto) { display: flex; flex-wrap: wrap; gap: 0.5rem 0.75rem; }
  :global(.doc-campo) { display: grid; gap: 0.2rem; font-size: 0.8rem; color: var(--ink-soft); }
  :global(.doc-campo input) {
    padding: 0.4rem 0.55rem;
    border-radius: 6px;
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: 0.88rem;
    max-width: 100%;
  }
  :global(.doc-campo input[data-digitos]) { width: 5.5rem; }
  :global(.doc-carpeta-botones) { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  :global(.doc-btn) { padding: 0.45rem 0.95rem; font-size: 0.85rem; }
  :global(.doc-carpeta-msg) { margin: 0; font-size: 0.85rem; }
  :global(.doc-carpeta-lista summary) { cursor: pointer; font-size: 0.85rem; color: var(--accent); font-weight: 600; }
  :global(.doc-carpeta-lista .factura-list) { margin-top: 0.6rem; }

</style>

<script>
  import { getSupabaseBrowser } from '../../lib/supabaseClient';

  // Textos que necesita este script (viajan serializados desde el servidor,
  // ya en el idioma de la página) y locale para formatear fechas/importes.
  const I18N = JSON.parse(document.getElementById('portal-i18n')?.textContent || '{}');
  const LOCALE = (document.querySelector('.portal-page') as HTMLElement | null)?.dataset.locale || 'es-ES';

  function tpl(str: string, vars: Record<string, string | number>): string {
    return str.replace(/\{(\w+)\}/g, (_m, key) => String(vars[key] ?? ''));
  }

  const loadingEl = document.getElementById('portal-loading') as HTMLElement;
  const unconfiguredEl = document.getElementById('portal-unconfigured') as HTMLElement;
  const loginForm = document.getElementById('portal-login-form') as HTMLFormElement;
  const emailInput = document.getElementById('portal-email') as HTMLInputElement;
  const loginMsg = document.getElementById('portal-login-msg') as HTMLElement;
  const unlinkedEl = document.getElementById('portal-unlinked') as HTMLElement;
  const dashEl = document.getElementById('portal-dash') as HTMLElement;
  const nombreEl = document.getElementById('portal-nombre') as HTMLElement;
  const logoutBtn1 = document.getElementById('portal-logout-1') as HTMLButtonElement;
  const logoutBtn2 = document.getElementById('portal-logout-2') as HTMLButtonElement;

  const adminBar = document.getElementById('portal-admin-bar') as HTMLElement;
  const adminClienteSelect = document.getElementById('portal-admin-cliente-select') as HTMLSelectElement;
  const adminClienteNombre = document.getElementById('portal-admin-cliente-nombre') as HTMLElement;

  const dudaRapidaWhatsappEl = document.getElementById('duda-rapida-whatsapp') as HTMLAnchorElement;

  const docPresentacionAutonomoEl = document.getElementById('doc-presentacion-autonomo') as HTMLElement;
  const docPresentacionSlEl = document.getElementById('doc-presentacion-sl') as HTMLElement;
  const docPresentacionPendienteEl = document.getElementById('doc-presentacion-pendiente') as HTMLElement;

  const navLinks = Array.from(document.querySelectorAll<HTMLButtonElement>('.app-nav-link'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.app-panel'));

  // --- Mis documentos: carpetas (tarjetas CarpetaDocumentos) ---
  const facturaFile = document.getElementById('facturaFile') as HTMLInputElement;
  const facturaCamera = document.getElementById('facturaCamera') as HTMLInputElement;
  const docAdminNota = document.getElementById('docAdminNota') as HTMLElement;
  const carpetas = Array.from(document.querySelectorAll<HTMLElement>('.doc-carpeta[data-carpeta]'));
  const carpeta = (codigo: string) => carpetas.find((c) => c.dataset.carpeta === codigo)!;

  const ES_EXTRACTO = (c: string) => c === 'banco' || c === 'tarjeta';
  // Solo facturas y tickets se contabilizan (pasan por Pendientes en Drive).
  const SE_CONTABILIZA = (c: string) => ['emitidas', 'recibidas', 'simplificadas', 'tickets', 'sinCarpeta'].includes(c);

  // Carpeta en la que se está subiendo (la del botón pulsado) y, en extractos, sus datos.
  let carpetaActual = '';
  let extractoActual: { cuenta_digitos: string; periodo_desde: string; periodo_hasta: string } | null = null;

  function mensaje(codigo: string, texto: string, tipo: '' | 'is-ok' | 'is-error') {
    const el = carpeta(codigo).querySelector<HTMLElement>('[data-msg]')!;
    el.hidden = !texto;
    el.className = `portal-msg doc-carpeta-msg ${tipo}`.trim();
    el.textContent = texto;
  }

  // "Extractos bancarios" solo para SL.
  function ajustarCarpetas(tipoPersona: string | null) {
    carpeta('banco').hidden = tipoPersona !== 'sl';
  }

  // Cada carpeta: "Subir" abre el selector de archivos y "Hacer foto", la cámara del móvil.
  // En extractos, antes de abrirlos se comprueban los dígitos y el periodo.
  carpetas.forEach((el) => {
    const codigo = el.dataset.carpeta!;
    const preparar = (): boolean => {
      carpetaActual = codigo;
      extractoActual = null;
      if (ES_EXTRACTO(codigo)) {
        const v = (s: string) => (el.querySelector<HTMLInputElement>(s)?.value ?? '').trim();
        extractoActual = { cuenta_digitos: v('[data-digitos]'), periodo_desde: v('[data-desde]'), periodo_hasta: v('[data-hasta]') };
        const e = extractoActual;
        if (!/^\d{4}$/.test(e.cuenta_digitos) || !e.periodo_desde || !e.periodo_hasta || e.periodo_desde > e.periodo_hasta) {
          mensaje(codigo, I18N.doc.faltanDatosExtracto, 'is-error');
          return false;
        }
      }
      mensaje(codigo, '', '');
      return true;
    };
    el.querySelector('[data-subir]')?.addEventListener('click', () => { if (preparar()) facturaFile.click(); });
    el.querySelector('[data-foto]')?.addEventListener('click', () => { if (preparar()) facturaCamera.click(); });
  });

  function showOnly(el: HTMLElement) {
    for (const section of [unconfiguredEl, loginForm, unlinkedEl, dashEl]) {
      section.hidden = section !== el;
    }
    loadingEl.hidden = true;
    // El área de cliente logueada sustituye la cabecera y el pie de la web
    // de marketing por su propia barra lateral: una vez dentro, no tiene
    // sentido volver a "Inicio" o "Altas" desde la barra horizontal.
    document.body.classList.toggle('portal-app', el === dashEl);
  }

  navLinks.forEach((link) => {
    link.addEventListener('click', () => {
      const target = link.dataset.panel;
      navLinks.forEach((l) => l.classList.toggle('active', l === link));
      panels.forEach((p) => { p.hidden = p.dataset.panel !== target; });
    });
  });

  // El email está siempre disponible; el WhatsApp solo si `clientes.contacto_whatsapp`
  // lo marca (no todos los planes lo incluyen - ver nota en schema.sql).
  function renderDudaRapida(tieneWhatsapp: boolean) {
    dudaRapidaWhatsappEl.hidden = !tieneWhatsapp;
  }

  // tipo_persona: 'autonomo' | 'sl' | null (todavía sin marcar por el equipo).
  function renderDocumentacionPanel(tipoPersona: string | null) {
    docPresentacionAutonomoEl.hidden = tipoPersona !== 'autonomo';
    docPresentacionSlEl.hidden = tipoPersona !== 'sl';
    docPresentacionPendienteEl.hidden = tipoPersona === 'autonomo' || tipoPersona === 'sl';
    ajustarCarpetas(tipoPersona);
  }

  const supabase = getSupabaseBrowser();

  if (!supabase) {
    showOnly(unconfiguredEl);
  } else {
    function formatFecha(iso: string) {
      return new Date(iso).toLocaleDateString(LOCALE, { day: '2-digit', month: '2-digit', year: 'numeric' });
    }

    // Id interno de clientes (no el auth.uid() de la sesión) - es lo que
    // usa facturas_subidas.cliente_id. Se rellena al cargar el dashboard.
    let currentClienteId: string | null = null;

    async function renderFacturaList(clienteId: string) {
      const { data, error } = await supabase!
        .from('facturas_subidas')
        .select('id, nombre_archivo, storage_path, fecha_subida, fecha_contabilizado, carpeta, cuenta_digitos, periodo_desde, periodo_hasta')
        .eq('cliente_id', clienteId)
        .order('fecha_subida', { ascending: false });

      if (error) console.error('facturas_subidas select error:', error);
      const rows = !error && data ? data : [];

      // Agrupa por carpeta; dentro, lo más reciente primero (ya viene ordenado).
      const porCarpeta = new Map<string, typeof rows>();
      for (const row of rows) {
        const c = (row.carpeta as string | null) || 'sinCarpeta';
        if (!porCarpeta.has(c)) porCarpeta.set(c, []);
        porCarpeta.get(c)!.push(row);
      }

      // En cada carpeta: número de archivos y su lista (plegable). Las subidas anteriores a las
      // carpetas van a "sinCarpeta", que solo se muestra si tiene algo.
      for (const el of carpetas) {
        const codigo = el.dataset.carpeta!;
        const filas = porCarpeta.get(codigo) ?? [];
        el.querySelector<HTMLElement>('[data-n]')!.textContent = String(filas.length);
        const lista = el.querySelector<HTMLDetailsElement>('.doc-carpeta-lista')!;
        const ul = lista.querySelector('ul')!;
        ul.innerHTML = '';
        filas.forEach((row) => ul.appendChild(filaArchivo(row, codigo)));
        lista.hidden = filas.length === 0;
        if (codigo === 'sinCarpeta') el.hidden = filas.length === 0;
      }
    }

    function filaArchivo(row: Record<string, unknown>, carpeta: string): HTMLLIElement {
        const li = document.createElement('li');

        const nombre = document.createElement('div');
        nombre.className = 'factura-nombre';
        nombre.textContent = row.nombre_archivo as string;
        li.appendChild(nombre);

        const meta = document.createElement('div');
        meta.className = 'factura-meta';
        const partes = [`${I18N.facturas.uploadedPrefix} ${formatFecha(row.fecha_subida as string)}`];
        if (ES_EXTRACTO(carpeta) && row.cuenta_digitos) {
          const desde = row.periodo_desde ? formatFecha(row.periodo_desde as string) : '';
          const hasta = row.periodo_hasta ? formatFecha(row.periodo_hasta as string) : '';
          partes.unshift(`${I18N.doc.cuentaPrefix} ${row.cuenta_digitos}${desde || hasta ? ` · ${desde} – ${hasta}` : ''}`);
        }
        if (SE_CONTABILIZA(carpeta)) {
          partes.push(row.fecha_contabilizado
            ? `${I18N.facturas.accountedPrefix} ${formatFecha(row.fecha_contabilizado as string)}`
            : I18N.facturas.pendingAccounting);
        }
        meta.textContent = partes.join(' · ');
        li.appendChild(meta);

        if (row.storage_path) {
          const descargar = document.createElement('button');
          descargar.type = 'button';
          descargar.className = 'factura-descargar';
          descargar.textContent = I18N.facturas.download;
          descargar.addEventListener('click', async () => {
            const { data: signed } = await supabase!.storage
              .from('facturas')
              .createSignedUrl(row.storage_path as string, 60);
            if (signed?.signedUrl) {
              window.open(signed.signedUrl, '_blank');
            } else {
              // El registro sigue aquí pero el archivo ya no está en el Storage
              // (borrado a mano sin limpiar storage_path, o ya archivado en Drive).
              alert(I18N.facturas.gone);
            }
          });
          li.appendChild(descargar);
        }

        return li;
    }

    type ClienteRow = {
      id: string;
      nombre: string;
      tipo_persona: string | null;
      email?: string | null;
      contacto_whatsapp?: boolean;
    };

    // Pinta el área de un cliente concreto. La usan los dos caminos: el
    // cliente normal (su propia fila) y el admin (la fila que elija en el
    // selector). Las consultas a las tablas hijas van filtradas por
    // cliente_id; en modo admin RLS las deja leer por la política
    // "admin ve todo".
    function aplicarCliente(cliente: ClienteRow) {
      currentClienteId = cliente.id;
      nombreEl.textContent = cliente.nombre ?? '';
      renderDocumentacionPanel(cliente.tipo_persona ?? null);
      renderFacturaList(cliente.id);
      renderDudaRapida(Boolean(cliente.contacto_whatsapp));
    }

    let adminClientes: ClienteRow[] = [];

    // Modo admin: en vez de "tu ficha", un desplegable con todos los
    // clientes. La consulta devuelve todas las filas gracias a la política
    // RLS "admin ve todos los clientes"; para un cliente normal esa misma
    // consulta solo devolvería la suya (y no llegamos aquí).
    async function renderAdmin(forzar = false) {
      // Ya montado (p.ej. un TOKEN_REFRESHED posterior de Supabase Auth):
      // no reconstruir el selector ni perder el cliente que se estaba viendo.
      // `forzar` lo salta tras un alta manual, para que aparezca el nuevo cliente.
      if (!forzar && !adminBar.hidden && adminClientes.length > 0) {
        showOnly(dashEl);
        return;
      }

      const { data, error } = await supabase!
        .from('clientes')
        .select('id, nombre, email, tipo_persona, contacto_whatsapp')
        .order('nombre', { ascending: true });

      adminClientes = (!error && data ? data : []) as ClienteRow[];
      adminClienteSelect.innerHTML = '';

      if (adminClientes.length === 0) {
        const opt = document.createElement('option');
        opt.value = '';
        opt.textContent = I18N.admin.noClientes;
        adminClienteSelect.appendChild(opt);
      } else {
        adminClientes.forEach((c) => {
          const opt = document.createElement('option');
          opt.value = c.id;
          opt.textContent = c.email ? `${c.nombre} - ${c.email}` : `${c.nombre} (${c.id})`;
          adminClienteSelect.appendChild(opt);
        });
      }

      adminClienteSelect.onchange = () => {
        const c = adminClientes.find((x) => x.id === adminClienteSelect.value);
        if (c) {
          adminClienteNombre.textContent = c.nombre ?? '';
          aplicarCliente(c);
        }
      };

      adminBar.hidden = false;
      // El admin puede subir documentos en nombre del cliente seleccionado (2026-11-12): se
      // guardan en su cuenta. Necesita las políticas "admin …" de schema.sql.
      docAdminNota.hidden = false;

      if (adminClientes.length > 0) {
        adminClienteSelect.value = adminClientes[0].id;
        adminClienteNombre.textContent = adminClientes[0].nombre ?? '';
        aplicarCliente(adminClientes[0]);
      }
      showOnly(dashEl);
    }

    async function renderForSession() {
      const {
        data: { session },
      } = await supabase!.auth.getSession();

      if (!session) {
        showOnly(loginForm);
        return;
      }

      // ¿La sesión es de un miembro del equipo con acceso admin? La
      // política RLS de portal_admins solo deja ver la fila propia, así
      // que esto devuelve algo únicamente si eres admin.
      const { data: adminRow } = await supabase!
        .from('portal_admins')
        .select('auth_user_id')
        .maybeSingle();

      if (adminRow) {
        await renderAdmin();
        return;
      }

      // Cliente normal. Sin filtro por email: RLS ya limita esta consulta
      // a la fila vinculada (auth_user_id = auth.uid()) - si el trigger de
      // alta todavía no la ha vinculado, no devuelve nada y cae en
      // "unlinked", igual que antes.
      const { data: cliente } = await supabase!
        .from('clientes')
        .select('id, nombre, tipo_persona, contacto_whatsapp')
        .maybeSingle();

      if (!cliente) {
        showOnly(unlinkedEl);
        return;
      }

      adminBar.hidden = true;
      docAdminNota.hidden = true;
      aplicarCliente(cliente as ClienteRow);
      showOnly(dashEl);
    }

    // --- Alta manual de cliente (vía /api/alta-cliente) ---
    // Solo inserta la fila en `clientes`; el correo con el formulario, HubSpot y
    // Drive los dispara n8n (Onboarding) a partir de ese INSERT. El acceso al
    // portal lo manda n8n (Responden formulario) al recibir el primer formulario.
    const altaToggle = document.getElementById('portal-alta-toggle') as HTMLButtonElement;
    const altaForm = document.getElementById('portal-alta-form') as HTMLFormElement;
    const altaMsg = document.getElementById('alta-msg') as HTMLElement;
    const altaTipo = document.getElementById('alta-tipo') as HTMLSelectElement;
    const altaTramitamosWrap = document.getElementById('alta-tramitamos-wrap') as HTMLElement;

    const altaEnlace = document.getElementById('alta-enlace') as HTMLElement;
    const altaEnlaceUrl = document.getElementById('alta-enlace-url') as HTMLInputElement;
    const altaEnlaceCopiar = document.getElementById('alta-enlace-copiar') as HTMLButtonElement;
    altaEnlaceCopiar.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(altaEnlaceUrl.value);
      } catch {
        // Sin permiso de portapapeles: se deja seleccionado para copiarlo a mano.
        altaEnlaceUrl.select();
        return;
      }
      altaEnlaceCopiar.textContent = I18N.admin.alta.copiado;
      setTimeout(() => (altaEnlaceCopiar.textContent = I18N.admin.alta.copiar), 2000);
    });

    function syncAltaTipo() {
      altaTramitamosWrap.hidden = altaTipo.value !== 'autonomo';
    }
    altaTipo.addEventListener('change', syncAltaTipo);
    syncAltaTipo();

    altaToggle.addEventListener('click', () => {
      altaForm.hidden = !altaForm.hidden;
      altaToggle.textContent = altaForm.hidden ? I18N.admin.alta.open : I18N.admin.alta.close;
    });

    altaForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const boton = document.getElementById('alta-submit') as HTMLButtonElement;
      const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();
      const tipoPersona = altaTipo.value;

      boton.disabled = true;
      altaMsg.hidden = false;
      altaMsg.textContent = I18N.admin.alta.sending;
      try {
        const {
          data: { session },
        } = await supabase!.auth.getSession();
        const res = await fetch('/api/alta-cliente', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${session?.access_token ?? ''}` },
          body: JSON.stringify({
            nif: val('alta-nif'),
            nombre: val('alta-nombre'),
            empresa: val('alta-empresa') || undefined,
            email: val('alta-email') || undefined,
            telefono: val('alta-telefono') || undefined,
            plan: val('alta-plan') || undefined,
            idioma: val('alta-idioma') || 'es',
            tipoPersona,
            tramitamosAlta: tipoPersona === 'autonomo' ? (document.getElementById('alta-tramitamos') as HTMLSelectElement).value === 'si' : undefined,
            reporting: (document.getElementById('alta-reporting') as HTMLInputElement).checked,
            enviarFormulario: (document.getElementById('alta-formulario') as HTMLInputElement).checked,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          altaMsg.textContent = data.error || I18N.admin.alta.error;
          return;
        }
        // Correo del formulario desmarcado = "se lo mando yo": se muestra el enlace
        // del formulario que le toca, con NIF y email ya puestos, en inglés si el
        // cliente es en inglés (en catalán no hay formulario: va el castellano).
        const enviaFormulario = (document.getElementById('alta-formulario') as HTMLInputElement).checked;
        const emailAlta = val('alta-email');
        let enlaceFormulario = '';
        if (!enviaFormulario) {
          const prefijo = val('alta-idioma') === 'en' ? '/en' : '';
          const ruta =
            prefijo +
            (tipoPersona === 'sl'
              ? '/formulario-traspaso-sl'
              : (document.getElementById('alta-tramitamos') as HTMLSelectElement).value === 'si'
                ? '/formulario-alta'
                : '/formulario-traspaso-autonomo');
          // Ficha provisional (sin NIF): el enlace va solo con el email y el
          // cliente escribe su NIF en el formulario.
          const params = new URLSearchParams();
          if (!String(data.id).startsWith('PENDIENTE-')) params.set('nif', data.id);
          if (emailAlta) params.set('email', emailAlta.toLowerCase());
          enlaceFormulario = `${window.location.origin}${ruta}?${params.toString()}`;
          altaMsg.textContent = I18N.admin.alta.okManual;
        } else {
          altaMsg.textContent = I18N.admin.alta.ok;
        }
        altaForm.reset(); // vacía también el campo del enlace: se rellena justo después
        altaEnlaceUrl.value = enlaceFormulario;
        altaEnlace.hidden = !enlaceFormulario;
        syncAltaTipo();
        await renderAdmin(true);
        adminClienteSelect.value = data.id;
        adminClienteSelect.dispatchEvent(new Event('change'));
      } catch {
        altaMsg.textContent = I18N.admin.alta.error;
      } finally {
        boton.disabled = false;
      }
    });

    renderForSession();
    supabase.auth.onAuthStateChange(() => renderForSession());

    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      loginMsg.hidden = false;
      loginMsg.className = 'portal-msg';
      loginMsg.textContent = I18N.login.sending;

      // Vía el endpoint del servidor, no supabase.auth.signInWithOtp
      // directo: así solo un email ya dado de alta en `clientes` puede
      // llegar a recibir el enlace (ver api/portal-login.ts).
      let ok = false;
      try {
        const res = await fetch('/api/portal-login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: emailInput.value, redirectTo: window.location.href.split('?')[0] }),
        });
        ok = res.ok;
      } catch {
        ok = false;
      }

      if (ok) {
        loginMsg.className = 'portal-msg is-ok';
        loginMsg.textContent = I18N.login.sent;
      } else {
        loginMsg.className = 'portal-msg is-error';
        loginMsg.textContent = I18N.login.error;
      }
    });

    const FACTURA_TIPOS_ACEPTADOS = ['application/pdf', 'image/jpeg', 'image/png', 'image/webp'];

    const FACTURA_TIPO_POR_EXTENSION: Record<string, string> = { pdf: 'application/pdf', jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', webp: 'image/webp' };

    // Algunos móviles entregan la foto sin tipo o en HEIC: el tipo se deduce de
    // la extensión y lo que el navegador sepa decodificar se pasa a JPEG.
    async function normalizarFactura(file: File): Promise<File | null> {
      if (FACTURA_TIPOS_ACEPTADOS.includes(file.type)) return file;
      const ext = file.name.split('.').pop()?.toLowerCase() ?? '';
      const tipo = FACTURA_TIPO_POR_EXTENSION[ext];
      if (tipo) return new File([file], file.name, { type: tipo });
      if (!file.type.startsWith('image/') && !/^(heic|heif)$/.test(ext)) return null;
      try {
        const imagen = await createImageBitmap(file);
        const canvas = document.createElement('canvas');
        canvas.width = imagen.width;
        canvas.height = imagen.height;
        canvas.getContext('2d')!.drawImage(imagen, 0, 0);
        const jpeg = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/jpeg', 0.9));
        if (!jpeg) return null;
        return new File([jpeg], file.name.replace(/\.[^.]*$/, '') + '.jpg', { type: 'image/jpeg' });
      } catch {
        return null;
      }
    }

    // Storage rechaza claves con tildes y símbolos raros.
    function nombreParaStorage(nombre: string): string {
      return nombre.normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-zA-Z0-9._-]+/g, '_');
    }

    async function subirFacturas(originales: File[]) {
      if (originales.length === 0) return;

      // Carpeta y datos del extracto: los del botón pulsado (ya comprobados al pulsarlo).
      const carpeta = carpetaActual;
      const extracto = extractoActual;
      if (!carpeta) return;
      const mostrarError = (texto: string) => {
        mensaje(carpeta, texto, 'is-error');
        facturaFile.value = '';
        facturaCamera.value = '';
      };

      const normalizadas = await Promise.all(originales.map(normalizarFactura));
      if (normalizadas.some((f) => f === null)) {
        mostrarError(I18N.facturas.onlyPdf);
        return;
      }
      const files = normalizadas as File[];

      const {
        data: { session },
      } = await supabase!.auth.getSession();
      if (!session || !currentClienteId) {
        mostrarError(`${I18N.facturas.failAll} (${!session ? 'no session' : 'no client'})`);
        return;
      }
      const clienteId = currentClienteId;

      mensaje(carpeta, files.length > 1 ? tpl(I18N.facturas.uploadingMany, { n: files.length }) : I18N.facturas.uploadingOne, '');

      // Cada archivo es una subida y una fila independiente en
      // facturas_subidas: varias facturas seleccionadas a la vez cuentan
      // como varias facturas, no como una sola. Se suben en secuencia (no en
      // paralelo) para no saturar la conexión con varios PDFs a la vez.
      let subidas = 0;
      let fallos = 0;
      let ultimoError = '';

      for (const file of files) {
        // La ruta en Storage usa el NIF del cliente tanto para la carpeta
        // (así lo exige la política de Storage, ver schema.sql) como para
        // prefijar el propio nombre de archivo - mismo id que cliente_id en
        // facturas_subidas, para que carpeta y archivo sean identificables a
        // mano (Drive, revisión manual) en vez de un uid opaco. El timestamp
        // (día/mes-hora/minuto/segundo, hora local del navegador) y el sufijo
        // aleatorio evitan que dos subidas choquen de nombre: el iPhone llama
        // image.jpg a todas las fotos - se usan guiones en vez de barras
        // porque "/" en la ruta de Storage crearía subcarpetas.
        const now = new Date();
        const pad = (n: number) => String(n).padStart(2, '0');
        const timestamp = `${pad(now.getDate())}${pad(now.getMonth() + 1)}-${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}`;
        const sufijo = crypto.randomUUID().slice(0, 4);
        const path = `${clienteId}/${clienteId}-${timestamp}-${sufijo}-${nombreParaStorage(file.name)}`;
        const { error } = await supabase!.storage.from('facturas').upload(path, file, {
          contentType: file.type,
        });

        if (error) {
          console.error('facturas upload error:', error);
          ultimoError = error.message;
          fallos++;
          continue;
        }

        // Si el archivo sube bien pero falla el registro de la fila, no lo
        // contamos como fallo de cara al cliente (el equipo verá el archivo
        // en el Storage igualmente y podrá revisarlo a mano) - pero sí lo
        // dejamos en consola para poder diagnosticar por qué falla el insert
        // (RLS, FK, tipo de columna...).
        const { error: insertError } = await supabase!.from('facturas_subidas').insert({
          cliente_id: clienteId,
          nombre_archivo: file.name,
          storage_path: path,
          carpeta,
          ...(extracto ?? {}),
        });
        if (insertError) {
          // Antes solo se anotaba en la consola: el archivo quedaba en Storage sin fila y nunca
          // bajaba a Drive. Ahora cuenta como fallo, para que se vea y se pueda repetir.
          console.error('facturas_subidas insert error:', insertError);
          ultimoError = insertError.message;
          fallos++;
          continue;
        }
        subidas++;
      }

      if (fallos === 0) {
        mensaje(carpeta, subidas > 1 ? tpl(I18N.facturas.okMany, { n: subidas }) : I18N.facturas.okOne, 'is-ok');
      } else if (subidas > 0) {
        mensaje(carpeta, `${tpl(I18N.facturas.partial, { ok: subidas, fail: fallos })} (${ultimoError})`, 'is-error');
      } else {
        mensaje(carpeta, `${I18N.facturas.failAll} (${ultimoError})`, 'is-error');
      }

      facturaFile.value = '';
      facturaCamera.value = '';
      renderFacturaList(clienteId);
    }

    facturaFile.addEventListener('change', () => {
      void subirFacturas(Array.from(facturaFile.files ?? []));
    });
    facturaCamera.addEventListener('change', () => {
      void subirFacturas(Array.from(facturaCamera.files ?? []));
    });

    async function logout() {
      await supabase!.auth.signOut();
      showOnly(loginForm);
    }
    logoutBtn1.addEventListener('click', logout);
    logoutBtn2.addEventListener('click', logout);
  }
</script>
