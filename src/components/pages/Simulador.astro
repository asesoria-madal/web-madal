---
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';
import ContactSwitch from '../ContactSwitch.astro';

// `embedded` = incrustado en otra página (la home) que ya tiene su propio
// <h1>. En ese caso el título del simulador baja a <h2> para no dejar dos
// <h1> en la misma página; suelto en /simulador es el <h1> de la página.
interface Props { lang: Locale; embedded?: boolean; }
const { lang, embedded = false } = Astro.props;
const t = useTranslations(lang);
const s = t.sim;
const Heading = embedded ? 'h2' : 'h1';

// Quien nos pide que le demos de alta ahora elige plan igual que el resto
// (antes se le asignaba Debut sin preguntar) — pero sigue siendo el plan
// pensado para su caso, así que se destaca como recomendado y se le
// recuerda al final el aviso de paso a Esencial a los 6-12 meses (mismo
// texto que ya existe en precios.autonomoTiers, sin duplicarlo).
const debutTier = t.precios.autonomoTiers.find((tier) => tier.key === 'debut');
---

<div id="view-simulador">
  <div class="sim-page">
    <p class="eyebrow">{s.eyebrow}</p>
    <Heading class="sim-page-title">{s.title}</Heading>
    <p class="section-sub" style="margin-left:auto;margin-right:auto;">{s.sub}</p>

    <div class="wizard" id="wizard" data-lang={lang}>
      <div class="wizard-progress" id="wizardProgress"></div>

      <div class="wizard-step" data-step="regimen">
        <h3>{s.stepRegimen.q}</h3>
        <div class="card-options">
          {s.stepRegimen.options.map((opt) => (
            <button type="button" class="option-card" data-field="regimen" data-value={opt.value}>{opt.label}</button>
          ))}
        </div>
      </div>

      <div class="wizard-step" data-step="altaEstado" hidden>
        <h3>{s.stepAlta.q}</h3>
        <div class="card-options">
          {s.stepAlta.options.map((opt) => (
            <button type="button" class="option-card" data-field="alta" data-value={opt.value}>{opt.label}</button>
          ))}
        </div>
      </div>

      <div class="wizard-step" data-step="facturas" hidden>
        <h3>{s.stepFacturas.q}</h3>
        <div class="card-options card-options-vertical" data-facturas-options="autonomo" hidden>
          {t.precios.autonomoTiers.map((tier) => (
            <button type="button" class="option-card option-card-tier" data-field="facturas" data-value={tier.key}>
              {tier.key === 'debut' && <span class="option-card-tier-badge" id="debutRecommendedBadge" hidden>{s.recommendedLabel}</span>}
              <span class="option-card-label">{tier.name}</span>
              <span class="option-card-desc">{tier.desc}</span>
              <span class="option-card-tier-price">{tier.amount}<small>{tier.unit}</small> <small>· {tier.ivaNote}</small></span>
              {'durationNote' in tier && tier.durationNote && <span class="option-card-tier-duration">{tier.durationNote}</span>}
              {'includesPrevious' in tier && tier.includesPrevious && <span class="option-card-tier-includes">{tier.includesPrevious}</span>}
              <ul class="option-card-tier-features">
                {tier.features.map((f) => (<li>{f}</li>))}
              </ul>
              {'transitionNote' in tier && tier.transitionNote && <span class="option-card-tier-transition">{tier.transitionNote}</span>}
            </button>
          ))}
        </div>
        <div class="card-options card-options-vertical" data-facturas-options="pyme" hidden>
          {t.precios.pymeTiers.map((tier) => (
            <button type="button" class="option-card option-card-tier" data-field="facturas" data-value={tier.key}>
              <span class="option-card-label">{tier.name}</span>
              <span class="option-card-desc">{tier.desc}</span>
              <span class="option-card-tier-price">{tier.amount}<small>{tier.unit}</small> <small>· {tier.ivaNote}</small></span>
              {'includesPrevious' in tier && tier.includesPrevious && <span class="option-card-tier-includes">{tier.includesPrevious}</span>}
              <ul class="option-card-tier-features">
                {tier.features.map((f) => (<li>{f}</li>))}
              </ul>
              {'dashboardNote' in tier && tier.dashboardNote && <span class="option-card-tier-dashboard">{tier.dashboardNote}</span>}
            </button>
          ))}
        </div>
      </div>

      <div class="wizard-step" data-step="reporting" hidden>
        <h3>{s.stepReporting.q}</h3>
        <div class="card-options">
          {s.stepReporting.options.map((opt) => (
            <button type="button" class="option-card" data-field="reporting" data-value={opt.value}>{opt.label}</button>
          ))}
        </div>
      </div>

      <div class="wizard-step" data-step="certificado" hidden>
        <h3>{s.stepCertificado.q}</h3>
        <div class="card-options">
          {s.stepCertificado.options.map((opt) => (
            <button type="button" class="option-card" data-field="certificado" data-value={opt.value}>{opt.label}</button>
          ))}
        </div>
      </div>

      <div class="wizard-step" data-step="actividad" hidden>
        <h3>{s.stepActividad.q}</h3>
        <p class="sim-field-hint">{s.stepActividad.hint}</p>
        <input type="text" id="simActividadInput" class="sim-input" maxlength="100" placeholder={s.stepActividad.placeholder} />
        <button type="button" class="btn btn-primary sim-continue" id="simActividadContinue" disabled>{s.continue}</button>
      </div>

      <div class="wizard-step" data-step="fechaInicio" hidden>
        <h3>{s.stepFecha.q}</h3>
        <p class="sim-field-hint">{s.stepFecha.hint}</p>
        <input type="date" id="simFechaInput" class="sim-input" />
        <button type="button" class="btn btn-primary sim-continue" id="simFechaContinue" disabled>{s.continue}</button>
      </div>

      <div class="wizard-step" data-step="email" hidden>
        <h3>{s.email.qBefore}</h3>
        <p class="sim-field-hint">{s.email.hint}</p>
        <p class="sim-field-hint sim-no-ads">{s.email.noAds}</p>
        <input type="email" id="simEmailInput" class="sim-input" placeholder={s.email.placeholder} autocomplete="email" />
        <label class="sim-consent">
          <input type="checkbox" id="simEmailConsent" />
          <span>{s.email.consentPrefix} <a href="/privacidad" target="_blank" rel="noopener">{s.email.consentLink}</a></span>
        </label>
        <p class="sim-consent-info">{s.email.consentInfo}</p>
        <p class="sim-field-error" id="simEmailError" hidden>{s.email.error}</p>
        <div class="sim-email-actions">
          <button type="button" class="btn btn-outline sim-continue" id="simEmailSkip">{s.email.skip}</button>
          <button type="button" class="btn btn-primary sim-continue" id="simEmailSend" disabled>{s.email.send}</button>
        </div>
      </div>

      <div class="wizard-result" hidden>
        <p class="eyebrow">{s.resultEyebrow}</p>

        <div id="simResultNormal">
          <p class="sim-price"><span id="simPrice">0</span> €<small>{s.priceUnit}</small></p>
          <ul
            class="sim-breakdown"
            id="simBreakdown"
            data-base-autonomo={s.breakdownBaseAutonomo}
            data-base-sl={s.breakdownBaseSl}
            data-reporting={s.breakdownReporting}
            data-reporting-nose={s.breakdownReportingNose}
            data-iva={s.breakdownIva}
            data-total={s.breakdownTotal}
          ></ul>
          <p class="sim-reporting-explain" id="simReportingExplain" hidden>{s.reportingExplain}</p>
          <p class="sim-monthly-note">{s.monthlyNote}</p>
        </div>

        <div id="simResultAlta" hidden data-alta-note-template={s.altaResult.note}>
          <p class="sim-alta-note" id="simAltaResultNote"></p>
          <p class="sim-price"><span id="simPriceAlta">0</span> €<small>{s.priceUnit}</small></p>
          <p class="sim-monthly-note">{s.altaResult.fromLabel}</p>
          {debutTier?.transitionNote && <p class="sim-alta-transition" id="simAltaTransition" hidden>{debutTier.transitionNote}</p>}
        </div>

        <p class="quote-number">{s.quoteLabel} <span id="quoteNumber">…</span></p>
        <p class="wizard-error" id="wizardError" hidden>{s.error}</p>

        <div class="sim-email-after" id="simEmailAfter" hidden>
          <div id="simEmailAfterForm">
            <p class="sim-field-hint">{s.email.qAfter}</p>
            <p class="sim-field-hint sim-no-ads">{s.email.noAds}</p>
            <input type="email" id="simEmailAfterInput" class="sim-input" placeholder={s.email.placeholder} autocomplete="email" />
            <label class="sim-consent">
              <input type="checkbox" id="simEmailAfterConsent" />
              <span>{s.email.consentPrefix} <a href="/privacidad" target="_blank" rel="noopener">{s.email.consentLink}</a></span>
            </label>
            <p class="sim-consent-info">{s.email.consentInfo}</p>
            <p class="sim-field-error" id="simEmailAfterError" hidden>{s.email.error}</p>
            <button type="button" class="btn btn-outline sim-continue" id="simEmailAfterSend" disabled>{s.email.send}</button>
          </div>
          <p class="sim-email-success" id="simEmailAfterSuccess" hidden>{s.email.success}</p>
        </div>

        <ContactSwitch lang={lang} origen="simulador" />
        <button type="button" class="wizard-restart" id="wizardRestart">{s.restart}</button>
      </div>

      <button type="button" class="wizard-back" id="wizardBack" hidden>{s.back}</button>
    </div>
  </div>
</div>

<script>
  import { track } from '@vercel/analytics';
  import { animateCountUp } from '../../scripts/countup';

  // Función con nombre en vez de IIFE anónima, reenganchada en
  // "astro:page-load": si no, el simulador quedaría inerte al llegar a
  // /simulador navegando desde otra página (transición de vista) en vez de
  // con una carga completa, porque el script solo se ejecutaría una vez.
  function initSimulador() {
    const wizard = document.getElementById('wizard');
    if (!wizard) return;

    const steps = Array.from(wizard.querySelectorAll<HTMLElement>('.wizard-step'));
    const result = wizard.querySelector<HTMLElement>('.wizard-result') as HTMLElement;
    const dotsContainer = document.getElementById('wizardProgress') as HTMLElement | null;
    const backBtn = document.getElementById('wizardBack') as HTMLButtonElement;
    const restartBtn = document.getElementById('wizardRestart') as HTMLButtonElement;
    const priceEl = document.getElementById('simPrice') as HTMLElement;
    const altaPriceEl = document.getElementById('simPriceAlta') as HTMLElement;
    const quoteEl = document.getElementById('quoteNumber') as HTMLElement;
    const breakdownList = document.getElementById('simBreakdown') as HTMLElement | null;
    const explainEl = document.getElementById('simReportingExplain') as HTMLElement | null;
    const errorEl = document.getElementById('wizardError') as HTMLElement;
    const facturasGroups = Array.from(wizard.querySelectorAll<HTMLElement>('[data-facturas-options]'));
    const resultNormal = document.getElementById('simResultNormal') as HTMLElement | null;
    const resultAlta = document.getElementById('simResultAlta') as HTMLElement | null;
    const actividadInput = document.getElementById('simActividadInput') as HTMLInputElement | null;
    const actividadContinueBtn = document.getElementById('simActividadContinue') as HTMLButtonElement | null;
    const fechaInput = document.getElementById('simFechaInput') as HTMLInputElement | null;
    const fechaContinueBtn = document.getElementById('simFechaContinue') as HTMLButtonElement | null;
    const emailInput = document.getElementById('simEmailInput') as HTMLInputElement | null;
    const emailConsent = document.getElementById('simEmailConsent') as HTMLInputElement | null;
    const emailSendBtn = document.getElementById('simEmailSend') as HTMLButtonElement | null;
    const emailSkipBtn = document.getElementById('simEmailSkip') as HTMLButtonElement | null;
    const emailErrorEl = document.getElementById('simEmailError') as HTMLElement | null;
    const emailAfterContainer = document.getElementById('simEmailAfter') as HTMLElement | null;
    const emailAfterInput = document.getElementById('simEmailAfterInput') as HTMLInputElement | null;
    const emailAfterConsent = document.getElementById('simEmailAfterConsent') as HTMLInputElement | null;
    const emailAfterSendBtn = document.getElementById('simEmailAfterSend') as HTMLButtonElement | null;
    const emailAfterErrorEl = document.getElementById('simEmailAfterError') as HTMLElement | null;
    const emailAfterSuccessEl = document.getElementById('simEmailAfterSuccess') as HTMLElement | null;

    // Duplicado deliberadamente del cálculo en src/pages/api/presupuesto.ts:
    // así el precio aparece al instante aunque la llamada a la API tarde o falle,
    // y solo el número de presupuesto depende de la respuesta del servidor.
    // Tarifas base SIN IVA; el simulador siempre muestra el importe CON IVA (21%).
    const IVA_RATE = 0.21;
    // Planes por niveles (autónomo: Debut/Esencial/Crece/Total; SL: Esencial/
    // Equipo/Expansión), no por volumen de facturas — el campo se sigue
    // llamando "facturas" (igual en la BBDD y en la API, ver
    // api/presupuesto.ts) por no tocar ese contrato, pero ahora guarda el
    // plan elegido libremente por el visitante, no un tramo automático.
    // Debut es el precio del primer año para quien se acaba de dar de alta
    // (o le damos nosotros el alta, ver isAltaFlow más abajo).
    const RATES_AUTONOMO: Record<string, number> = { debut: 35, esencial: 55, crece: 85, total: 125 };
    const RATES_PYME: Record<string, number> = { esencial: 100, equipo: 150, expansion: 200 };
    // El reporting/dashboards cuesta menos con el plan más completo de cada
    // régimen (incluido con 50% de descuento) que con el resto de planes.
    const REPORTING_PRICE_AUTONOMO: Record<string, number> = { debut: 30, esencial: 30, crece: 30, total: 15 };
    const REPORTING_PRICE_PYME: Record<string, number> = { esencial: 30, equipo: 30, expansion: 15 };
    function reportingPrice(): number {
      const rates = answers.regimen === 'pyme' ? REPORTING_PRICE_PYME : REPORTING_PRICE_AUTONOMO;
      return rates[answers.facturas] ?? 30;
    }

    function round2(n: number): number {
      return Math.round(n * 100) / 100;
    }

    function formatEUR(n: number): string {
      const r = round2(n);
      return Number.isInteger(r) ? String(r) : r.toFixed(2).replace('.', ',');
    }

    const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    function isValidEmail(value: string): boolean {
      return EMAIL_PATTERN.test(value.trim());
    }

    // El email nunca viaja en la URL de /solicitud (a diferencia del resto
    // de respuestas): pasa por sessionStorage, que no se guarda en el
    // historial del navegador ni en logs de servidor, y se borra en cuanto
    // se lee al llegar a esa página.
    const EMAIL_STORAGE_KEY = 'sim_email';
    const CONSENT_STORAGE_KEY = 'sim_privacy_accepted';

    let answers: Record<string, string> = {};
    let facturaLabels: Record<string, string> = {};
    let path: string[] = [];
    let currentStep = 'regimen';
    let lastQuoteCode = '';
    let started = false;

    // Quien no ha respondido "alta" todavía cuenta como la rama normal
    // (facturas + reporting) a efectos de los puntos de progreso: solo se
    // recalcula a la rama de "gestión del alta" cuando responde que no está
    // dado de alta.
    function branchSteps(): string[] {
      const seq = ['regimen'];
      if (answers.regimen === 'pyme') {
        seq.push('facturas', 'reporting', 'email');
        return seq;
      }
      // Quien nos pide que le demos de alta elige plan igual que el resto
      // (antes se le asignaba Debut sin preguntar) — solo cambia en que,
      // tras elegir, sigue con los datos del alta en vez de con reporting.
      seq.push('altaEstado', 'facturas');
      if (answers.alta === 'no') {
        seq.push('certificado', 'actividad', 'fechaInicio', 'email');
      } else {
        seq.push('reporting', 'email');
      }
      return seq;
    }

    function nextStepId(step: string): string {
      switch (step) {
        case 'regimen': return answers.regimen === 'pyme' ? 'facturas' : 'altaEstado';
        case 'altaEstado': return 'facturas';
        case 'facturas': return answers.alta === 'no' ? 'certificado' : 'reporting';
        case 'reporting': return 'email';
        case 'certificado': return 'actividad';
        case 'actividad': return 'fechaInicio';
        case 'fechaInicio': return 'email';
        case 'email': return 'result';
        default: return 'result';
      }
    }

    function renderDots(total: number, activeIdx: number) {
      if (!dotsContainer) return;
      dotsContainer.innerHTML = '';
      for (let i = 0; i < total; i++) {
        const dot = document.createElement('span');
        dot.className = 'step-dot' + (i === activeIdx ? ' active' : '') + (i < activeIdx ? ' done' : '');
        dotsContainer.appendChild(dot);
      }
    }

    function showStep(stepId: string) {
      currentStep = stepId;
      result.hidden = true;
      steps.forEach(function (el: HTMLElement) { el.hidden = el.getAttribute('data-step') !== stepId; });
      const seq = branchSteps();
      renderDots(seq.length, seq.indexOf(stepId));
      backBtn.hidden = path.length === 0;

      if (stepId === 'facturas') {
        const wanted = answers.regimen === 'pyme' ? 'pyme' : 'autonomo';
        facturasGroups.forEach(function (group) {
          group.hidden = group.getAttribute('data-facturas-options') !== wanted;
        });
        // Debut es el plan pensado para quien todavía no está dado de alta
        // (o se lo tramitamos nosotros): se destaca solo en esa rama, no
        // para quien ya lleva tiempo dado de alta por su cuenta.
        const isNewAlta = answers.regimen === 'autonomo' && answers.alta === 'no';
        const debutCard = wizard?.querySelector<HTMLElement>('.option-card-tier[data-value="debut"]');
        const debutBadge = document.getElementById('debutRecommendedBadge');
        if (debutCard) debutCard.classList.toggle('is-recommended', isNewAlta);
        if (debutBadge) debutBadge.hidden = !isNewAlta;
      }
      if (stepId === 'fechaInicio' && fechaInput) {
        fechaInput.min = new Date().toISOString().slice(0, 10);
      }
    }

    function advance() {
      track('simulador_paso', { paso: currentStep });
      path.push(currentStep);
      const next = nextStepId(currentStep);
      if (next === 'result') redirectToSolicitud();
      else showStep(next);
    }

    function renderBreakdown(baseAmount: number, reportingAmount: number, iva: number, total: number) {
      if (!breakdownList) return;
      const d = breakdownList.dataset;
      const lines: { label: string; amount: string; tentative?: boolean }[] = [];

      const baseLabel = answers.regimen === 'pyme' ? d.baseSl : d.baseAutonomo;
      const facturaLabel = facturaLabels[answers.facturas] || '';
      lines.push({ label: `${baseLabel ?? ''} (${facturaLabel})`, amount: `${formatEUR(baseAmount)} €` });

      if (answers.reporting === 'si') {
        lines.push({ label: d.reporting ?? '', amount: `+${formatEUR(reportingAmount)} €` });
      } else if (answers.reporting === 'nose') {
        lines.push({ label: d.reportingNose ?? '', amount: `+${formatEUR(reportingPrice())} €`, tentative: true });
      }

      if (explainEl) explainEl.hidden = answers.reporting === 'no';

      lines.push({ label: d.iva ?? '', amount: `+${formatEUR(iva)} €` });
      lines.push({ label: d.total ?? '', amount: `${formatEUR(total)} €` });

      breakdownList.innerHTML = '';
      lines.forEach(function (line, idx) {
        const li = document.createElement('li');
        if (idx === lines.length - 1) li.classList.add('sim-breakdown-total');
        if (line.tentative) li.classList.add('sim-breakdown-tentative');
        const labelSpan = document.createElement('span');
        labelSpan.textContent = line.label;
        const amountSpan = document.createElement('span');
        amountSpan.textContent = line.amount;
        li.append(labelSpan, amountSpan);
        breakdownList.appendChild(li);
      });
    }

    async function showResult() {
      steps.forEach(function (el: HTMLElement) { el.hidden = true; });
      const seq = branchSteps();
      renderDots(seq.length, seq.length);
      backBtn.hidden = true;
      errorEl.hidden = true;
      if (emailAfterContainer) emailAfterContainer.hidden = true;

      // El email (si se dio) llega por sessionStorage, nunca por la URL de
      // /solicitud — se consume una sola vez aquí y se borra al momento.
      const storedEmail = sessionStorage.getItem(EMAIL_STORAGE_KEY);
      const storedConsent = sessionStorage.getItem(CONSENT_STORAGE_KEY) === '1';
      sessionStorage.removeItem(EMAIL_STORAGE_KEY);
      sessionStorage.removeItem(CONSENT_STORAGE_KEY);
      const hasStoredEmail = !!storedEmail && storedConsent;

      const isAltaFlow = answers.alta === 'no';
      if (resultNormal) resultNormal.hidden = isAltaFlow;
      if (resultAlta) resultAlta.hidden = !isAltaFlow;

      let apiBody: {
        regimen: string; facturas: string; reporting: string;
        alta?: string; certificado?: string; actividad?: string; fechaInicio?: string;
        email?: string; privacyAccepted?: boolean;
      };

      if (isAltaFlow) {
        // Quien nos pide que le demos de alta elige su plan en el paso
        // "facturas" igual que el resto (Debut sale primero y destacado,
        // pero puede elegir otro) — aquí solo se usa lo que haya elegido,
        // ya no se fuerza a Debut.
        apiBody = {
          regimen: 'autonomo', facturas: answers.facturas, reporting: 'no',
          alta: answers.alta, certificado: answers.certificado,
          actividad: answers.actividad, fechaInicio: answers.fechaInicio,
        };
        const base = RATES_AUTONOMO[answers.facturas] || 0;
        const iva = round2(base * IVA_RATE);
        const total = round2(base + iva);
        if (altaPriceEl) animateCountUp(altaPriceEl, total, formatEUR);

        const noteEl = document.getElementById('simAltaResultNote');
        const noteTemplate = resultAlta?.dataset.altaNoteTemplate;
        if (noteEl && noteTemplate) {
          noteEl.textContent = noteTemplate.replace('{plan}', facturaLabels[answers.facturas] || '');
        }
        const transitionEl = document.getElementById('simAltaTransition');
        if (transitionEl) transitionEl.hidden = answers.facturas !== 'debut';
      } else {
        apiBody = { regimen: answers.regimen, facturas: answers.facturas, reporting: answers.reporting };
        if (answers.alta) apiBody.alta = answers.alta;
        const rates = answers.regimen === 'pyme' ? RATES_PYME : RATES_AUTONOMO;
        const base = rates[answers.facturas] || 0;
        const reportingAmount = answers.reporting === 'si' ? reportingPrice() : 0;
        const subtotal = base + reportingAmount;
        const iva = round2(subtotal * IVA_RATE);
        const total = round2(subtotal + iva);
        animateCountUp(priceEl, total, formatEUR);
        renderBreakdown(base, reportingAmount, iva, total);
      }

      if (hasStoredEmail && storedEmail) {
        apiBody.email = storedEmail;
        apiBody.privacyAccepted = true;
      }

      quoteEl.textContent = '…';
      result.hidden = false;

      try {
        const res = await fetch('/api/presupuesto', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(apiBody),
        });
        if (!res.ok) throw new Error('bad response');
        const data = await res.json();
        quoteEl.textContent = data.quote;
        lastQuoteCode = data.quote;
        // Si ya dio su email antes de ver el precio, no le volvemos a pedir.
        // Si el presupuesto no se ha persistido (Supabase sin configurar,
        // modo demo) tampoco hay fila a la que añadir el email después.
        if (emailAfterContainer) emailAfterContainer.hidden = hasStoredEmail || !data.persisted;
      } catch (e) {
        quoteEl.textContent = '—';
        errorEl.hidden = false;
      }
    }

    function redirectToSolicitud() {
      track('simulador_resultado', {
        regimen: answers.regimen || '',
        flujo: answers.alta === 'no' ? 'alta' : 'gestion',
      });
      const lang = wizard?.dataset.lang || 'es';
      const prefix = lang === 'es' ? '' : `/${lang}`;
      const params = new URLSearchParams();
      Object.keys(answers).forEach(function (key) {
        if (answers[key]) params.set(key, answers[key]);
      });
      window.location.href = `${prefix}/solicitud?${params.toString()}`;
    }

    wizard.addEventListener('click', function (e: MouseEvent) {
      const target = e.target as HTMLElement | null;
      const card = target?.closest('.option-card') as HTMLElement | null;
      if (!card) return;
      const field = card.getAttribute('data-field');
      const value = card.getAttribute('data-value');
      if (!field || !value) return;
      answers[field] = value;
      if (!started) {
        started = true;
        track('simulador_inicio', { idioma: wizard?.dataset.lang || 'es' });
      }
      if (field === 'facturas') {
        const labelEl = card.querySelector('.option-card-label');
        facturaLabels[value] = (labelEl?.textContent || card.textContent || '').trim();
      }
      advance();
    });

    actividadInput?.addEventListener('input', function () {
      if (actividadContinueBtn) actividadContinueBtn.disabled = actividadInput.value.trim().length === 0;
    });
    actividadContinueBtn?.addEventListener('click', function () {
      if (!actividadInput || !actividadInput.value.trim()) return;
      answers.actividad = actividadInput.value.trim().slice(0, 100);
      advance();
    });

    function isValidFecha(): boolean {
      if (!fechaInput || !fechaInput.value) return false;
      if (fechaInput.min && fechaInput.value < fechaInput.min) return false;
      return true;
    }
    fechaInput?.addEventListener('input', function () {
      if (fechaContinueBtn) fechaContinueBtn.disabled = !isValidFecha();
    });
    fechaContinueBtn?.addEventListener('click', function () {
      if (!isValidFecha() || !fechaInput) return;
      answers.fechaInicio = fechaInput.value;
      advance();
    });

    function updateEmailSendState() {
      if (!emailSendBtn) return;
      emailSendBtn.disabled = !(emailInput && isValidEmail(emailInput.value) && emailConsent?.checked);
    }
    emailInput?.addEventListener('input', updateEmailSendState);
    emailConsent?.addEventListener('change', updateEmailSendState);
    emailSendBtn?.addEventListener('click', function () {
      if (!emailInput || !isValidEmail(emailInput.value) || !emailConsent?.checked) return;
      if (emailErrorEl) emailErrorEl.hidden = true;
      track('simulador_email', { momento: 'antes' });
      sessionStorage.setItem(EMAIL_STORAGE_KEY, emailInput.value.trim());
      sessionStorage.setItem(CONSENT_STORAGE_KEY, '1');
      advance();
    });
    emailSkipBtn?.addEventListener('click', function () {
      sessionStorage.removeItem(EMAIL_STORAGE_KEY);
      sessionStorage.removeItem(CONSENT_STORAGE_KEY);
      advance();
    });

    emailAfterInput?.addEventListener('input', updateEmailAfterSendState);
    emailAfterConsent?.addEventListener('change', updateEmailAfterSendState);
    function updateEmailAfterSendState() {
      if (!emailAfterSendBtn) return;
      emailAfterSendBtn.disabled = !(emailAfterInput && isValidEmail(emailAfterInput.value) && emailAfterConsent?.checked && lastQuoteCode);
    }
    emailAfterSendBtn?.addEventListener('click', async function () {
      if (!emailAfterInput || !isValidEmail(emailAfterInput.value) || !emailAfterConsent?.checked || !lastQuoteCode) return;
      if (emailAfterErrorEl) emailAfterErrorEl.hidden = true;
      emailAfterSendBtn.disabled = true;
      try {
        const res = await fetch('/api/presupuesto', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ quote: lastQuoteCode, email: emailAfterInput.value.trim(), privacyAccepted: true }),
        });
        if (!res.ok) throw new Error('bad response');
        track('simulador_email', { momento: 'despues' });
        const formEl = document.getElementById('simEmailAfterForm');
        if (formEl) formEl.hidden = true;
        if (emailAfterSuccessEl) emailAfterSuccessEl.hidden = false;
      } catch (e) {
        if (emailAfterErrorEl) emailAfterErrorEl.hidden = false;
        emailAfterSendBtn.disabled = false;
      }
    });

    backBtn.addEventListener('click', function () {
      if (!path.length) return;
      showStep(path.pop() as string);
    });

    restartBtn.addEventListener('click', function () {
      answers = {};
      facturaLabels = {};
      path = [];
      lastQuoteCode = '';
      sessionStorage.removeItem(EMAIL_STORAGE_KEY);
      sessionStorage.removeItem(CONSENT_STORAGE_KEY);
      if (actividadInput) actividadInput.value = '';
      if (fechaInput) fechaInput.value = '';
      if (emailInput) emailInput.value = '';
      if (emailConsent) emailConsent.checked = false;
      if (actividadContinueBtn) actividadContinueBtn.disabled = true;
      if (fechaContinueBtn) fechaContinueBtn.disabled = true;
      if (emailSendBtn) emailSendBtn.disabled = true;
      if (emailAfterInput) emailAfterInput.value = '';
      if (emailAfterConsent) emailAfterConsent.checked = false;
      if (emailAfterSendBtn) emailAfterSendBtn.disabled = true;
      if (emailAfterSuccessEl) emailAfterSuccessEl.hidden = true;
      const emailAfterFormEl = document.getElementById('simEmailAfterForm');
      if (emailAfterFormEl) emailAfterFormEl.hidden = false;
      showStep('regimen');
    });

    // Página /solicitud: llega con las respuestas ya en la URL (redirigida
    // desde el wizard) — salta directo al resultado, sin volver a preguntar.
    // Sirve también de página de "éxito" para marcar la conversión en Google Ads.
    const queryParams = new URLSearchParams(window.location.search);
    const qRegimen = queryParams.get('regimen');
    const qAlta = queryParams.get('alta');
    const qFacturas = queryParams.get('facturas');
    const qReporting = queryParams.get('reporting');
    const qCertificado = queryParams.get('certificado');
    const qActividad = queryParams.get('actividad');
    const qFecha = queryParams.get('fechaInicio');

    let validAnswers = false;

    if (qRegimen === 'autonomo' && qAlta === 'no' && qCertificado && qActividad && qFecha) {
      answers = { regimen: qRegimen, alta: qAlta, certificado: qCertificado, actividad: qActividad, fechaInicio: qFecha };
      validAnswers = true;
    } else {
      const rates = qRegimen === 'pyme' ? RATES_PYME : RATES_AUTONOMO;
      const facturasOk = !!qFacturas && Object.prototype.hasOwnProperty.call(rates, qFacturas);
      const reportingOk = qReporting === 'si' || qReporting === 'no' || qReporting === 'nose';
      if ((qRegimen === 'autonomo' || qRegimen === 'pyme') && facturasOk && reportingOk && qFacturas && qReporting) {
        answers = { regimen: qRegimen, facturas: qFacturas, reporting: qReporting };
        if (qAlta) answers.alta = qAlta;
        const facturaBtn = wizard.querySelector<HTMLElement>(`[data-field="facturas"][data-value="${qFacturas}"]`);
        const facturaLabelEl = facturaBtn?.querySelector('.option-card-label');
        facturaLabels[qFacturas] = (facturaLabelEl?.textContent || facturaBtn?.textContent || '').trim();
        validAnswers = true;
      }
    }

    if (validAnswers) {
      showResult();
    } else {
      showStep('regimen');
    }
  }

  document.addEventListener('astro:page-load', initSimulador);
</script>
