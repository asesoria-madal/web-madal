---
// Cinta en movimiento continuo con garantías/diferenciales que ya son
// ciertos hoy (mismo texto que aparece, sin comprimir, en la home:
// precios, el trato, el plazo de respuesta, la primera llamada). No lleva
// logos de terceros: no estamos dados de alta como Colaborador Social de
// la AEAT ni tenemos seguro de RC contratado todavía, así que no hay
// ningún sello real que enseñar aquí — cuando eso cambie, se sustituye
// este contenido por esos logos.
//
// Candidatos apuntados por Hugo para cuando estén confirmados/tramitados
// (no dar por hecho ninguno sin que él lo confirme primero):
// - CEC (Col·legi d'Economistes de Catalunya)
// - Punt PAE (Punto de Atención al Emprendedor)
// - Colaborador Social de la AEAT
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const items = t.trustBanner.items;
---

<div class="trust-banner">
  <div class="trust-banner-track" aria-hidden="true">
    {items.map((item) => <span class="trust-banner-item">{item}</span>)}
    {items.map((item) => <span class="trust-banner-item">{item}</span>)}
  </div>
</div>
